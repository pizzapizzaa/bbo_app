---
/**
 * A climber dynoing across a short problem on the hero wall: crouch on the
 * start holds, launch, catch the top jug, swing, drop off and reset.
 *
 * The holds are static SVG; the climber's limbs are solved every frame by
 * src/scripts/leaderboard/climber.ts so hands and feet stay on the holds.
 * Coordinates here and in climber.ts share one space (the viewBox is cropped
 * to the problem) — move a hold in one place and move it in the other.
 */
const HOLD = {
  jug:   'M10 60C10 30 35 12 60 14C82 16 94 34 90 55C87 72 70 70 58 64C46 58 34 70 24 76C14 82 10 74 10 60Z',
  crimp: 'M8 54C8 41 22 36 50 36C78 36 92 41 92 54C92 63 80 67 50 67C20 67 8 63 8 54Z',
};
// One route = one colour, so every hold on the problem is the same blue.
const ROUTE = '#2563EB';
// [path, centre x, centre y, size, rotation]
const HOLDS: Array<[string, number, number, number, number]> = [
  [HOLD.jug,    70, 153, 19, -10],   // start left
  [HOLD.jug,   110, 153, 19,  12],   // start right
  [HOLD.crimp,  68, 231, 16,   6],   // foot left
  [HOLD.crimp, 112, 231, 16,  -8],   // foot right
  [HOLD.jug,   115,  56, 30,   0],   // top jug
];
---

<div class="climber-stage" data-climber-stage aria-hidden="true">
  <svg viewBox="22 26 160 244" preserveAspectRatio="xMidYMid meet">
    {HOLDS.map(([d, cx, cy, size, rot]) => (
      <g transform={`translate(${cx - size / 2} ${cy - size / 2}) rotate(${rot} ${size / 2} ${size / 2}) scale(${size / 100})`}>
        <path d={d} fill={ROUTE} />
        <path d={d} fill="url(#lbHoldShade)" />
        <circle cx="50" cy="52" r="6" fill="rgba(0,0,0,.45)" />
      </g>
    ))}

    <!-- The climber; positions are set by climber.ts -->
    <g data-climber opacity="1">
      <polyline data-limb="legL" fill="none" stroke="#3D4048" stroke-width="7.5" stroke-linecap="round" stroke-linejoin="round" />
      <polyline data-limb="legR" fill="none" stroke="#3D4048" stroke-width="7.5" stroke-linecap="round" stroke-linejoin="round" />
      <ellipse data-shoe="L" rx="5.2" ry="3.2" fill="#FF5E14" />
      <ellipse data-shoe="R" rx="5.2" ry="3.2" fill="#FF5E14" />

      <g data-torso>
        <path d="M-8 -33Q0 -37 8 -33L7 1Q0 3 -7 1Z" fill="#1C1C1E" />
        <rect x="-2.5" y="-37.5" width="5" height="5" fill="#C98B62" />
        <circle cx="0" cy="-42" r="7.2" fill="#2A1D17" />
        <circle cx="0" cy="-50" r="3.4" fill="#2A1D17" />
      </g>

      <polyline data-limb="armL" fill="none" stroke="#1C1C1E" stroke-width="5.6" stroke-linecap="round" stroke-linejoin="round" />
      <polyline data-limb="armR" fill="none" stroke="#1C1C1E" stroke-width="5.6" stroke-linecap="round" stroke-linejoin="round" />
      <circle data-hand="L" r="3.3" fill="#E0B08A" stroke="#8a5a3c" stroke-width=".6" />
      <circle data-hand="R" r="3.3" fill="#E0B08A" stroke="#8a5a3c" stroke-width=".6" />
    </g>

    <g data-puffs></g>
  </svg>
</div>

<style>
  .climber-stage { width: 100%; height: 100%; }
  .climber-stage svg { width: 100%; height: 100%; overflow: visible; }
  .climber-stage :global([data-climber]) { filter: drop-shadow(0 4px 3px rgba(70, 25, 5, .35)); }
</style>
