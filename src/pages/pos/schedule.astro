  <script is:inline>
    var scheduleData = [];
    var currentWeekStart;

    // Mirrors STAFF_NAMES / PART_TIMER_NAMES in src/lib/staff.ts — this script is
    // is:inline and cannot import, so both lists have to be kept in step by hand.
    var STAFF_NAMES      = ['Huyen', 'Duyen Ha', 'Bao Anh', 'Danny', 'Minh Chau',
                            'Le Nghia', 'Kim An', 'Bich Van'];
    var PART_TIMER_NAMES = ['Bao Anh', 'Danny', 'Minh Chau', 'Le Nghia', 'Kim An', 'Bich Van'];

    // ── Who is looking at this page ───────────────────────────────────────────
    // All part-timers share one login, so the session *role* — not the username —
    // decides what the page offers: an admin posts and edits shifts, the shared
    // part-time account only claims open ones and releases what it claimed.
    // The server enforces the same split; this just hides what wouldn't work.
    var isAdmin = false;

    function readSessionRole() {
      // MainLayout owns the role: it is stored at login and treats a session
      // predating roles as the owner's own admin session. Don't re-derive it
      // from the token here — two sources of truth would eventually disagree.
      return window.bboRole && window.bboRole() === 'staff' ? 'staff' : 'admin';
    }

    /** Hide the controls the current role has no permission to use. */
    function applyRoleVisibility() {
      ['admin-entry-row', 'btn-duplicate-week'].forEach(function (id) {
        var el = document.getElementById(id);
        if (el) el.classList.toggle('hidden', !isAdmin);
      });
      document.getElementById('cal-subtitle').textContent = isAdmin
        ? 'Open part-time shifts appear in the Open row until someone takes them.'
        : 'Tap an open shift to put your name on it.';
    }

    /** Full-timers and part-timers combined, each name once, canonical order. */
    function allAssignableNames() {
      var list = STAFF_NAMES.slice();
      PART_TIMER_NAMES.forEach(function (n) { if (list.indexOf(n) === -1) list.push(n); });
      return list;
    }

    var STAFF_COLORS = [
      { bg: '#FED7AA', text: '#9A3412', border: '#FB923C' },
      { bg: '#BFDBFE', text: '#1E40AF', border: '#60A5FA' },
      { bg: '#BBF7D0', text: '#166534', border: '#4ADE80' },
      { bg: '#F5D0FE', text: '#7E22CE', border: '#E879F9' },
      { bg: '#FEF08A', text: '#854D0E', border: '#FACC15' },
      { bg: '#FECDD3', text: '#9F1239', border: '#FB7185' },
      { bg: '#CCFBF1', text: '#134E4A', border: '#34D399' },
      { bg: '#E0E7FF', text: '#3730A3', border: '#818CF8' }
    ];

    $(document).ready(function () {
      isAdmin = readSessionRole() === 'admin';
      applyRoleVisibility();
      initNameSelects();
      buildPartTimerPanel();

      document.getElementById('f-date').value = new Date().toISOString().slice(0, 10);
      currentWeekStart = getWeekStart(new Date());
      hoursMonth = new Date(new Date().getFullYear(), new Date().getMonth(), 1);
      ptMonth    = new Date(new Date().getFullYear(), new Date().getMonth(), 1);

      setSingleShiftType('assigned');
      setBulkShiftType('assigned');

      document.getElementById('btn-prev-week').addEventListener('click', function () {
        currentWeekStart = addDays(currentWeekStart, -7);
        renderCalendar();
      });
      document.getElementById('btn-next-week').addEventListener('click', function () {
        currentWeekStart = addDays(currentWeekStart, 7);
        renderCalendar();
      });
      document.getElementById('btn-today').addEventListener('click', function () {
        currentWeekStart = getWeekStart(new Date());
        renderCalendar();
      });

      loadSchedule();
      $('#f-start, #f-end').on('change', calcDuration);

      // Bulk panel init
      initStaffCheckboxes();
      document.getElementById('b-date-from').addEventListener('change', updateBulkPreview);
      document.getElementById('b-date-to').addEventListener('change', updateBulkPreview);
      document.getElementById('b-count').addEventListener('input', updateBulkPreview);
      document.querySelectorAll('.bulk-dow').forEach(function (cb) {
        cb.addEventListener('change', updateBulkPreview);
      });
    });

    // ══════════════════════════════════════════════════════════════════════════
    // ── Part-time shifts ──────────────────────────────────────────────────────
    // An open shift is a part_time row nobody has taken yet, so its staff_name is
    // still ''. Claiming writes the part-timer's name there — which is why the
    // weekly totals, the part-timer panel and Monthly Hours need no special case.
    // ══════════════════════════════════════════════════════════════════════════
    function isPartTime(entry) { return entry.shift_type === 'part_time'; }
    function isOpenShift(entry) { return isPartTime(entry) && !entry.staff_name; }

    /** A shift you may still hand back: yours, part-time, and not yet in the past. */
    function canRelease(entry) {
      if (!isPartTime(entry) || !entry.staff_name) return false;
      if (isAdmin) return true;
      return entry.date >= fmtDate(new Date());
    }

    // ── Segmented shift-type controls ─────────────────────────────────────────
    var SEG_ON  = 'px-3 py-2 rounded-lg text-sm font-semibold border transition ' +
                  'bg-orange-500 border-orange-500 text-white';
    var SEG_OFF = 'px-3 py-2 rounded-lg text-sm font-semibold border transition ' +
                  'bg-white border-gray-300 text-gray-500 hover:bg-gray-50';

    var singleShiftType = 'assigned';
    var bulkShiftType   = 'assigned';

    function setSingleShiftType(type) {
      singleShiftType = type;
      var open = type === 'part_time';
      document.getElementById('f-type-assigned').className  = open ? SEG_OFF : SEG_ON;
      document.getElementById('f-type-part_time').className = open ? SEG_ON  : SEG_OFF;
      document.getElementById('f-staff-wrap').classList.toggle('hidden', open);
      document.getElementById('f-count-wrap').classList.toggle('hidden', !open);
      document.getElementById('f-type-hint').classList.toggle('hidden', !open);
    }

    function setBulkShiftType(type) {
      bulkShiftType = type;
      var open = type === 'part_time';
      document.getElementById('b-type-assigned').className  = open ? SEG_OFF : SEG_ON;
      document.getElementById('b-type-part_time').className = open ? SEG_ON  : SEG_OFF;
      document.getElementById('b-staff-wrap').classList.toggle('hidden', open);
      document.getElementById('b-count-wrap').classList.toggle('hidden', !open);
      updateBulkPreview();
    }

    // ── Name dropdowns ────────────────────────────────────────────────────────
    function optionsHtml(names) {
      return names.map(function (n) {
        return '<option value="' + escHtml(n) + '">' + escHtml(n) + '</option>';
      }).join('');
    }

    function initNameSelects() {
      // Bao Anh / Danny / Minh Chau are part-timers who also get assigned shifts;
      // list them once, under Part-timers.
      var fullTimers = STAFF_NAMES.filter(function (n) { return PART_TIMER_NAMES.indexOf(n) === -1; });
      var staffOptions =
        '<option value="">— Select staff —</option>' +
        '<optgroup label="Staff">'        + optionsHtml(fullTimers)       + '</optgroup>' +
        '<optgroup label="Part-timers">'  + optionsHtml(PART_TIMER_NAMES) + '</optgroup>' +
        '<option value="Temp">Temp</option>';

      document.getElementById('f-staff').innerHTML = staffOptions;
      document.getElementById('e-staff').innerHTML = staffOptions;
      document.getElementById('claim-name').innerHTML =
        '<option value="">— Select your name —</option>' + optionsHtml(PART_TIMER_NAMES);
    }

    function fmtDayLabel(iso) {
      var DAY_FULL = ['Sunday','Monday','Tuesday','Wednesday','Thursday','Friday','Saturday'];
      var d = new Date(iso + 'T00:00:00');
      return DAY_FULL[d.getDay()] + ', ' + MONTHS_SHORT[d.getMonth()] + ' ' + d.getDate();
    }

    // ── Claim / release ───────────────────────────────────────────────────────
    var claimingId = null;

    function openClaimModal(id) {
      var entry = scheduleData.filter(function (s) { return String(s.id) === String(id); })[0];
      if (!entry) return;
      claimingId = id;

      // Same dialog, two readings: a part-timer is naming themselves, an admin
      // is naming someone else.
      document.getElementById('claim-title').textContent =
        isAdmin ? 'Fill This Shift' : 'Take This Shift';
      document.getElementById('claim-name-label').innerHTML =
        (isAdmin ? 'Who is working it?' : 'Who are you?') + ' <span class="text-red-400">*</span>';
      document.getElementById('claim-name-hint').textContent = isAdmin
        ? 'Their hours are tracked under this name.'
        : 'Your hours are tracked under the name you pick.';

      document.getElementById('claim-shift-label').textContent =
        fmtDayLabel(entry.date) + ' · ' + entry.start_time + '–' + entry.end_time +
        (entry.notes ? ' · ' + entry.notes : '');
      document.getElementById('claim-name').value = '';
      document.getElementById('claim-error').classList.add('hidden');
      var btn = document.getElementById('claim-confirm-btn');
      btn.disabled = false; btn.textContent = 'Confirm';
      document.getElementById('claim-modal').classList.remove('hidden');
    }

    function closeClaimModal() {
      document.getElementById('claim-modal').classList.add('hidden');
      claimingId = null;
    }

    function submitClaim() {
      var errEl = document.getElementById('claim-error');
      errEl.classList.add('hidden');
      var name = document.getElementById('claim-name').value;
      if (!name) {
        errEl.textContent = 'Please select your name.';
        errEl.classList.remove('hidden');
        return;
      }

      var btn = document.getElementById('claim-confirm-btn');
      btn.disabled = true; btn.textContent = 'Saving…';

      apiFetch('/api/schedule/' + claimingId + '/claim', {
        method: 'POST',
        body: JSON.stringify({ part_timer_name: name })
      })
        .then(function (res) { return res.json(); })
        .then(function (data) {
          btn.disabled = false; btn.textContent = 'Confirm';
          if (data.error) {
            errEl.textContent = data.error;
            errEl.classList.remove('hidden');
            // A 409 means someone beat us to it — refresh so the board is honest.
            if (/no longer open/i.test(data.error)) loadSchedule();
            return;
          }
          replaceEntry(data.entry);
          closeClaimModal();
          currentWeekStart = getWeekStart(new Date(data.entry.date + 'T00:00:00'));
          renderCalendar();
          showToast((isAdmin ? 'Shift filled — ' : 'Shift taken — ') +
            name + ' is on ' + fmtDayLabel(data.entry.date) + '.');
        })
        .catch(function (err) {
          btn.disabled = false; btn.textContent = 'Confirm';
          errEl.textContent = 'Could not take the shift: ' + err.message;
          errEl.classList.remove('hidden');
        });
    }

    function releaseShift(id) {
      var entry = scheduleData.filter(function (s) { return String(s.id) === String(id); })[0];
      if (!entry) return;
      if (!confirm('Give this shift back to the open pool?')) return;

      apiFetch('/api/schedule/' + id + '/claim', { method: 'DELETE' })
        .then(function (res) { return res.json(); })
        .then(function (data) {
          if (data.error) { showToast(data.error, 'error'); return; }
          replaceEntry(data.entry);
          renderCalendar();
          showToast('Shift released — it is open again.', 'warning');
        })
        .catch(function (err) { showToast('Release failed: ' + err.message, 'error'); });
    }

    /** Swap an updated row into scheduleData in place. */
    function replaceEntry(entry) {
      for (var i = 0; i < scheduleData.length; i++) {
        if (String(scheduleData[i].id) === String(entry.id)) { scheduleData[i] = entry; return; }
      }
      scheduleData.unshift(entry);
    }

    // ── Week helpers ──
    function getWeekStart(date) {
      var d = new Date(date);
      d.setHours(0, 0, 0, 0);
      var day = d.getDay();
      d.setDate(d.getDate() + (day === 0 ? -6 : 1 - day)); // Monday
      return d;
    }

    function addDays(date, n) {
      var d = new Date(date);
      d.setDate(d.getDate() + n);
      return d;
    }

    function fmtDate(date) {
      var y = date.getFullYear();
      var m = String(date.getMonth() + 1).padStart(2, '0');
      var dd = String(date.getDate()).padStart(2, '0');
      return y + '-' + m + '-' + dd;
    }

    function fmtWeekLabel(start) {
      var end = addDays(start, 6);
      var months = ['Jan','Feb','Mar','Apr','May','Jun','Jul','Aug','Sep','Oct','Nov','Dec'];
      return months[start.getMonth()] + ' ' + start.getDate() +
             ' – ' + months[end.getMonth()] + ' ' + end.getDate() +
             ', ' + end.getFullYear();
    }

    function getStaffList() {
      var list = allAssignableNames();
      // Include any staff from DB not in the canonical list (e.g. temp staff names).
      // Unclaimed part-time slots carry an empty staff_name — they belong in the
      // OPEN row, not a row of their own, so skip them here.
      scheduleData.forEach(function (s) {
        if (s.staff_name && list.indexOf(s.staff_name) === -1) list.push(s.staff_name);
      });
      return list;
    }

    function toggleTempInput(inputId, selectValue) {
      var el = document.getElementById(inputId);
      if (!el) return;
      if (selectValue === 'Temp') {
        el.classList.remove('hidden');
        el.focus();
      } else {
        el.classList.add('hidden');
        el.value = '';
      }
    }

    function resolveStaffName(selectId, tempId) {
      var sel = document.getElementById(selectId).value;
      if (sel === 'Temp') {
        return document.getElementById(tempId).value.trim();
      }
      return sel;
    }

    // ── Calendar cell actions ──
    var ICON_EDIT    = '<svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"/></svg>';
    var ICON_DELETE  = '<svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"/></svg>';
    var ICON_RELEASE = '<svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 10h11a4 4 0 010 8h-3m-8-8l4-4m-4 4l4 4"/></svg>';

    function iconBtn(fn, id, title, icon) {
      // stopPropagation because an open-shift chip is itself clickable — without
      // it, hitting Delete would also open the claim dialog behind the confirm.
      return '<button onclick="event.stopPropagation();' + fn + '(\'' + id + '\')" ' +
        'title="' + title + '" type="button" ' +
        'class="p-0.5 rounded hover:bg-black/10 transition-colors">' + icon + '</button>';
    }

    /** Hover actions on a shift chip, limited to what this role may actually do. */
    function entryActionsHtml(entry) {
      var safeId = escHtml(String(entry.id));
      var btns = '';
      if (isAdmin) {
        btns += iconBtn('openEditModal', safeId, 'Edit entry',   ICON_EDIT);
        btns += iconBtn('deleteEntry',   safeId, 'Delete entry', ICON_DELETE);
      }
      if (canRelease(entry)) {
        btns += iconBtn('releaseShift', safeId, 'Give this shift back', ICON_RELEASE);
      }
      if (!btns) return '';
      // Admins are at a desk, so their controls stay out of the way until hover.
      // Part-timers are on a phone, where there is no hover — theirs stay visible.
      var wrap = isAdmin
        ? 'flex gap-0.5 shrink-0 opacity-0 group-hover:opacity-100 transition-opacity'
        : 'flex gap-0.5 shrink-0';
      return '<div class="' + wrap + '">' + btns + '</div>';
    }

    /**
     * The pinned OPEN row at the top of the weekly grid.
     *
     * Unfilled part-time slots have no name to file them under, and there can be
     * any number of them on one day — including several in the same time range —
     * so they stack in one shared row until someone claims them.
     */
    function renderOpenRow(weekDates, todayIso) {
      var weekOpen = weekDates.map(function (d) {
        var iso = fmtDate(d);
        return scheduleData.filter(function (s) { return isOpenShift(s) && s.date === iso; });
      });
      var total = weekOpen.reduce(function (n, list) { return n + list.length; }, 0);
      if (!total) return '';

      var html = '<tr class="border-b border-amber-200 bg-amber-50/40">';
      html += '<td class="py-2.5 pr-3 align-top w-24">' +
        '<span class="text-xs font-bold text-amber-700 uppercase tracking-wide leading-tight">Open</span>' +
        '<span class="block text-[10px] text-amber-600/70 leading-tight">part-time</span>' +
        '</td>';

      weekDates.forEach(function (d, i) {
        var isToday = fmtDate(d) === todayIso;

        // Two slots in the same time range are two separate jobs, but as two
        // identical chips they read as one drawn twice. Number them so the
        // duplication is obviously deliberate.
        var slotTotals = {};
        weekOpen[i].forEach(function (s) {
          var k = s.start_time + '-' + s.end_time;
          slotTotals[k] = (slotTotals[k] || 0) + 1;
        });
        var slotSeen = {};

        html += '<td class="py-2 px-1 align-top' + (isToday ? ' bg-orange-100/40' : '') + '" style="min-width:80px">';
        weekOpen[i].forEach(function (entry) {
          var safeId = escHtml(String(entry.id));
          var label  = escHtml(entry.start_time) + '–' + escHtml(entry.end_time);
          var note   = entry.notes ? '&#10;Note: ' + escHtml(entry.notes) : '';

          var key   = entry.start_time + '-' + entry.end_time;
          var of    = slotTotals[key];
          slotSeen[key] = (slotSeen[key] || 0) + 1;
          var badge = of > 1
            ? ' <span class="px-1 rounded bg-amber-200 text-amber-900 text-[10px] font-bold align-middle">' +
              slotSeen[key] + '/' + of + '</span>'
            : '';
          // One interaction for both roles: click the shift, put a name on it.
          // The admin's edit/delete icons sit inside and stop the click there.
          // max-w keeps a long note from stretching its day column far wider
          // than the rest of the week; the note truncates instead.
          html += '<div role="button" tabindex="0" onclick="openClaimModal(\'' + safeId + '\')" ' +
            'title="' + (isAdmin ? 'Click to fill this shift' : 'Tap to take this shift') + note + '" ' +
            'class="mb-1 px-2 py-1 rounded-md text-xs leading-snug border border-dashed max-w-[150px] ' +
            'border-amber-400 bg-amber-100/60 text-amber-800 hover:bg-amber-200 transition cursor-pointer group">' +
            '<div class="flex items-start justify-between gap-0.5">' +
            '<div class="min-w-0">' +
            '<div class="font-semibold whitespace-nowrap">' + label + badge + '</div>' +
            '<div class="opacity-70 truncate">' +
              (isAdmin ? 'unfilled' + (entry.notes ? ' · ' + escHtml(entry.notes) : '') : 'Take it') +
            '</div>' +
            '</div>' +
            entryActionsHtml(entry) +
            '</div></div>';
        });
        html += '</td>';
      });

      html += '<td class="py-2.5 pl-3 align-middle text-right">' +
        '<span class="text-xs font-semibold text-amber-700 whitespace-nowrap">' + total + ' open</span>' +
        '</td>';
      return html + '</tr>';
    }

    // ── Render calendar ──
    function renderCalendar() {
      var DAY_ABBR = ['Sun', 'Mon', 'Tue', 'Wed', 'Thu', 'Fri', 'Sat'];
      var weekDates = [];
      for (var i = 0; i < 7; i++) weekDates.push(addDays(currentWeekStart, i));
      var todayIso = fmtDate(new Date());

      document.getElementById('week-label').textContent = fmtWeekLabel(currentWeekStart);

      // Head row
      var headHtml = '<tr class="border-b-2 border-gray-200">';
      headHtml += '<th class="w-24 pb-3 pr-3 text-left text-xs font-semibold text-gray-500 uppercase tracking-wide">Staff</th>';
      weekDates.forEach(function (d) {
        var isToday = fmtDate(d) === todayIso;
        var abbr    = DAY_ABBR[d.getDay()];
        var num     = d.getDate();
        if (isToday) {
          headHtml += '<th class="pb-3 px-1 text-center">' +
            '<span class="block text-xs font-semibold text-orange-500 uppercase tracking-wide">' + abbr + '</span>' +
            '<span class="mt-0.5 w-7 h-7 rounded-full bg-orange-500 text-white text-sm font-bold inline-flex items-center justify-center mx-auto">' + num + '</span>' +
            '</th>';
        } else {
          headHtml += '<th class="pb-3 px-1 text-center">' +
            '<span class="block text-xs font-semibold text-gray-400 uppercase tracking-wide">' + abbr + '</span>' +
            '<span class="block text-sm font-medium text-gray-700">' + num + '</span>' +
            '</th>';
        }
      });
      headHtml += '<th class="pb-3 pl-3 text-right text-xs font-semibold text-gray-500 uppercase tracking-wide whitespace-nowrap">Total hrs</th>';
      headHtml += '</tr>';
      document.getElementById('cal-head').innerHTML = headHtml;

      // Body rows — only staff with at least one entry in the visible week
      var weekDateSet = weekDates.map(fmtDate);
      var staffList = getStaffList().filter(function (name) {
        return scheduleData.some(function (s) {
          return s.staff_name === name && weekDateSet.indexOf(s.date) !== -1;
        });
      });
      var bodyHtml  = renderOpenRow(weekDates, todayIso);
      staffList.forEach(function (staffName, rowIdx) {
        var color  = STAFF_COLORS[rowIdx % STAFF_COLORS.length];
        var isLast = rowIdx === staffList.length - 1;
        bodyHtml += '<tr class="' + (isLast ? '' : 'border-b border-gray-100') + ' hover:bg-gray-50/40">';
        bodyHtml += '<td class="py-2.5 pr-3 align-top w-24">' +
          '<span class="text-xs font-semibold text-gray-700 leading-tight">' + escHtml(staffName) + '</span>' +
          '</td>';
        var weekTotalMin = 0;
        weekDates.forEach(function (d) {
          var iso     = fmtDate(d);
          var isToday = iso === todayIso;
          var entries = scheduleData.filter(function (s) {
            return s.staff_name === staffName && s.date === iso;
          });
          bodyHtml += '<td class="py-2 px-1 align-top' + (isToday ? ' bg-orange-50/30' : '') + '" style="min-width:80px">';
          entries.forEach(function (entry) {
            var start = entry.start_time || '';
            var end   = entry.end_time   || '';
            var diff  = timeToMin(end) - timeToMin(start);
            if (diff <= 0) diff += 1440;
            weekTotalMin += diff;
            var h = Math.floor(diff / 60), m = diff % 60;
            var dur = h + 'h' + (m ? ' ' + m + 'm' : '');
            bodyHtml +=
              '<div ' +
              'title="' + escHtml(staffName) + ': ' + start + '–' + end +
                (isPartTime(entry) ? '&#10;Part-time shift (claimed)' : '') +
                (entry.notes ? '&#10;Note: ' + escHtml(entry.notes) : '') + '" ' +
              'class="mb-1 px-2 py-1 rounded-md text-xs leading-snug border max-w-[150px] group" ' +
              'style="background:' + color.bg + ';color:' + color.text + ';border-color:' + color.border + '">' +
              '<div class="flex items-start justify-between gap-0.5">' +
              '<div class="min-w-0">' +
              // A claimed shift is deliberately indistinguishable from an assigned
              // one — once someone is on it, how it got filled is bookkeeping. The
              // tooltip still says, for anyone who needs to know.
              '<div class="font-semibold whitespace-nowrap">' + start + '–' + end + '</div>' +
              '<div class="opacity-70 truncate">' + dur + (entry.notes ? ' · ' + escHtml(entry.notes) : '') + '</div>' +
              '</div>' +
              entryActionsHtml(entry) +
              '</div>' +
              '</div>';
          });
          bodyHtml += '</td>';
        });
        var th = Math.floor(weekTotalMin / 60), tm = weekTotalMin % 60;
        var totalLabel = weekTotalMin > 0
          ? th + 'h' + (tm ? ' ' + tm + 'm' : '')
          : '<span class="text-gray-300">—</span>';
        bodyHtml += '<td class="py-2.5 pl-3 align-middle text-right">' +
          '<span class="text-xs font-semibold text-gray-700 whitespace-nowrap">' + totalLabel + '</span>' +
          '</td>';
        bodyHtml += '</tr>';
      });

      if (!bodyHtml) {
        bodyHtml = '<tr><td colspan="9" class="py-10 text-center text-gray-400 text-sm">No schedule data yet.</td></tr>';
      }
      document.getElementById('cal-body').innerHTML = bodyHtml;

      updatePartTimerStats();
    }

    function calcDuration() {
      var s = document.getElementById('f-start').value;
      var e = document.getElementById('f-end').value;
      var el = document.getElementById('duration-display');
      if (s && e) {
        var diff = timeToMin(e) - timeToMin(s);
        if (diff <= 0) diff += 1440;
        var h = Math.floor(diff / 60), m = diff % 60;
        el.textContent = h + 'h ' + (m ? m + 'm' : '');
        el.classList.remove('text-gray-500');
        el.classList.add('text-gray-800', 'font-medium');
      } else {
        el.textContent = '— (auto-calculated)';
        el.classList.add('text-gray-500');
        el.classList.remove('text-gray-800', 'font-medium');
      }
    }

    function timeToMin(t) {
      if (!t) return 0;
      var p = t.split(':');
      return parseInt(p[0]) * 60 + parseInt(p[1]);
    }

    // ── Part-timer hours summary ──
    // Driven by PART_TIMER_NAMES so a new part-timer only has to be added once.
    var ptMonth = null; // Date set to 1st of the selected finance month

    function ptSlug(name) { return name.toLowerCase().replace(/[^a-z0-9]+/g, '-'); }

    function ptTileHtml(prefix, name, suffix, valueClass) {
      return '<div class="bg-gray-800 rounded-xl border border-gray-700 p-4">' +
        '<p class="text-[10px] text-gray-400 uppercase tracking-wide mb-0.5">' +
          escHtml(name) + ' · ' + suffix + '</p>' +
        '<p id="pt-' + prefix + '-' + ptSlug(name) + '" ' +
          'class="text-xl font-bold ' + valueClass + ' tabular-nums mt-1">—</p>' +
        '</div>';
    }

    // Class names are passed whole, never assembled from fragments — Tailwind
    // scans this file as plain text and would not emit a class it can't see.
    function ptTotalTileHtml(prefix, suffix, borderClass, textClass) {
      return '<div class="bg-gray-800 rounded-xl p-4 border ' + borderClass + '">' +
        '<p class="text-[10px] uppercase tracking-wide mb-0.5 ' + textClass + '">Combined · ' + suffix + '</p>' +
        '<p id="pt-' + prefix + '-total" class="text-xl font-bold tabular-nums mt-1 ' + textClass + '">—</p>' +
        '</div>';
    }

    function buildPartTimerPanel() {
      document.getElementById('pt-roster-label').textContent = PART_TIMER_NAMES.join(' · ');
      document.getElementById('pt-week-grid').innerHTML =
        PART_TIMER_NAMES.map(function (n) { return ptTileHtml('week', n, 'This Week', 'text-amber-300'); }).join('') +
        ptTotalTileHtml('week', 'This Week', 'border-orange-800/60', 'text-orange-400');
      document.getElementById('pt-mon-grid').innerHTML =
        PART_TIMER_NAMES.map(function (n) { return ptTileHtml('mon', n, 'This Month', 'text-emerald-400'); }).join('') +
        ptTotalTileHtml('mon', 'This Month', 'border-emerald-800/60', 'text-emerald-400');
    }

    function fmtHours(totalMin) {
      if (totalMin <= 0) return '0h';
      var h = Math.floor(totalMin / 60), m = totalMin % 60;
      return h + 'h' + (m ? ' ' + m + 'm' : '');
    }

    function navPTMonth(delta) {
      ptMonth = new Date(ptMonth.getFullYear(), ptMonth.getMonth() + delta, 1);
      updatePartTimerStats();
    }

    function ptGoToday() {
      var now = new Date();
      ptMonth = new Date(now.getFullYear(), now.getMonth(), 1);
      updatePartTimerStats();
    }

    function getFinanceMonthRange() {
      // Finance month: 29th of (ptMonth-1) → 28th of ptMonth
      var y = ptMonth.getFullYear();
      var m = ptMonth.getMonth();
      var start = new Date(y, m - 1, 29);
      var end   = new Date(y, m, 28);
      return { start: fmtDate(start), end: fmtDate(end), startDate: start, endDate: end };
    }

    function sumStaffMinutes(staffName, dateSet) {
      return scheduleData.reduce(function (acc, s) {
        if (s.staff_name !== staffName) return acc;
        if (dateSet.indexOf(s.date) === -1) return acc;
        var diff = timeToMin(s.end_time) - timeToMin(s.start_time);
        if (diff <= 0) diff += 1440;
        return acc + diff;
      }, 0);
    }

    function sumStaffMinutesInRange(staffName, rangeStart, rangeEnd) {
      return scheduleData.reduce(function (acc, s) {
        if (s.staff_name !== staffName) return acc;
        if (!s.date || s.date < rangeStart || s.date > rangeEnd) return acc;
        var diff = timeToMin(s.end_time) - timeToMin(s.start_time);
        if (diff <= 0) diff += 1440;
        return acc + diff;
      }, 0);
    }

    var MONTHS_SHORT = ['Jan','Feb','Mar','Apr','May','Jun','Jul','Aug','Sep','Oct','Nov','Dec'];

    function updatePartTimerStats() {
      // Weekly: the currently viewed week
      var weekDates = [];
      for (var i = 0; i < 7; i++) weekDates.push(fmtDate(addDays(currentWeekStart, i)));

      // Finance month range
      var fin = getFinanceMonthRange();

      // Finance period label
      var startLabel = MONTHS_SHORT[fin.startDate.getMonth()] + ' ' + fin.startDate.getDate();
      var endLabel   = MONTHS_SHORT[fin.endDate.getMonth()]   + ' ' + fin.endDate.getDate() + ' ' + fin.endDate.getFullYear();
      document.getElementById('pt-finance-period').textContent = 'Finance period: ' + startLabel + ' – ' + endLabel;

      var weekTotal = 0, monTotal = 0;
      PART_TIMER_NAMES.forEach(function (name) {
        var wMin = sumStaffMinutes(name, weekDates);
        var mMin = sumStaffMinutesInRange(name, fin.start, fin.end);
        weekTotal += wMin;
        monTotal  += mMin;
        document.getElementById('pt-week-' + ptSlug(name)).textContent = fmtHours(wMin);
        document.getElementById('pt-mon-'  + ptSlug(name)).textContent = fmtHours(mMin);
      });
      document.getElementById('pt-week-total').textContent = fmtHours(weekTotal);
      document.getElementById('pt-mon-total').textContent  = fmtHours(monTotal);
    }

    function loadSchedule() {
      apiFetch('/api/schedule')
        .then(function (res) { return res.json(); })
        .then(function (data) {
          scheduleData = data.entries || [];
          renderCalendar();
          updatePartTimerStats();
        })
        .catch(function (err) { showToast('Failed to load schedule: ' + err.message, 'error'); });
    }

    // Form submit
    document.getElementById('schedule-form').addEventListener('submit', function (e) {
      e.preventDefault();
      var errEl = document.getElementById('form-error');
      errEl.classList.add('hidden');

      var isOpen = singleShiftType === 'part_time';
      var staff = isOpen ? '' : resolveStaffName('f-staff', 'f-staff-temp');
      var date  = document.getElementById('f-date').value;
      var start = document.getElementById('f-start').value;
      var end   = document.getElementById('f-end').value;
      var notes = document.getElementById('f-notes').value.trim();
      // Several part-timers can work the same slot, so one post may create N slots.
      var count = isOpen ? Math.max(1, Math.min(20, parseInt(document.getElementById('f-count').value, 10) || 1)) : 1;

      if ((!staff && !isOpen) || !date || !start || !end) {
        errEl.textContent = document.getElementById('f-staff').value === 'Temp' && !staff
          ? 'Please enter the temp staff name.'
          : 'Please fill in all required fields.';
        errEl.classList.remove('hidden');
        return;
      }

      var btn = e.target.querySelector('[type="submit"]');
      btn.disabled = true; btn.textContent = 'Saving…';

      var payload = {
        staff_name: staff, date: date, start_time: start, end_time: end,
        notes: notes, shift_type: singleShiftType
      };
      var posts = [];
      for (var ci = 0; ci < count; ci++) {
        posts.push(apiFetch('/api/schedule', { method: 'POST', body: JSON.stringify(payload) })
          .then(function (res) { return res.json(); }));
      }

      Promise.all(posts)
        .then(function (results) {
          btn.disabled = false; btn.textContent = 'Add to Schedule';
          var failed = results.filter(function (r) { return r.error; })[0];
          if (failed) { errEl.textContent = failed.error; errEl.classList.remove('hidden'); }
          var added = results.filter(function (r) { return r.entry; });
          if (!added.length) return;
          added.forEach(function (r) { scheduleData.unshift(r.entry); });
          // Jump to the week of the newly added entry
          currentWeekStart = getWeekStart(new Date(date + 'T00:00:00'));
          renderCalendar();
          document.getElementById('f-staff').value = '';
          document.getElementById('f-staff-temp').value = '';
          document.getElementById('f-staff-temp').classList.add('hidden');
          document.getElementById('f-start').value = '';
          document.getElementById('f-end').value   = '';
          document.getElementById('f-notes').value  = '';
          document.getElementById('duration-display').textContent = '— (auto-calculated)';
          document.getElementById('duration-display').className =
            'w-full border border-gray-200 bg-gray-50 rounded-lg px-3 py-2 text-sm text-gray-500';
          showToast(isOpen
            ? 'Posted ' + added.length + ' open part-time shift' + (added.length !== 1 ? 's' : '') + '.'
            : 'Schedule entry added!');
        })
        .catch(function (err) {
          btn.disabled = false; btn.textContent = 'Add to Schedule';
          errEl.textContent = 'Save failed: ' + err.message;
          errEl.classList.remove('hidden');
        });
    });

    function deleteEntry(id) {
      if (!confirm('Delete this schedule entry?')) return;
      apiFetch('/api/schedule/' + id, { method: 'DELETE' })
        .then(function (res) { return res.json(); })
        .then(function (data) {
          if (data.error) { showToast('Delete failed: ' + data.error, 'error'); return; }
          scheduleData = scheduleData.filter(function (s) { return String(s.id) !== String(id); });
          renderCalendar();
          showToast('Entry deleted.', 'warning');
        })
        .catch(function (err) { showToast('Delete failed: ' + err.message, 'error'); });
    }

    // ── Edit entry ──
    var editingId        = null;
    var editingShiftType = 'assigned';

    function openEditModal(id) {
      var entry = scheduleData.filter(function (s) { return String(s.id) === String(id); })[0];
      if (!entry) return;
      editingId        = id;
      editingShiftType = isPartTime(entry) ? 'part_time' : 'assigned';

      // A part-time slot may legitimately have nobody on it, so the name stops
      // being required and clearing it becomes the way to reopen the slot.
      var open = editingShiftType === 'part_time';
      document.getElementById('e-type-badge').classList.toggle('hidden', !open);
      document.getElementById('e-open-hint').classList.toggle('hidden', !open);
      document.getElementById('e-staff-required').classList.toggle('hidden', open);

      var staffName = entry.staff_name || '';
      var eStaffSel = document.getElementById('e-staff');
      var eStaffTemp = document.getElementById('e-staff-temp');
      if (allAssignableNames().indexOf(staffName) !== -1) {
        eStaffSel.value = staffName;
        eStaffTemp.classList.add('hidden');
        eStaffTemp.value = '';
      } else if (staffName) {
        eStaffSel.value = 'Temp';
        eStaffTemp.classList.remove('hidden');
        eStaffTemp.value = staffName;
      } else {
        eStaffSel.value = '';
        eStaffTemp.classList.add('hidden');
        eStaffTemp.value = '';
      }
      document.getElementById('e-date').value  = entry.date || '';
      document.getElementById('e-start').value = entry.start_time || '';
      document.getElementById('e-end').value   = entry.end_time || '';
      document.getElementById('e-notes').value = entry.notes || '';
      document.getElementById('edit-error').classList.add('hidden');
      document.getElementById('edit-save-btn').disabled = false;
      document.getElementById('edit-save-btn').textContent = 'Save Changes';
      document.getElementById('edit-modal').classList.remove('hidden');
    }

    function closeEditModal() {
      document.getElementById('edit-modal').classList.add('hidden');
      editingId = null;
    }

    function submitEdit() {
      var errEl = document.getElementById('edit-error');
      errEl.classList.add('hidden');
      var staff = resolveStaffName('e-staff', 'e-staff-temp');
      var date  = document.getElementById('e-date').value;
      var start = document.getElementById('e-start').value;
      var end   = document.getElementById('e-end').value;
      var notes = document.getElementById('e-notes').value.trim();

      var open = editingShiftType === 'part_time';
      if ((!staff && !open) || !date || !start || !end) {
        errEl.textContent = document.getElementById('e-staff').value === 'Temp' && !staff
          ? 'Please enter the temp staff name.'
          : 'Please fill in all required fields.';
        errEl.classList.remove('hidden');
        return;
      }

      var saveBtn = document.getElementById('edit-save-btn');
      saveBtn.disabled = true;
      saveBtn.textContent = 'Saving…';

      apiFetch('/api/schedule/' + editingId, {
        method: 'PATCH',
        body: JSON.stringify({
          staff_name: staff, date: date, start_time: start, end_time: end,
          notes: notes, shift_type: editingShiftType
        })
      })
        .then(function (res) { return res.json(); })
        .then(function (data) {
          saveBtn.disabled = false;
          saveBtn.textContent = 'Save Changes';
          if (data.error) { errEl.textContent = data.error; errEl.classList.remove('hidden'); return; }
          replaceEntry(data.entry);
          closeEditModal();
          renderCalendar();
          showToast('Entry updated!');
        })
        .catch(function (err) {
          saveBtn.disabled = false;
          saveBtn.textContent = 'Save Changes';
          errEl.textContent = 'Save failed: ' + err.message;
          errEl.classList.remove('hidden');
        });
    }

    function exportCSV() {
      var rows = [['Staff Name', 'Date', 'Start', 'End', 'Notes', 'Shift Type', 'Status']];
      scheduleData.forEach(function (s) {
        rows.push([
          s.staff_name, s.date, s.start_time, s.end_time, s.notes || '',
          isPartTime(s) ? 'part-time' : 'assigned',
          isOpenShift(s) ? 'open' : (isPartTime(s) ? 'claimed' : 'assigned')
        ]);
      });
      var csv = rows.map(function (r) {
        return r.map(function (c) { return '"' + String(c).replace(/"/g, '""') + '"'; }).join(',');
      }).join('\n');
      var blob = new Blob([csv], { type: 'text/csv' });
      var url  = URL.createObjectURL(blob);
      var a    = document.createElement('a');
      a.href = url; a.download = 'staff-schedule.csv'; a.click();
      URL.revokeObjectURL(url);
    }

    function escHtml(str) {
      return String(str || '')
        .replace(/&/g, '&amp;').replace(/</g, '&lt;')
        .replace(/>/g, '&gt;').replace(/"/g, '&quot;');
    }

    // ── CSV Import ──
    var csvParsedRows = [];

    document.getElementById('csv-file-input').addEventListener('change', function (e) {
      var file = e.target.files[0];
      if (!file) return;
      document.getElementById('csv-file-name').textContent = file.name;
      var reader = new FileReader();
      reader.onload = function (ev) { handleCSVText(ev.target.result); };
      reader.readAsText(file);
    });

    function parseCSVLine(line) {
      var result = [], cur = '', inQ = false;
      for (var i = 0; i < line.length; i++) {
        var c = line[i];
        if (c === '"') {
          if (inQ && line[i + 1] === '"') { cur += '"'; i++; }
          else inQ = !inQ;
        } else if (c === ',' && !inQ) { result.push(cur.trim()); cur = ''; }
        else cur += c;
      }
      result.push(cur.trim());
      return result;
    }

    function handleCSVText(text) {
      var errEl = document.getElementById('csv-error');
      errEl.classList.add('hidden');
      csvParsedRows = [];

      var lines = text.replace(/\r\n/g, '\n').replace(/\r/g, '\n').split('\n').filter(function (l) { return l.trim(); });
      if (lines.length < 2) {
        errEl.textContent = 'CSV must have a header row and at least one data row.';
        errEl.classList.remove('hidden');
        return;
      }

      var headers = parseCSVLine(lines[0]).map(function (h) { return h.toLowerCase().replace(/\s+/g, '_'); });
      var idxStaff = headers.indexOf('staff_name');
      var idxDate  = headers.indexOf('date');
      var idxStart = headers.indexOf('start_time');
      var idxEnd   = headers.indexOf('end_time');
      var idxNotes = headers.indexOf('notes');

      if (idxStaff === -1 || idxDate === -1 || idxStart === -1 || idxEnd === -1) {
        errEl.textContent = 'Missing required columns: staff_name, date, start_time, end_time';
        errEl.classList.remove('hidden');
        return;
      }

      var errors = [];
      for (var i = 1; i < lines.length; i++) {
        var cols = parseCSVLine(lines[i]);
        var staff = cols[idxStaff] || '';
        var date  = cols[idxDate]  || '';
        var start = cols[idxStart] || '';
        var end   = cols[idxEnd]   || '';
        var notes = idxNotes !== -1 ? (cols[idxNotes] || '') : '';

        if (!staff || !date || !start || !end) { errors.push('Row ' + i + ': missing required value'); continue; }
        if (!/^\d{4}-\d{2}-\d{2}$/.test(date)) { errors.push('Row ' + i + ': date must be YYYY-MM-DD'); continue; }
        if (!/^\d{2}:\d{2}$/.test(start) || !/^\d{2}:\d{2}$/.test(end)) { errors.push('Row ' + i + ': times must be HH:MM'); continue; }

        csvParsedRows.push({ staff_name: staff, date: date, start_time: start, end_time: end, notes: notes });
      }

      if (errors.length) {
        errEl.textContent = errors.slice(0, 3).join(' | ') + (errors.length > 3 ? ' …and ' + (errors.length - 3) + ' more' : '');
        errEl.classList.remove('hidden');
      }

      if (csvParsedRows.length) {
        var previewBody = document.getElementById('csv-preview-body');
        previewBody.innerHTML = csvParsedRows.map(function (r) {
          return '<div class="py-0.5 border-b border-gray-100 last:border-0">' +
            escHtml(r.staff_name) + ' · ' + escHtml(r.date) + ' · ' + escHtml(r.start_time) + '–' + escHtml(r.end_time) +
            (r.notes ? ' <span class="text-gray-400">(' + escHtml(r.notes) + ')</span>' : '') + '</div>';
        }).join('');
        document.getElementById('csv-preview').classList.remove('hidden');
        document.getElementById('btn-import-csv').disabled = false;
        document.getElementById('btn-import-csv').textContent = 'Import ' + csvParsedRows.length + ' Row' + (csvParsedRows.length > 1 ? 's' : '');
      } else {
        document.getElementById('csv-preview').classList.add('hidden');
        document.getElementById('btn-import-csv').disabled = true;
        document.getElementById('btn-import-csv').textContent = 'Import Rows';
      }
    }

    document.getElementById('btn-import-csv').addEventListener('click', function () {
      if (!csvParsedRows.length) return;
      var btn = document.getElementById('btn-import-csv');
      btn.disabled = true; btn.textContent = 'Importing…';

      var promises = csvParsedRows.map(function (row) {
        return apiFetch('/api/schedule', { method: 'POST', body: JSON.stringify(row) })
          .then(function (res) { return res.json(); });
      });

      Promise.all(promises).then(function (results) {
        var succeeded = results.filter(function (r) { return r.entry; }).map(function (r) { return r.entry; });
        var failed    = results.filter(function (r) { return r.error; }).length;

        succeeded.forEach(function (entry) { scheduleData.unshift(entry); });
        renderCalendar();

        csvParsedRows = [];
        document.getElementById('csv-file-input').value = '';
        document.getElementById('csv-file-name').textContent = '';
        document.getElementById('csv-preview').classList.add('hidden');
        document.getElementById('btn-import-csv').disabled = true;
        document.getElementById('btn-import-csv').textContent = 'Import Rows';

        if (failed) showToast('Imported ' + succeeded.length + ', ' + failed + ' failed.', 'warning');
        else showToast('Imported ' + succeeded.length + ' schedule row' + (succeeded.length > 1 ? 's' : '') + '!');
      }).catch(function (err) {
        btn.disabled = false;
        btn.textContent = 'Import Rows';
        showToast('Import failed: ' + err.message, 'error');
      });
    });

    // ── Tab switching ──
    function switchTab(tab) {
      var isSingle = tab === 'single';
      document.getElementById('panel-single').classList.toggle('hidden', !isSingle);
      document.getElementById('panel-bulk').classList.toggle('hidden', isSingle);
      var tSingle = document.getElementById('tab-single');
      var tBulk   = document.getElementById('tab-bulk');
      var activeClass   = 'flex-1 pb-2.5 text-sm font-semibold text-orange-500 border-b-2 border-orange-500 -mb-px transition';
      var inactiveClass = 'flex-1 pb-2.5 text-sm font-medium text-gray-400 border-b-2 border-transparent -mb-px hover:text-gray-600 transition';
      tSingle.className = isSingle ? activeClass : inactiveClass;
      tBulk.className   = isSingle ? inactiveClass : activeClass;
    }

    // ── Staff checkboxes ──
    function initStaffCheckboxes() {
      var container = document.getElementById('staff-checkboxes');
      container.innerHTML = allAssignableNames().map(function (name) {
        return '<label class="flex items-center gap-2 cursor-pointer select-none">' +
          '<input type="checkbox" class="bulk-staff accent-orange-500 w-3.5 h-3.5" value="' + escHtml(name) + '" />' +
          '<span class="text-sm text-gray-700">' + escHtml(name) + '</span>' +
          '</label>';
      }).join('');
      container.querySelectorAll('.bulk-staff').forEach(function (cb) {
        cb.addEventListener('change', updateBulkPreview);
      });
    }

    var _allStaffSelected = false;

    function toggleSelectAllStaff() {
      _allStaffSelected = !_allStaffSelected;
      document.querySelectorAll('.bulk-staff').forEach(function (cb) { cb.checked = _allStaffSelected; });
      document.getElementById('btn-select-all-staff').textContent = _allStaffSelected ? 'Deselect All' : 'Select All';
      updateBulkPreview();
    }

    function getSelectedStaff() {
      return Array.from(document.querySelectorAll('.bulk-staff:checked')).map(function (cb) { return cb.value; });
    }

    function getSelectedDays() {
      return Array.from(document.querySelectorAll('.bulk-dow:checked')).map(function (cb) { return parseInt(cb.value, 10); });
    }

    function getDatesInRange(fromISO, toISO, days) {
      var dates = [];
      var cur = new Date(fromISO + 'T00:00:00');
      var end = new Date(toISO  + 'T00:00:00');
      if (cur > end || !days.length) return dates;
      while (cur <= end) {
        if (days.indexOf(cur.getDay()) !== -1) dates.push(fmtDate(cur));
        cur.setDate(cur.getDate() + 1);
      }
      return dates;
    }

    /** Slots posted per day in bulk part-time mode. */
    function getBulkCount() {
      return Math.max(1, Math.min(20, parseInt(document.getElementById('b-count').value, 10) || 1));
    }

    function updateBulkPreview() {
      var el      = document.getElementById('bulk-preview');
      var isOpen  = bulkShiftType === 'part_time';
      var staff   = getSelectedStaff();
      var perDay  = isOpen ? getBulkCount() : staff.length;
      var fromISO = document.getElementById('b-date-from').value;
      var toISO   = document.getElementById('b-date-to').value;
      var days    = getSelectedDays();

      if (!perDay || !fromISO || !toISO || !days.length) {
        el.textContent = isOpen
          ? 'Set how many part-timers you need, a date range and at least one day to preview.'
          : 'Select staff, a date range and at least one day to preview entry count.';
        el.className = 'text-xs bg-gray-50 border border-gray-200 rounded-lg px-3 py-2 text-gray-500';
        return;
      }
      if (fromISO > toISO) {
        el.textContent = '"To" date must be on or after "From" date.';
        el.className = 'text-xs bg-red-50 border border-red-200 rounded-lg px-3 py-2 text-red-500';
        return;
      }
      var dates = getDatesInRange(fromISO, toISO, days);
      var total = perDay * dates.length;
      if (!total) {
        el.textContent = 'No matching dates in the selected range for the chosen days.';
        el.className = 'text-xs bg-yellow-50 border border-yellow-200 rounded-lg px-3 py-2 text-yellow-700';
        return;
      }
      el.textContent = (isOpen ? perDay + ' open slot' + (perDay !== 1 ? 's' : '') : perDay + ' staff') +
                       ' × ' + dates.length + ' day' + (dates.length !== 1 ? 's' : '') +
                       ' = ' + total + ' entr' + (total !== 1 ? 'ies' : 'y') + ' will be created.';
      el.className = 'text-xs bg-orange-50 border border-orange-200 rounded-lg px-3 py-2 text-orange-700 font-medium';
    }

    // ── Bulk form submit ──
    document.getElementById('bulk-form').addEventListener('submit', function (e) {
      e.preventDefault();
      var errEl = document.getElementById('bulk-error');
      errEl.classList.add('hidden');

      var isOpen  = bulkShiftType === 'part_time';
      var staff   = getSelectedStaff();
      var fromISO = document.getElementById('b-date-from').value;
      var toISO   = document.getElementById('b-date-to').value;
      var days    = getSelectedDays();
      var start   = document.getElementById('b-start').value;
      var end     = document.getElementById('b-end').value;
      var notes   = document.getElementById('b-notes').value.trim();

      if (!isOpen && !staff.length) { errEl.textContent = 'Select at least one staff member.'; errEl.classList.remove('hidden'); return; }
      if (!fromISO || !toISO) { errEl.textContent = 'Please choose a date range.'; errEl.classList.remove('hidden'); return; }
      if (fromISO > toISO) { errEl.textContent = '"To" date must be on or after "From" date.'; errEl.classList.remove('hidden'); return; }
      if (!days.length)   { errEl.textContent = 'Select at least one day of the week.'; errEl.classList.remove('hidden'); return; }
      if (!start || !end) { errEl.textContent = 'Please fill in start and end times.'; errEl.classList.remove('hidden'); return; }

      var dates = getDatesInRange(fromISO, toISO, days);
      if (!dates.length)  { errEl.textContent = 'No matching dates in the selected range for the chosen days.'; errEl.classList.remove('hidden'); return; }

      // In open mode there is no staff list to iterate — post N nameless slots per day.
      var perDay = staff;
      if (isOpen) {
        perDay = [];
        for (var pi = 0; pi < getBulkCount(); pi++) perDay.push('');
      }
      var entries = [];
      perDay.forEach(function (s) {
        dates.forEach(function (d) {
          entries.push({
            staff_name: isOpen ? '' : s, date: d, start_time: start, end_time: end,
            notes: notes, shift_type: bulkShiftType
          });
        });
      });

      if (entries.length > 100 && !confirm('This will create ' + entries.length + ' entries. Continue?')) return;

      var btn = e.target.querySelector('[type="submit"]');
      btn.disabled = true;
      btn.textContent = 'Adding ' + entries.length + ' entr' + (entries.length !== 1 ? 'ies' : 'y') + '…';

      Promise.all(entries.map(function (row) {
        return apiFetch('/api/schedule', { method: 'POST', body: JSON.stringify(row) })
          .then(function (res) { return res.json(); });
      })).then(function (results) {
        btn.disabled = false; btn.textContent = 'Add to Schedule';
        var succeeded = results.filter(function (r) { return r.entry; }).map(function (r) { return r.entry; });
        var failed    = results.filter(function (r) { return r.error; }).length;
        succeeded.forEach(function (entry) { scheduleData.unshift(entry); });
        currentWeekStart = getWeekStart(new Date(fromISO + 'T00:00:00'));
        renderCalendar();
        if (failed) showToast('Added ' + succeeded.length + ', ' + failed + ' failed.', 'warning');
        else        showToast('Added ' + succeeded.length + ' schedule entr' + (succeeded.length !== 1 ? 'ies' : 'y') + '!');
      }).catch(function (err) {
        btn.disabled = false; btn.textContent = 'Add to Schedule';
        errEl.textContent = 'Error: ' + err.message;
        errEl.classList.remove('hidden');
      });
    });

    function duplicateToNextWeek() {
      // Collect all entries in the currently visible week
      var weekStart = fmtDate(currentWeekStart);
      var weekEnd   = fmtDate(addDays(currentWeekStart, 6));
      var thisWeekEntries = scheduleData.filter(function (s) {
        return s.date >= weekStart && s.date <= weekEnd;
      });
      if (!thisWeekEntries.length) {
        showToast('No entries in the current week to duplicate.', 'warning');
        return;
      }
      if (!confirm('Duplicate ' + thisWeekEntries.length + ' entr' + (thisWeekEntries.length !== 1 ? 'ies' : 'y') + ' to next week?')) return;

      // Part-time slots come across as slots, not as whoever happened to take
      // them last week — next week's shifts have to be claimed afresh.
      var entries = thisWeekEntries.map(function (s) {
        var nextDate = fmtDate(addDays(new Date(s.date + 'T00:00:00'), 7));
        return {
          staff_name: isPartTime(s) ? '' : s.staff_name,
          date: nextDate, start_time: s.start_time, end_time: s.end_time,
          notes: s.notes || '', shift_type: s.shift_type || 'assigned'
        };
      });

      Promise.all(entries.map(function (row) {
        return apiFetch('/api/schedule', { method: 'POST', body: JSON.stringify(row) })
          .then(function (res) { return res.json(); });
      })).then(function (results) {
        var succeeded = results.filter(function (r) { return r.entry; }).map(function (r) { return r.entry; });
        var failed    = results.filter(function (r) { return r.error; }).length;
        succeeded.forEach(function (entry) { scheduleData.unshift(entry); });
        // Navigate to next week so user can see the duplicated entries
        currentWeekStart = addDays(currentWeekStart, 7);
        renderCalendar();
        if (failed) showToast('Duplicated ' + succeeded.length + ', ' + failed + ' failed.', 'warning');
        else        showToast('Duplicated ' + succeeded.length + ' entr' + (succeeded.length !== 1 ? 'ies' : 'y') + ' to next week!');
      }).catch(function (err) {
        showToast('Duplicate failed: ' + err.message, 'error');
      });
    }

    function showToast(msg, type) {      var t = document.createElement('div');
      t.textContent = msg;
      t.className = 'fixed bottom-6 right-6 z-50 px-4 py-2.5 rounded-lg text-sm font-medium shadow-lg ' +
        (type === 'warning' ? 'bg-yellow-500 text-white' : type === 'error' ? 'bg-red-500 text-white' : 'bg-green-500 text-white');
      document.body.appendChild(t);
      setTimeout(function () { t.remove(); }, 2500);
    }

    // ══════════════════════════════════════════════════════════════════════════
    // ── Page-level tab switching ──────────────────────────────────────────────
    // ══════════════════════════════════════════════════════════════════════════
    function switchPageTab(tab) {
      var isStaff  = tab === 'staff';
      var isRoute  = tab === 'route';
      var isHours  = tab === 'hours';
      document.getElementById('page-panel-staff').classList.toggle('hidden', !isStaff);
      document.getElementById('page-panel-route').classList.toggle('hidden', !isRoute);
      document.getElementById('page-panel-hours').classList.toggle('hidden', !isHours);
      document.getElementById('pt-summary-panel').classList.toggle('hidden', !isStaff);
      var activeClass   = 'px-5 py-3 text-sm font-semibold text-orange-500 border-b-2 border-orange-500 -mb-px transition';
      var inactiveClass = 'px-5 py-3 text-sm font-medium text-gray-400 border-b-2 border-transparent -mb-px hover:text-gray-600 transition';
      document.getElementById('page-tab-staff').className = isStaff ? activeClass : inactiveClass;
      document.getElementById('page-tab-route').className = isRoute ? activeClass : inactiveClass;
      document.getElementById('page-tab-hours').className = isHours ? activeClass : inactiveClass;
      if (isRoute && !rsDataLoaded) loadRSData();
