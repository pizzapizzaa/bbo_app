    // ── Referral Codes Modal ──
    // A customer holds any number of codes; they live in the referral_codes
    // table and are served on each customer row as _referral_codes.
    var editReferralId = null;

    function openEditReferral(id) {
      var row = customerRows.find(function (r) { return r._id === id; });
      if (!row) return;
      editReferralId = id;
      document.getElementById('edit-referral-name').textContent = row['Full Name'] || '';
      document.getElementById('edit-referral-code').value   = '';
