      var row = customerRows.find(function (r) { return r._id === id; });
      if (!row) return;
      editPTPunchId = id;
      var isHolder = (row._pt_punches_remaining || 0) > 0;
      document.getElementById('edit-pt-punch-name').textContent    = row['Full Name'] || '';
      document.getElementById('edit-pt-punch-holder').checked      = isHolder;
      document.getElementById('edit-pt-punch-count').value         = row._pt_punches_remaining || 0;
      document.getElementById('edit-pt-punch-count-row').classList.toggle('hidden', !isHolder);
      document.getElementById('edit-pt-punch-error').classList.add('hidden');
      document.getElementById('edit-pt-punch-modal').classList.remove('hidden');
    }

    function closeEditPTPunchModal() {
      document.getElementById('edit-pt-punch-modal').classList.add('hidden');
      editPTPunchId = null;
    }

    function submitEditPTPunch() {
      if (!editPTPunchId) return;
      var isHolder  = document.getElementById('edit-pt-punch-holder').checked;
      var remaining = isHolder ? (parseInt(document.getElementById('edit-pt-punch-count').value, 10) || 0) : 0;
      var errEl     = document.getElementById('edit-pt-punch-error');
      var btn       = document.getElementById('edit-pt-punch-submit');
