    // ── CSV Parsing (client-side read only) ──
    function parseCSV(text) {
      var rows = [];
      var lines = text.split(/\r\n|\n|\r/);
      for (var i = 0; i < lines.length; i++) {
        if (!lines[i].trim()) continue;
        rows.push(parseCSVLine(lines[i]));
      }
      return rows;
    }

    function parseCSVLine(line) {
      var row = [], current = '', inQ = false;
      for (var i = 0; i < line.length; i++) {
        var ch = line[i];
        if (ch === '"') {
          if (inQ && line[i + 1] === '"') { current += '"'; i++; }
          else { inQ = !inQ; }
        } else if (ch === ',' && !inQ) {
          row.push(current.trim()); current = '';
        } else { current += ch; }
      }
      row.push(current.trim());
      return row;
    }

    function processCSV(text, filename) {
      // Strip UTF-8 BOM (Excel/Google Sheets often adds \uFEFF at the start)
      text = text.replace(/^\uFEFF/, '');
      var rows = parseCSV(text);
      if (rows.length < 2) {
        showStatus('The CSV file appears to be empty or has only headers.', 'error');
        return;
      }
      var headers = rows[0].map(function (h) {
        return h.replace(/^["']|["']$/g, '').trim();
      }).filter(Boolean);
      if (!headers.length) {
        showStatus('No valid column headers found in the CSV.', 'error');
        return;
      }

      var csvRows = rows.slice(1).map(function (row) {
        var obj = {};
        headers.forEach(function (h, i) { obj[h] = row[i] !== undefined ? row[i] : ''; });
        return obj;
      });

      openImportConfirmModal(csvRows, filename);
    }

    // ── Import confirmation modal ──
    var _pendingImportRows = [];
    var _pendingImportFilename = '';

    function openImportConfirmModal(csvRows, filename) {
      _pendingImportRows     = csvRows;
      _pendingImportFilename = filename;

      var csvCount = csvRows.length;
      var infoEl = document.getElementById('import-confirm-info');
      infoEl.innerHTML =
        'Import <strong>' + csvCount + '</strong> customer(s) from ' +
        '<strong>' + escHtml(filename) + '</strong> into the database.';

      document.getElementById('import-confirm-modal').classList.remove('hidden');
    }

    function closeImportConfirmModal() {
      document.getElementById('import-confirm-modal').classList.add('hidden');
      _pendingImportRows     = [];
      _pendingImportFilename = '';
    }

    function confirmImport() {
      var csvRows  = _pendingImportRows;
      var filename = _pendingImportFilename;
      closeImportConfirmModal();

      showStatus('Uploading ' + csvRows.length + ' customer(s)…', 'info', true);
      var btn = document.querySelector('[onclick="exportCustomers()"]');
      if (btn) btn.disabled = true;

      apiFetch('/api/customers', {
        method: 'POST',
        body: JSON.stringify({ rows: csvRows })
      })
        .then(function (res) {
          return res.text().then(function (t) {
            try { return JSON.parse(t); }
            catch (e) { return { error: 'Server error (HTTP ' + res.status + '): ' + t.slice(0, 120) }; }
          });
        })
        .then(function (data) {
          if (btn) btn.disabled = false;
          if (data.error) { showStatus(data.error, 'error'); return; }
          var msg = 'Added <strong>' + data.added + '</strong> new customer(s) from <strong>' + escHtml(filename) + '</strong>.';
          if (data.skipped > 0) msg += ' <span class="text-gray-500">' + data.skipped + ' duplicate(s) skipped.</span>';
          showStatus(msg, 'success');
          loadCustomers();
        })
        .catch(function (err) {
          if (btn) btn.disabled = false;
          showStatus('Upload failed: ' + err.message, 'error');
        });
    }

    function renderTable() {
      if (!customerHeaders.length) return;

      if ($.fn.DataTable.isDataTable('#customer-table')) {
        $('#customer-table').DataTable().destroy();
      }
      customerTable = null;
      document.querySelector('#customer-table thead tr').innerHTML = '';
      document.querySelector('#customer-table tbody').innerHTML    = '';

      document.getElementById('no-data-msg').classList.add('hidden');
      document.getElementById('table-wrapper').classList.remove('hidden');

      var HIDDEN_COLS = ['Waiver form (old)'];
      var visibleHeaders = customerHeaders.filter(function (h) { return HIDDEN_COLS.indexOf(h) === -1; });

      var cols = visibleHeaders.map(function (h) {
        return {
          title: escHtml(h),
          data: (function (key) {
            return function (row) { return row[key] != null ? String(row[key]) : ''; };
          })(h),
          // DataTables writes cell content as HTML, so every value must be
          // escaped on the way out. Customer fields (name, note, email…) can be
          // set by anyone through the public self-registration form, so an
          // unescaped cell here is a stored-XSS sink running with a staff
          // session. Only 'display' is escaped — sorting and searching keep
          // working on the raw value.
          render: function (val, type) { return type === 'display' ? escHtml(val) : val; },
          defaultContent: ''
        };
      });
      // Handle special Punch Card / Membership columns
      var finalCols = cols.map(function (col, i) {
        var h = visibleHeaders[i];
        if (h === 'Punches') {
          return Object.assign({}, col, {
            render: function (val, type, row) {
              if (type !== 'display') return val;
              if (!row._punches_remaining) return '<span class="text-gray-300">—</span>';
              return '<span class="font-semibold ' + (row._punches_remaining > 0 ? 'text-green-600' : 'text-red-500') + '">' +
                row._punches_remaining + '</span>';
            }
          });
        }
        if (h === 'PT Punches') {
          return Object.assign({}, col, {
            render: function (val, type, row) {
              if (type !== 'display') return val;
              if (!row._pt_punches_remaining) return '<span class="text-gray-300">—</span>';
              return '<span class="font-semibold ' + (row._pt_punches_remaining > 0 ? 'text-indigo-600' : 'text-red-500') + '">' +
                row._pt_punches_remaining + '</span>';
            }
          });
        }
        if (h === 'Membership') {
          return Object.assign({}, col, {
            render: function (val, type, row) {
              if (type !== 'display') return val;
              if (!row._membership_type) return '<span class="text-gray-300">—</span>';
              var end   = row._membership_end_date;
              var today = new Date().toISOString().slice(0, 10);
              var active = end && end >= today;
              return '<span class="inline-flex items-center px-2 py-0.5 rounded-full text-xs font-medium ' +
                (active ? 'bg-blue-100 text-blue-700' : 'bg-red-100 text-red-600') + '">' +
                escHtml(row._membership_type) + '</span>';
            }
          });
        }
        if (h === 'Referral Codes') {
          return Object.assign({}, col, {
            render: function (val, type, row) {
              if (type !== 'display') return val;
              var codes = row._referral_codes || [];
              if (!codes.length) return '<span class="text-gray-300">—</span>';
              return '<span class="inline-flex flex-wrap items-center gap-1.5">' +
                codes.map(function (c) {
                  var tone = c.is_active
                    ? 'bg-purple-100 text-purple-700'
                    : 'bg-gray-100 text-gray-400 line-through';
                  return '<span class="inline-flex items-center gap-1">' +
                    '<span class="font-mono text-xs font-semibold ' + tone + ' px-2 py-0.5 rounded">' +
                      escHtml(c.code) + '</span>' +
                    '<span class="text-xs text-gray-500">' + (c.discount_pct || 0) + '%</span>' +
                    '</span>';
                }).join('') +
                '</span>';
            }
          });
        }
        if (h === 'Member Until') {
          return Object.assign({}, col, {
            render: function (val, type, row) {
              if (type !== 'display') return val;
              if (!row._membership_end_date) return '<span class="text-gray-300">—</span>';
              var today  = new Date().toISOString().slice(0, 10);
              var active = row._membership_end_date >= today;
              return '<span class="text-xs font-medium ' + (active ? 'text-blue-600' : 'text-red-500') + '">' +
                escHtml(row._membership_end_date) + '</span>';
            }
          });
        }
        return col;
      });

      finalCols.push({
        title: 'Actions',
        data: null,
        orderable: false,
        searchable: false,
        className: 'dt-center',
        width: '40px',
        render: function (data, type, row) {
          if (type !== 'display') return '';
          return '<button onclick="openRowActionsMenu(event,\'' + row._id + '\')" ' +
            'class="row-actions-btn inline-flex items-center justify-center w-7 h-7 rounded-lg ' +
            'text-gray-400 hover:text-gray-700 hover:bg-gray-100 transition" title="Actions">' +
            '<svg class="w-4 h-4 pointer-events-none" fill="currentColor" viewBox="0 0 24 24">' +
            '<circle cx="12" cy="5" r="1.5"/><circle cx="12" cy="12" r="1.5"/><circle cx="12" cy="19" r="1.5"/>' +
            '</svg></button>';
        }
      });

      try {
        customerTable = $('#customer-table').DataTable({
          data: customerRows,
          columns: finalCols,
          dom: "<'flex flex-wrap items-center gap-3 mb-3'<''f>>" +
               "t" +
               "<'flex flex-wrap items-center justify-between mt-3'<'text-sm text-gray-500'i><'flex gap-1'p>>",
          order: [[0, 'asc']],
          pageLength: 25,
          language: { emptyTable: 'No customer records found.' }
        });

        // Apply persisted column visibility
        if (hiddenColumns.length) {
          var allDisplayCols = getAllColumnHeaders();
          hiddenColumns.forEach(function (h) {
            var idx = allDisplayCols.indexOf(h);
            if (idx !== -1) customerTable.column(idx).visible(false);
          });
        }
      } catch (err) {
        customerTable = null;
        document.getElementById('table-wrapper').classList.add('hidden');
        document.getElementById('no-data-msg').classList.remove('hidden');
        showStatus('DataTables error: ' + escHtml(err.message), 'error', true);
      }
    }

    function deleteCustomer(id) {
      if (!confirm('Delete this customer? This action cannot be undone.')) return;
      apiFetch('/api/customers/' + id, { method: 'DELETE' })
        .then(function (res) { return res.json(); })
        .then(function (data) {
          if (data.error) { showToast('Delete failed: ' + data.error, 'error'); return; }
          customerRows = customerRows.filter(function (c) { return c._id !== id; });
          if (customerTable) {
            customerTable.clear();
            customerTable.rows.add(customerRows);
            customerTable.draw();
          }
          updateCount();
          showToast('Customer deleted.', 'warning');
        })
        .catch(function (err) { showToast('Delete failed: ' + err.message, 'error'); });
    }

    function clearAllCustomers() {
      if (!confirm('Clear ALL customer data? This cannot be undone.')) return;
      apiFetch('/api/customers', { method: 'DELETE', body: JSON.stringify({ confirm: 'DELETE ALL CUSTOMERS' }) })
        .then(function (res) { return res.json(); })
        .then(function () {
          customerHeaders = [];
          customerRows    = [];
          if (customerTable) { customerTable.destroy(); customerTable = null; }
          document.querySelector('#customer-table thead tr').innerHTML = '';
          document.querySelector('#customer-table tbody').innerHTML = '';
          document.getElementById('table-wrapper').classList.add('hidden');
          document.getElementById('no-data-msg').classList.remove('hidden');
          updateCount();
          showToast('All customer data cleared.', 'warning');
        })
        .catch(function (err) { showToast('Clear failed: ' + err.message, 'error'); });
    }

    function exportCustomers() {
      if (!customerRows.length) {
        showStatus('No customer data to export.', 'error');
        return;
      }
      var headers = DEFAULT_HEADERS.concat(['Referral Codes']);
      var lines = [headers.map(function (h) { return '"' + h.replace(/"/g, '""') + '"'; }).join(',')];
      customerRows.forEach(function (row) {
        lines.push(headers.map(function (h) {
          if (h === 'Referral Codes') {
            // "CODE (15%)" per code, paused ones marked, semicolon-separated.
            var v = (row._referral_codes || []).map(function (c) {
              return c.code + ' (' + (c.discount_pct || 0) + '%' + (c.is_active ? '' : ', paused') + ')';
            }).join('; ');
            return '"' + v.replace(/"/g, '""') + '"';
          }
          var v = row[h] != null ? String(row[h]) : '';
          return '"' + v.replace(/"/g, '""') + '"';
        }).join(','));
      });
      var blob = new Blob([lines.join('\r\n')], { type: 'text/csv;charset=utf-8;' });
      var url = URL.createObjectURL(blob);
      var a = document.createElement('a');
      a.href = url; a.download = 'Customer List.csv';
      document.body.appendChild(a); a.click();
      document.body.removeChild(a); URL.revokeObjectURL(url);
    }

    function updateCount() {
      var el = document.getElementById('customer-count');
      el.textContent = customerRows.length
        ? customerRows.length + ' customer' + (customerRows.length !== 1 ? 's' : '') + ' in database'
        : '';
    }

    function showStatus(msg, type, persistent) {
      var el = document.getElementById('upload-status');
      var colorClass = type === 'error'
        ? 'bg-red-50 border-red-200 text-red-700'
        : type === 'info'
        ? 'bg-blue-50 border-blue-200 text-blue-700'
        : 'bg-green-50 border-green-200 text-green-700';
      el.className = 'mb-4 px-4 py-3 rounded-xl border text-sm flex items-start justify-between gap-3 ' + colorClass;
      el.innerHTML = '<span>' + msg + '</span>' +
        '<button onclick="this.closest(\'#upload-status\').classList.add(\'hidden\')" ' +
        'class="shrink-0 font-bold text-lg leading-none opacity-60 hover:opacity-100">&times;</button>';
      el.classList.remove('hidden');
      if (!persistent) setTimeout(function () { el.classList.add('hidden'); }, 6000);
    }

    function showToast(msg, type) {
      var t = document.createElement('div');
      t.textContent = msg;
      t.className = 'fixed bottom-6 right-6 z-50 px-4 py-2.5 rounded-lg text-sm font-medium shadow-lg ' +
        (type === 'warning' ? 'bg-yellow-500 text-white' : type === 'error' ? 'bg-red-500 text-white' : 'bg-green-500 text-white');
      document.body.appendChild(t);
      setTimeout(function () { t.remove(); }, 2500);
    }

    function escHtml(str) {
      return String(str == null ? '' : str)
        .replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;')
        .replace(/"/g,'&quot;').replace(/'/g,'&#39;');
    }

    // ── Row actions context menu ──
    var _ramId = null;

    function openRowActionsMenu(e, id) {
      e.stopPropagation();
      var btn  = e.currentTarget;
      var menu = document.getElementById('row-actions-menu');

      // If same button clicked again, toggle off
      if (_ramId === id && !menu.classList.contains('hidden')) {
        menu.classList.add('hidden');
        _ramId = null;
        return;
      }
      _ramId = id;

      // Position menu below the button
      var rect = btn.getBoundingClientRect();
      var menuW = 176; // min-w-44
      var left  = rect.right - menuW + window.scrollX;
      if (left < 4) left = rect.left + window.scrollX;
      menu.style.top  = (rect.bottom + window.scrollY + 4) + 'px';
      menu.style.left = Math.max(4, left) + 'px';
      menu.classList.remove('hidden');
    }

    function closeRowActionsMenu() {
      document.getElementById('row-actions-menu').classList.add('hidden');
      _ramId = null;
    }

    document.addEventListener('click', function (e) {
      if (!e.target.closest('#row-actions-menu') && !e.target.closest('.row-actions-btn')) {
        closeRowActionsMenu();
      }
    });

    function ramAction(fn) {
      if (!_ramId) return;
      var id = _ramId;
      closeRowActionsMenu();
      fn(id);
    }
  </script>

  <!-- Row Actions Context Menu -->
  <div id="row-actions-menu"
       class="hidden fixed z-50 bg-white border border-gray-200 rounded-xl shadow-xl py-1.5 min-w-44"
       style="min-width:176px">
    <button onclick="ramAction(openEditMembership)"
      class="w-full flex items-center gap-2.5 px-4 py-2 text-sm text-teal-600 hover:bg-teal-50 transition text-left">
      <svg class="w-4 h-4 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
          d="M10 6H5a2 2 0 00-2 2v9a2 2 0 002 2h14a2 2 0 002-2V8a2 2 0 00-2-2h-5m-4 0V5a2 2 0 114 0v1m-4 0a2 2 0 104 0"/>
      </svg>
      Membership
    </button>
    <button onclick="ramAction(openEditPunchCard)"
      class="w-full flex items-center gap-2.5 px-4 py-2 text-sm text-blue-600 hover:bg-blue-50 transition text-left">
      <svg class="w-4 h-4 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
          d="M15.232 5.232l3.536 3.536m-2.036-5.036a2.5 2.5 0 113.536 3.536L6.5 21.036H3v-3.572L16.732 3.732z"/>
      </svg>
      Edit Punch Card
    </button>
    <button onclick="ramAction(openEditPTPunch)"
      class="w-full flex items-center gap-2.5 px-4 py-2 text-sm text-indigo-600 hover:bg-indigo-50 transition text-left">
      <svg class="w-4 h-4 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
          d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2"/>
      </svg>
      Edit PT Punch
    </button>
    <button onclick="ramAction(openEditReferral)"
      class="w-full flex items-center gap-2.5 px-4 py-2 text-sm text-purple-600 hover:bg-purple-50 transition text-left">
      <svg class="w-4 h-4 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
          d="M8.684 13.342A3 3 0 108.658 10.658M15.316 10.658a3 3 0 10.026 2.684m0 0l-6.632-2.684"/>
      </svg>
      Referral Codes
    </button>
    <div class="border-t border-gray-100 my-1"></div>
    <button onclick="ramAction(deleteCustomer)"
      class="w-full flex items-center gap-2.5 px-4 py-2 text-sm text-red-500 hover:bg-red-50 transition text-left">
      <svg class="w-4 h-4 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
          d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"/>
      </svg>
      Delete Customer
    </button>
  </div>
</div>
</MainLayout>
