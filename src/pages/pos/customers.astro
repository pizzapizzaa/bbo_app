    }

    /** The codes held by the customer whose modal is open. */
    function _openReferralCodes() {
      var row = customerRows.find(function (r) { return r._id === editReferralId; });
      return (row && row._referral_codes) || [];
    }

    function renderReferralList() {
      var el    = document.getElementById('referral-list');
      var codes = _openReferralCodes();
      if (!codes.length) {
        el.innerHTML = '<p class="text-sm text-gray-400 italic py-2">No codes yet — add one below.</p>';
        return;
      }
      el.innerHTML = codes.map(function (c) {
        var q = function (s) { return String(s).replace(/'/g, "\\'"); };
        return '<div class="flex flex-wrap items-center gap-2 border border-gray-200 rounded-xl px-3 py-2 ' +
            (c.is_active ? '' : 'bg-gray-50 opacity-70') + '">' +
          '<span class="font-mono text-xs font-semibold bg-purple-100 text-purple-700 px-2 py-1 rounded">' +
            escHtml(c.code) + '</span>' +
          (c.is_active ? '' : '<span class="text-xs font-medium text-gray-400 uppercase">Paused</span>') +
          '<input type="number" min="1" max="100" step="1" value="' + (c.discount_pct || 0) + '" ' +
            'onchange="updateReferralCode(\'' + q(c.id) + '\', { discount_pct: parseInt(this.value, 10) })" ' +
            'class="w-16 border border-gray-200 rounded-lg px-2 py-1 text-sm ' +
            'focus:outline-none focus:ring-2 focus:ring-purple-300" />' +
          '<span class="text-xs text-gray-500">% off</span>' +
          '<input type="number" min="0" max="100" step="1" value="' + (c.rental_discount_pct || 0) + '" ' +
            'title="Discount on shoe &amp; chalk rental" ' +
            'onchange="updateReferralCode(\'' + q(c.id) + '\', { rental_discount_pct: parseInt(this.value, 10) })" ' +
            'class="w-16 border border-gray-200 rounded-lg px-2 py-1 text-sm ' +
            'focus:outline-none focus:ring-2 focus:ring-purple-300" />' +
          '<span class="text-xs text-gray-500">% rental</span>' +
          '<input type="text" maxlength="60" value="' + escHtml(c.label || '') + '" placeholder="Label" ' +
            'onchange="updateReferralCode(\'' + q(c.id) + '\', { label: this.value })" ' +
            'class="flex-1 min-w-[110px] border border-gray-200 rounded-lg px-2 py-1 text-sm ' +
            'focus:outline-none focus:ring-2 focus:ring-purple-300" />' +
          '<label class="flex items-center gap-1.5 text-xs text-gray-600 cursor-pointer select-none">' +
            '<input type="checkbox" ' + (c.is_active ? 'checked' : '') + ' ' +
              'onchange="updateReferralCode(\'' + q(c.id) + '\', { is_active: this.checked })" ' +
              'class="w-3.5 h-3.5 rounded accent-purple-500" />Active</label>' +
          '<button type="button" onclick="copyReferralCode(\'' + q(c.code) + '\')" title="Copy code" ' +
            'class="text-gray-400 hover:text-gray-700 text-xs font-medium px-2 py-1 rounded hover:bg-gray-100">Copy</button>' +
          '<button type="button" onclick="deleteReferralCode(\'' + q(c.id) + '\')" title="Delete code" ' +
            'class="text-gray-400 hover:text-red-600 text-xs font-medium px-2 py-1 rounded hover:bg-red-50">Delete</button>' +
          '</div>';
      }).join('');
    }

    /** Write `codes` back onto the customer row and refresh modal + table. */
    function _setReferralCodes(codes) {
      var row = customerRows.find(function (r) { return r._id === editReferralId; });
      if (row) {
        row._referral_codes  = codes;
        row['Referral Codes'] = codes.map(function (c) { return c.code; }).join(', ');
      }
      renderReferralList();
      if (customerTable) { customerTable.clear(); customerTable.rows.add(customerRows).draw(false); }
    }

    // Suggest a code from the customer's name plus a short random suffix.
    function generateReferralCode() {
      var row  = customerRows.find(function (r) { return r._id === editReferralId; });
      var base = String((row && row['Full Name']) || '').toUpperCase().replace(/[^A-Z0-9]/g, '').slice(0, 8) || 'BBO';
      var rand = '';
      var ALPHABET = 'ABCDEFGHJKLMNPQRSTUVWXYZ23456789'; // no look-alikes (0/O, 1/I)
      for (var i = 0; i < 4; i++) rand += ALPHABET[Math.floor(Math.random() * ALPHABET.length)];
      document.getElementById('edit-referral-code').value = base + '-' + rand;
    }

    function copyReferralCode(code) {
      if (!code) return;
      var done = function () { showToast('Code copied: ' + code, 'success'); };
      if (navigator.clipboard && navigator.clipboard.writeText) {
        navigator.clipboard.writeText(code).then(done).catch(function () { showToast('Copy failed.', 'error'); });
      } else {
        var ta = document.createElement('textarea');
        ta.value = code;
        document.body.appendChild(ta);
        ta.select();
        try { document.execCommand('copy'); done(); } catch (e) { showToast('Copy failed.', 'error'); }
        document.body.removeChild(ta);
      }
    }

    function submitAddReferralCode() {
      if (!editReferralId) return;
      var ownerId = editReferralId;
      var code      = document.getElementById('edit-referral-code').value.trim().toUpperCase();
      var pct       = parseInt(document.getElementById('edit-referral-pct').value, 10) || 0;
      var rentalPct = parseInt(document.getElementById('edit-referral-rental').value, 10) || 0;
      var label     = document.getElementById('edit-referral-label').value.trim();
      var errEl     = document.getElementById('edit-referral-error');
      var btn       = document.getElementById('edit-referral-submit');

      if (!/^[A-Z0-9][A-Z0-9-]{2,19}$/.test(code)) {
        errEl.textContent = 'Code must be 3–20 characters: letters, numbers or dashes.';
        errEl.classList.remove('hidden'); return;
      }
      if (pct < 1 || pct > 100) {
        errEl.textContent = 'Discount must be between 1 and 100 percent.';
        errEl.classList.remove('hidden'); return;
      }
      if (rentalPct < 0 || rentalPct > 100) {
        errEl.textContent = 'Rental discount must be between 0 and 100 percent.';
        errEl.classList.remove('hidden'); return;
      }
      errEl.classList.add('hidden');
      btn.disabled = true; btn.textContent = 'Adding…';

      apiFetch('/api/referral-codes', {
        method: 'POST',
        body: JSON.stringify({ code: code, discount_pct: pct, rental_discount_pct: rentalPct,
                               label: label, owner_id: ownerId })
      })
        .then(function (res) { return res.json(); })
        .then(function (result) {
          btn.disabled = false; btn.textContent = 'Add';
          if (result.error) { errEl.textContent = result.error; errEl.classList.remove('hidden'); return; }
          _setReferralCodes(_openReferralCodes().concat([{
            id:                  result.row.id,
            code:                result.row.code,
            discount_pct:        result.row.discount_pct,
            rental_discount_pct: result.row.rental_discount_pct || 0,
            label:               result.row.label || '',
            is_active:           result.row.is_active !== false
          }]));
          document.getElementById('edit-referral-code').value  = '';
          document.getElementById('edit-referral-label').value = '';
          showToast('Referral code added.', 'success');
        })
        .catch(function (err) {
          btn.disabled = false; btn.textContent = 'Add';
          errEl.textContent = 'Failed: ' + err.message; errEl.classList.remove('hidden');
        });
    }

    /** PATCH one field of one code, then mirror the saved row back into state. */
    function updateReferralCode(codeId, patch) {
      var errEl = document.getElementById('edit-referral-error');
      errEl.classList.add('hidden');
      apiFetch('/api/referral-codes/' + codeId, {
        method: 'PATCH',
        body: JSON.stringify(patch)
      })
        .then(function (res) { return res.json(); })
        .then(function (result) {
          if (result.error) {
            errEl.textContent = result.error; errEl.classList.remove('hidden');
            renderReferralList();   // revert the input to the stored value
            return;
          }
          _setReferralCodes(_openReferralCodes().map(function (c) {
            return c.id === codeId
              ? { id: c.id, code: result.row.code, discount_pct: result.row.discount_pct,
                  rental_discount_pct: result.row.rental_discount_pct || 0,
                  label: result.row.label || '', is_active: result.row.is_active !== false }
              : c;
          }));
          showToast('Code updated.', 'success');
        })
        .catch(function (err) {
          errEl.textContent = 'Failed: ' + err.message; errEl.classList.remove('hidden');
          renderReferralList();
        });
    }

    function deleteReferralCode(codeId) {
      if (!confirm('Delete this code? It will stop working immediately. Past check-ins keep their record.')) return;
      var errEl = document.getElementById('edit-referral-error');
      errEl.classList.add('hidden');
      apiFetch('/api/referral-codes/' + codeId, { method: 'DELETE' })
        .then(function (res) { return res.json(); })
        .then(function (result) {
          if (result.error) { errEl.textContent = result.error; errEl.classList.remove('hidden'); return; }
          _setReferralCodes(_openReferralCodes().filter(function (c) { return c.id !== codeId; }));
          showToast('Referral code deleted.', 'warning');
        })
        .catch(function (err) {
          errEl.textContent = 'Failed: ' + err.message; errEl.classList.remove('hidden');
        });
    }

