---
import MainLayout from '../../layouts/MainLayout.astro';
import { PROMOTIONS } from '../../lib/promotions';
import { CHECKIN_TYPES, ADDONS, MANUAL_DISCOUNTS, type AddonDef } from '../../lib/pricing';

/** Products grouped for the <optgroup>s, in the order pricing.ts lists them. */
const TYPE_GROUPS: { group: string; items: typeof CHECKIN_TYPES }[] = [];
for (const t of CHECKIN_TYPES) {
  const last = TYPE_GROUPS[TYPE_GROUPS.length - 1];
  if (last && last.group === t.group) last.items.push(t);
  else TYPE_GROUPS.push({ group: t.group, items: [t] });
}
const vnd = (n: number) => n.toLocaleString('en-US');

/** Element-id stem for a tier set. Mirrored by tierSlug() in the inline script. */
const slug = (v: string) => v.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, '');

/**
 * Add-ons as the form draws them: one column per group, with each tier set
 * collapsed into a single entry carrying all of its rates. A tier set is one
 * checkbox and a stepper — three chalk-bag checkboxes would invite booking two
 * of them for the same group.
 */
type AddonEntry =
  | { kind: 'single'; addon: AddonDef }
  | { kind: 'tiered'; name: string; tiers: AddonDef[] };

const ADDON_GROUPS: { group: string; entries: AddonEntry[] }[] = [];
for (const a of ADDONS) {
  let g = ADDON_GROUPS.find((x) => x.group === a.group);
  if (!g) ADDON_GROUPS.push((g = { group: a.group, entries: [] }));
  if (!a.tier) {
    g.entries.push({ kind: 'single', addon: a });
    continue;
  }
  const open = g.entries.find(
    (e): e is Extract<AddonEntry, { kind: 'tiered' }> => e.kind === 'tiered' && e.name === a.tier!.of,
  );
  if (open) open.tiers.push(a);
  else g.entries.push({ kind: 'tiered', name: a.tier.of, tiers: [a] });
}

/** Tables the inline preview prices against — the same ones the server bills from. */
const PRICING_DATA = { checkin_types: CHECKIN_TYPES, addons: ADDONS, discounts: MANUAL_DISCOUNTS };
---

<MainLayout title="Daily Check-in" activePage="checkin">

  <!-- ── Check-in Form ──────────────────────────────────────────────────────
       Below `lg` this is the narrow vertical card the front desk uses on a
       phone — one field per row, in the order staff work through them.
       From `lg` up (desktop and landscape tablet) the same card goes full
       width and the fields flow into rows, so a check-in fits on screen
       without scrolling and the day's tracker sits right below it. -->
  <div class="bg-gray-900 rounded-xl shadow-lg p-6 mb-6">
    <h2 class="font-semibold text-white mb-5 tracking-wide">New Check-in</h2>

    <form id="checkin-form" class="space-y-4 lg:space-y-5" novalidate>

      <!-- ── Row 1: who, when, what ── -->
      <div class="grid grid-cols-1 gap-4 lg:grid-cols-2 xl:grid-cols-12">

        <!-- Customer search (select from dropdown only — no free entry) -->
        <div class="xl:col-span-4">
          <label class="block text-sm font-medium text-gray-300 mb-1.5">
            Customer <span class="text-red-400">*</span>
          </label>
          <!-- Hidden value holder: written by picker, read by form submit -->
          <input id="f-customer" type="hidden" value="" />
          <div class="relative">
            <input
              id="f-customer-search"
              type="text"
              placeholder="Search customer name…"
              autocomplete="off"
              class="w-full bg-gray-800 border border-gray-600 text-white placeholder-gray-500 rounded-lg px-3 py-2 pr-8 text-sm
                     focus:outline-none focus:ring-2 focus:ring-orange-400 focus:border-transparent"
            />
            <!-- Clear selection button -->
            <button
              type="button"
              id="f-customer-clear"
              class="hidden absolute right-2 top-1/2 -translate-y-1/2 text-gray-400 hover:text-white p-0.5"
              title="Clear selection"
              onclick="clearCustomerSelection()"
            >
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/>
              </svg>
            </button>
            <!-- Live dropdown -->
            <ul
              id="f-customer-dropdown"
              class="hidden absolute z-50 left-0 right-0 mt-1 bg-gray-800 border border-gray-600
                     rounded-lg overflow-y-auto shadow-2xl max-h-52"
            ></ul>
          </div>
          <!-- Shown only when "Other" is selected -->
          <div id="f-other-name-row" class="hidden mt-2">
            <input
              id="f-other-name"
              type="text"
              placeholder="Note customer name for records…"
              class="w-full bg-gray-800 border border-orange-500/60 text-white placeholder-gray-500
                     rounded-lg px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-orange-400"
            />
          </div>
          <p id="customer-hint" class="text-xs text-gray-500 mt-1">
            Load customers on the <a href="/pos/customers" class="text-orange-400 hover:underline">Customers</a> page first.
          </p>
        </div>

        <!-- Check-in Date + Time -->
        <div class="grid grid-cols-2 gap-3 xl:col-span-4">
          <div>
            <label class="block text-sm font-medium text-gray-300 mb-1.5">
              Date <span class="text-red-400">*</span>
            </label>
            <input
              id="f-checkin-date"
              type="date"
              class="w-full bg-gray-800 border border-gray-600 text-white rounded-lg px-3 py-2 text-sm
                     focus:outline-none focus:ring-2 focus:ring-orange-400 focus:border-transparent"
            />
          </div>
          <div>
            <label class="block text-sm font-medium text-gray-300 mb-1.5">
              Time <span class="text-red-400">*</span>
            </label>
            <input
              id="f-checkin-time"
              type="time"
              class="w-full bg-gray-800 border border-gray-600 text-white rounded-lg px-3 py-2 text-sm
                     focus:outline-none focus:ring-2 focus:ring-orange-400 focus:border-transparent"
            />
          </div>
        </div>

        <!-- Check-in Type -->
        <div class="lg:col-span-2 xl:col-span-4">
          <label class="block text-sm font-medium text-gray-300 mb-1.5">Check-in Type</label>
          <select
            id="f-checkin-type"
            class="w-full bg-gray-800 border border-gray-600 text-white rounded-lg px-3 py-2 text-sm
                   focus:outline-none focus:ring-2 focus:ring-orange-400 focus:border-transparent"
          >
            <!-- Options come from src/lib/pricing.ts, the table the server
                 bills from, so the counter can never quote a stale price. -->
            <option value="" data-price="0">— Select type —</option>
            {TYPE_GROUPS.map((g) => (
              <optgroup label={g.group}>
                {g.items.map((t) => (
                  <option value={t.value} data-price={t.price}>
                    {t.price ? `${t.value} (${vnd(t.price)} ₫)` : t.value}
                  </option>
                ))}
              </optgroup>
            ))}
          </select>
          <!-- Auto-applied promotion. Explains the amount below, and warns
               when a hand-picked discount is quietly costing the customer. -->
          <p id="promo-banner" class="hidden text-xs rounded-lg px-3 py-2 mt-1.5"></p>
        </div>

      </div>

      <!-- ── Row 2: the two optional panels, side by side once there is room ── -->
      <div class="grid grid-cols-1 gap-4 lg:grid-cols-2">

        <!-- Add-ons (collapsible) -->
        <div>
          <button type="button" onclick="toggleAddons()"
                  class="w-full flex items-center justify-between text-sm font-medium text-gray-300 mb-1.5 focus:outline-none">
            <span>Add-ons</span>
            <svg id="addons-chevron" class="w-4 h-4 transition-transform duration-200"
                 fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/>
            </svg>
          </button>
          <div id="addons-body" class="hidden">
            <!-- One column per group in pricing.ts — gear you climb with on
                 the left, everything you consume on the right. Stacks to one
                 column on narrow screens so the desk tablet keeps full-width
                 touch targets. -->
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-x-6 gap-y-4
                        bg-gray-800 border border-gray-600 rounded-lg px-3 py-2.5">
              {ADDON_GROUPS.map((g) => (
                <div class="space-y-2">
                  <p class="text-xs text-gray-500 uppercase tracking-wide">{g.group}</p>

                  {g.entries.map((e) => e.kind === 'single' ? (
                    <label class="flex items-center gap-2 text-sm text-gray-300 cursor-pointer">
                      <input type="checkbox" class="addon-cb accent-orange-500 w-4 h-4 cursor-pointer"
                             data-name={e.addon.name} data-price={e.addon.price}
                             data-rental={e.addon.rental ? '1' : null} />
                      <span>{e.addon.name} <span class="text-gray-500 text-xs">{vnd(e.addon.price)} ₫</span></span>
                    </label>
                  ) : (
                    <!-- A tier set: one checkbox, one stepper. syncAddonTier()
                         writes the chosen tier's product name and price onto the
                         checkbox, so the totals, the submitted add-on list and
                         the rental-discount lookup read the same data attributes
                         as every other add-on — and the name that lands on the
                         row is a real product the server will accept. -->
                    <div>
                      <label class="flex items-center gap-2 text-sm text-gray-300 cursor-pointer">
                        <input type="checkbox" id={`addon-tier-${slug(e.name)}`}
                               class="addon-cb accent-orange-500 w-4 h-4 cursor-pointer"
                               data-tier-of={e.name}
                               data-name={e.tiers[0].name} data-price={e.tiers[0].price}
                               data-rental={e.tiers[0].rental ? '1' : null} />
                        <span>{e.name} <span id={`tier-price-${slug(e.name)}`} class="text-gray-500 text-xs">{vnd(e.tiers[0].price)} ₫</span></span>
                      </label>
                      <div id={`tier-qty-${slug(e.name)}`} class="hidden mt-1.5 ml-6 flex items-center gap-2">
                        <button type="button" id={`tier-dec-${slug(e.name)}`} aria-label={`Fewer — ${e.name}`}
                                class="w-8 h-8 rounded-md bg-gray-700 hover:bg-gray-600 text-gray-200
                                       text-lg leading-none focus:outline-none focus:ring-2 focus:ring-orange-400
                                       disabled:opacity-40 disabled:cursor-not-allowed disabled:hover:bg-gray-700">−</button>
                        <span id={`tier-label-${slug(e.name)}`} class="text-xs text-gray-400 min-w-[64px] text-center">{e.tiers[0].tier?.label}</span>
                        <button type="button" id={`tier-inc-${slug(e.name)}`} aria-label={`More — ${e.name}`}
                                class="w-8 h-8 rounded-md bg-gray-700 hover:bg-gray-600 text-gray-200
                                       text-lg leading-none focus:outline-none focus:ring-2 focus:ring-orange-400
                                       disabled:opacity-40 disabled:cursor-not-allowed disabled:hover:bg-gray-700">+</button>
                      </div>
                    </div>
                  ))}
                </div>
              ))}
            </div>
          </div>
        </div>

        <!-- Discount (collapsible) -->
        <div>
          <button type="button" onclick="toggleDiscount()"
                  class="w-full flex items-center justify-between text-sm font-medium text-gray-300 mb-1.5 focus:outline-none">
            <span>Discount</span>
            <svg id="discount-chevron" class="w-4 h-4 transition-transform duration-200"
                 fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/>
            </svg>
          </button>
          <div id="discount-body" class="hidden">
            <div class="bg-gray-800 border border-gray-600 rounded-lg px-3 py-2.5 space-y-2">
              <label class="flex items-center gap-2 text-sm text-gray-300 cursor-pointer">
                <input type="radio" name="discount" class="discount-rb accent-orange-500 w-4 h-4 cursor-pointer" value="" checked />
                <span class="text-gray-400">No discount</span>
              </label>
              {MANUAL_DISCOUNTS.map((d) => (
                <label class="flex items-center gap-2 text-sm text-gray-300 cursor-pointer">
                  <input type="radio" name="discount" class="discount-rb accent-orange-500 w-4 h-4 cursor-pointer" value={d.id} />
                  <span>{d.title} <span class="text-gray-500 text-xs">{d.hint}</span></span>
                </label>
              ))}
              <label class="flex items-center gap-2 text-sm text-gray-300 cursor-pointer">
                <input type="radio" name="discount" class="discount-rb accent-orange-500 w-4 h-4 cursor-pointer" value="referral" />
                <span>Referral / promo code <span class="text-gray-500 text-xs">Discount set by the code</span></span>
              </label>
              <!-- Code entry — only relevant when "Referral / promo code" is picked -->
              <div id="referral-code-row" class="hidden pl-6">
                <input
                  id="f-referral-code"
                  type="text"
                  maxlength="20"
                  placeholder="Enter referral or promo code…"
                  autocomplete="off"
                  class="w-full bg-gray-900 border border-gray-600 text-white placeholder-gray-500 font-mono uppercase
                         rounded-lg px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-purple-400"
                />
                <p id="referral-status" class="text-xs text-gray-500 mt-1">
                  Ask the customer for the code shared with them.
                </p>
                <!-- Cross-check: flags a fixed discount above that would beat this code -->
                <p id="referral-overlap" class="hidden text-xs text-yellow-400 mt-1"></p>
              </div>
              <p class="text-xs text-gray-500 pt-1 border-t border-gray-700">
                Only one discount applies per check-in — picking one clears the others.
              </p>
            </div>
          </div>
        </div>

      </div>

      <!-- ── Row 3: how it is paid for ──────────────────────────────────────
           A wrapping flex row rather than a fixed grid: the two "use punch
           from" fields appear only for their payment method, and flex lets
           the remaining fields close the gap instead of leaving a hole. -->
      <div class="flex flex-col gap-4 lg:flex-row lg:flex-wrap">

        <!-- Payment method -->
        <div class="lg:flex-1 lg:min-w-[180px]">
          <label class="block text-sm font-medium text-gray-300 mb-1.5">
            Payment Method <span class="text-red-400">*</span>
          </label>
          <select
            id="f-payment"
            class="w-full bg-gray-800 border border-gray-600 text-white rounded-lg px-3 py-2 text-sm
                   focus:outline-none focus:ring-2 focus:ring-orange-400 focus:border-transparent"
          >
            <option value="">— Select —</option>
            <option value="Cash">Cash</option>
            <option value="Local Card">Local Card</option>
            <option value="International Card">International Card</option>
            <option value="Local Bank Transfer">Local Bank Transfer</option>
            <option value="Complimentary">Complimentary</option>
            <option value="Punch Card">Punch Card</option>
            <option value="PT Punch">PT Punch</option>
            <option value="Valid Membership">Valid Membership</option>
          </select>
        </div>

        <!-- Use punch from (shown only when Punch Card is selected) -->
        <div id="punch-from-row" class="hidden lg:flex-1 lg:min-w-[200px]">
          <label class="block text-sm font-medium text-gray-300 mb-1.5">
            Use punch from <span class="text-red-400">*</span>
          </label>
          <select
            id="f-punch-from"
            class="w-full bg-gray-800 border border-gray-600 text-white rounded-lg px-3 py-2 text-sm
                   focus:outline-none focus:ring-2 focus:ring-orange-400 focus:border-transparent"
          >
            <option value="">— Select punch card holder —</option>
          </select>
          <p id="punch-from-hint" class="hidden text-xs text-yellow-400 mt-1">No punch card holders with remaining punches found.</p>
        </div>

        <!-- Use PT punch from (shown only when PT Punch is selected) -->
        <div id="pt-punch-from-row" class="hidden lg:flex-1 lg:min-w-[200px]">
          <label class="block text-sm font-medium text-gray-300 mb-1.5">
            Use PT punch from <span class="text-red-400">*</span>
          </label>
          <select
            id="f-pt-punch-from"
            class="w-full bg-gray-800 border border-gray-600 text-white rounded-lg px-3 py-2 text-sm
                   focus:outline-none focus:ring-2 focus:ring-indigo-400 focus:border-transparent"
          >
            <option value="">— Select PT punch holder —</option>
          </select>
          <p id="pt-punch-from-hint" class="hidden text-xs text-yellow-400 mt-1">No customers with remaining PT punches found.</p>
        </div>

        <!-- Amount -->
        <div class="lg:flex-1 lg:min-w-[180px]">
          <label class="block text-sm font-medium text-gray-300 mb-1.5">
            Amount (VND) <span class="text-gray-500 text-xs font-normal">— priced by the server</span>
          </label>
          <input
            id="f-amount"
            type="number"
            min="0"
            step="0.01"
            placeholder="0.00"
            class="w-full bg-gray-800 border border-gray-600 text-white placeholder-gray-500 rounded-lg px-3 py-2 text-sm
                   focus:outline-none focus:ring-2 focus:ring-orange-400 focus:border-transparent"
          />
          <!-- Shown only when staff type over the quoted figure. -->
          <p id="amount-note" class="hidden text-xs text-yellow-400 mt-1"></p>
        </div>

        <!-- Notes -->
        <div class="lg:flex-1 lg:min-w-[200px]">
          <label class="block text-sm font-medium text-gray-300 mb-1.5">Notes</label>
          <input
            id="f-notes"
            type="text"
            placeholder="Optional…"
            class="w-full bg-gray-800 border border-gray-600 text-white placeholder-gray-500 rounded-lg px-3 py-2 text-sm
                   focus:outline-none focus:ring-2 focus:ring-orange-400 focus:border-transparent"
          />
        </div>

      </div>

      <!-- Error -->
      <div id="form-error" class="hidden text-sm text-red-400 bg-red-900/40 border border-red-700 rounded-lg px-3 py-2"></div>

      <!-- ── Row 4: confirm ── -->
      <div class="flex flex-col gap-4 lg:flex-row lg:items-center">
        <!-- Check-in timestamp preview -->
        <div class="lg:flex-1 text-xs text-gray-400 bg-gray-800 border border-gray-700 rounded-lg px-3 py-2">
          Timestamp: <span id="ts-preview" class="font-medium text-gray-200"></span>
        </div>

        <button
          type="submit"
          class="w-full lg:w-auto lg:min-w-[220px] bg-orange-500 hover:bg-orange-600 text-white font-semibold
                 py-3 lg:px-8 rounded-lg text-sm transition active:scale-[0.98] flex items-center justify-center gap-2"
        >
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
              d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/>
          </svg>
          Record Check-in
        </button>
      </div>
    </form>
  </div>

  <!-- ── Daily tracker: stats, date range and the check-ins table ──────────
       Everything that reads the day rather than records it lives here, below
       the check-in card, so the range pickers sit next to the list they
       filter instead of at the top of the page. -->
  <div class="bg-white rounded-xl shadow-sm border border-gray-100 p-6">

    <!-- Title + daily stats -->
    <div class="flex flex-wrap items-center justify-between gap-4">
      <h2 class="font-semibold text-gray-800">
        Check-ins: <span id="table-date-label" class="text-orange-500"></span>
      </h2>
      <div class="flex items-center gap-4">
        <div class="text-center">
          <p class="text-xs text-gray-500 uppercase tracking-wide">Check-ins</p>
          <p id="stat-count" class="text-2xl font-bold text-gray-900">0</p>
        </div>
        <div class="w-px h-10 bg-gray-200"></div>
        <div class="text-center">
          <p class="text-xs text-gray-500 uppercase tracking-wide">Revenue</p>
          <p id="stat-rev" class="text-2xl font-bold text-orange-500">0 ₫</p>
        </div>
      </div>
    </div>

    <!-- Date range selector + quick ranges + export -->
    <div class="flex flex-wrap items-center gap-2 mt-4 pt-4 border-t border-gray-100">
      <label class="text-sm font-medium text-gray-600">From:</label>
      <input
        id="view-from"
        type="date"
        class="border border-gray-300 rounded-lg px-3 py-1.5 text-sm
               focus:outline-none focus:ring-2 focus:ring-orange-400"
      />
      <label class="text-sm font-medium text-gray-600">To:</label>
      <input
        id="view-to"
        type="date"
        class="border border-gray-300 rounded-lg px-3 py-1.5 text-sm
               focus:outline-none focus:ring-2 focus:ring-orange-400"
      />
      <button onclick="refreshForRange()"
              class="px-3 py-1.5 bg-orange-500 hover:bg-orange-600 text-white
                     rounded-lg text-sm font-medium transition">
        Go
      </button>
      <div class="w-px h-6 bg-gray-200"></div>
      <button onclick="setQuick('today')"
              class="px-2.5 py-1.5 bg-gray-100 hover:bg-gray-200 text-gray-600
                     rounded-lg text-xs font-medium transition">
        Today
      </button>
      <button onclick="setQuick('week')"
              class="px-2.5 py-1.5 bg-gray-100 hover:bg-gray-200 text-gray-600
                     rounded-lg text-xs font-medium transition">
        This Week
      </button>
      <button onclick="setQuick('month')"
              class="px-2.5 py-1.5 bg-gray-100 hover:bg-gray-200 text-gray-600
                     rounded-lg text-xs font-medium transition">
        This Month
      </button>
      <button onclick="setQuick('prevmonth')"
              class="px-2.5 py-1.5 bg-gray-100 hover:bg-gray-200 text-gray-600
                     rounded-lg text-xs font-medium transition">
        Prev Month
      </button>
      <button onclick="exportCheckins()"
              class="sm:ml-auto inline-flex items-center gap-1.5 text-sm text-gray-600 hover:text-gray-800
                     bg-gray-50 hover:bg-gray-100 border border-gray-200 px-3 py-1.5 rounded-lg transition">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
            d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4"/>
        </svg>
        Export CSV
      </button>
    </div>

    <!-- Loading spinner -->
    <div id="checkin-loading" class="hidden py-16 flex flex-col items-center justify-center gap-3">
      <div class="w-10 h-10 border-4 border-orange-200 border-t-orange-500 rounded-full animate-spin"></div>
      <p class="text-sm text-gray-400">Loading check-ins…</p>
    </div>

    <div id="checkin-table-wrap" class="overflow-x-auto mt-5">
      <table id="checkin-table" class="w-full" style="width:100%">
        <thead>
          <tr>
            <th>Date</th>
            <th>Time</th>
            <th>Customer</th>
            <th>Type</th>
            <th>Payment</th>
            <th>Amount (VND)</th>
            <th>Add-ons</th>
            <th>Punch From</th>
            <th>PT Punch From</th>
            <th>Referral</th>
            <th>Notes</th>
            <th>Actions</th>
          </tr>
        </thead>
        <tbody></tbody>
      </table>
    </div>
  </div>

  <!-- Single source of truth for promo windows, shared with POST /api/checkins -->
  <script type="application/json" id="promotions-data" set:html={JSON.stringify(PROMOTIONS)}></script>
  <!-- Price list + discount rules, from src/lib/pricing.ts. The preview below
       quotes from these; the server bills from the same module, and its figure
       is what gets stored — the box is a quote, never the invoice. -->
  <script type="application/json" id="pricing-data" set:html={JSON.stringify(PRICING_DATA)}></script>

  <script is:inline>
    var checkinTable;
    var allCheckins  = [];
    var activeFrom   = '';
    var activeTo     = '';
    var allCustomers = [];  // cache with punch card info

    // The price list and discount rules, rendered from src/lib/pricing.ts. The
    // quote in the amount box is computed from these; the server bills from the
    // same module and its figure is the one that gets stored.
    var PRICING   = JSON.parse(document.getElementById('pricing-data').textContent || '{}');
    var DISCOUNTS = {};
    (PRICING.discounts || []).forEach(function (d) { DISCOUNTS[d.id] = d; });

    $(document).ready(function () {
      var now   = new Date();
      var today = now.toISOString().slice(0, 10);
      var timeNow = now.toTimeString().slice(0, 5);

      document.getElementById('view-from').value             = today;
      document.getElementById('view-to').value               = today;
      document.getElementById('table-date-label').textContent = formatDateLabel(today);
      document.getElementById('f-checkin-date').value         = today;
      document.getElementById('f-checkin-time').value         = timeNow;
      activeFrom = today;
      activeTo   = today;

      updateTsPreview();
      $('#f-checkin-date, #f-checkin-time').on('change', updateTsPreview);
      // The date decides whether a promotion is running, so re-price on change.
      $('#f-checkin-date').on('change', recalcAmount);
      recalcAmount();

      buildCustomerDatalist();
      initTable();
      loadCheckinsForRange(today, today);
    });

    function updateTsPreview() {
      var d = document.getElementById('f-checkin-date').value;
      var t = document.getElementById('f-checkin-time').value;
      var el = document.getElementById('ts-preview');
      if (el && d && t) {
        el.textContent = new Date(d + 'T' + t).toLocaleString('en-MY', {
          year: 'numeric', month: 'short', day: 'numeric',
          hour: '2-digit', minute: '2-digit'
        });
      }
    }

    function buildCustomerDatalist() {
      apiFetch('/api/customers')
        .then(function (res) { return res.json(); })
        .then(function (data) {
          var rows = data.rows || [];
          allCustomers = rows;
          if (rows.length) {
            document.getElementById('customer-hint').classList.add('hidden');
          }
          buildPunchCardDropdown(rows);
          buildPTPunchDropdown(rows);
        })
        .catch(function () { /* ignore errors */ });
    }

    function buildPunchCardDropdown(customers) {
      var select = document.getElementById('f-punch-from');
      var hint   = document.getElementById('punch-from-hint');
      // Keep placeholder, rebuild the rest
      select.innerHTML = '<option value="">— Select punch card holder —</option>';
      var holders = (customers || allCustomers).filter(function (c) {
        return c._is_punch_card_holder && c._punches_remaining > 0;
      });
      holders.forEach(function (c) {
        var opt = document.createElement('option');
        opt.value            = c._id;
        opt.dataset.holderName = c['Full Name'] || '';
        opt.textContent      = (c['Full Name'] || '') + ' (' + c._punches_remaining + ' punch' + (c._punches_remaining !== 1 ? 'es' : '') + ' left)';
        select.appendChild(opt);
      });
      hint.classList.toggle('hidden', holders.length > 0);
    }

    function buildPTPunchDropdown(customers) {
      var select = document.getElementById('f-pt-punch-from');
      var hint   = document.getElementById('pt-punch-from-hint');
      select.innerHTML = '<option value="">— Select PT punch holder —</option>';
      var holders = (customers || allCustomers).filter(function (c) {
        return c._pt_punches_remaining > 0;
      });
      holders.forEach(function (c) {
        var opt = document.createElement('option');
        opt.value              = c._id;
        opt.dataset.holderName = c['Full Name'] || '';
        opt.textContent        = (c['Full Name'] || '') + ' (' + c._pt_punches_remaining + ' PT punch' + (c._pt_punches_remaining !== 1 ? 'es' : '') + ' left)';
        select.appendChild(opt);
      });
      hint.classList.toggle('hidden', holders.length > 0);
    }

    function loadCheckinsForRange(from, to) {
      var qs = (from === to)
        ? '?date=' + from
        : '?from=' + from + '&to=' + to;
      document.getElementById('checkin-loading').classList.remove('hidden');
      document.getElementById('checkin-table-wrap').classList.add('hidden');
      apiFetch('/api/checkins' + qs)
        .then(function (res) { return res.json(); })
        .then(function (data) {
          document.getElementById('checkin-loading').classList.add('hidden');
          document.getElementById('checkin-table-wrap').classList.remove('hidden');
          allCheckins = data.checkins || [];
          renderTable(allCheckins);
          updateStats(allCheckins);
        })
        .catch(function (err) {
          document.getElementById('checkin-loading').classList.add('hidden');
          document.getElementById('checkin-table-wrap').classList.remove('hidden');
          showToast('Failed to load check-ins: ' + err.message, 'error');
        });
    }

    function initTable() {
      checkinTable = $('#checkin-table').DataTable({
        data: [],
        columns: [
          { title: 'Date' },
          { title: 'Time' },
          { title: 'Customer' },
          { title: 'Type' },
          { title: 'Payment' },
          { title: 'Amount (VND)' },
          { title: 'Add-ons' },
          { title: 'Punch From' },
          { title: 'PT Punch From' },
          { title: 'Referral' },
          { title: 'Notes' },
          { title: 'Actions', orderable: false, searchable: false }
        ],
        dom: "<'flex flex-wrap items-center justify-between gap-3 mb-3'<'text-sm text-gray-500'i><'flex-1 text-right'f>>" +
             "t" +
             "<'flex flex-wrap items-center justify-between mt-3'<''><'flex gap-1'p>>",
        order: [[0, 'asc'], [1, 'asc']],
        pageLength: 20,
        language: { emptyTable: 'No check-ins for this period.' }
      });
    }

    function buildRows(checkins) {
      return checkins.map(function (c) {
        return [
          c.date || '',
          (c.time || '').slice(0, 5),
          escHtml(c.customer_name || ''),
          c.checkin_type
            ? '<span class="text-xs font-medium text-gray-700">' + escHtml(c.checkin_type) + '</span>'
            : '<span class="text-gray-300">—</span>',
          '<span class="inline-flex items-center px-2 py-0.5 rounded-full text-xs font-medium ' +
            payBadge(c.payment_method) + '">' + escHtml(c.payment_method) + '</span>',
          c.amount ? Math.round(parseFloat(c.amount)).toLocaleString('vi-VN') + ' ₫' : '—',
          c.addons
            ? '<span class="text-xs text-gray-600">' + escHtml(c.addons) + '</span>'
            : '<span class="text-gray-300">—</span>',
          c.punch_card_holder_name
            ? '<span class="text-xs text-purple-600 font-medium">' + escHtml(c.punch_card_holder_name) + '</span>'
            : '<span class="text-gray-300">—</span>',
          c.pt_punch_holder_name
            ? '<span class="text-xs text-indigo-600 font-medium">' + escHtml(c.pt_punch_holder_name) + '</span>'
            : '<span class="text-gray-300">—</span>',
          c.referral_code
            ? '<span class="font-mono text-xs font-semibold bg-purple-100 text-purple-700 px-1.5 py-0.5 rounded">' +
                escHtml(c.referral_code) + '</span>' +
              '<span class="block text-xs text-gray-500 mt-0.5">' +
                // No referrer recorded → the code was a gym-wide promo.
                escHtml(c.referred_by_name || 'Promo') +
                (c.referral_discount_pct ? ' · ' + c.referral_discount_pct + '% off' : '') + '</span>'
            : '<span class="text-gray-300">—</span>',
          escHtml(c.notes || ''),
          '<button onclick="deleteCheckin(\'' + c.id + '\')" ' +
            'class="inline-flex items-center gap-1 text-xs text-red-500 hover:text-red-700 ' +
            'hover:bg-red-50 px-2 py-1 rounded transition">' +
            '<svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">' +
            '<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" ' +
            'd="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"/>' +
            '</svg>Delete</button>'
        ];
      });
    }

    function renderTable(checkins) {
      checkinTable.clear();
      checkinTable.rows.add(buildRows(checkins));
      checkinTable.draw();
    }

    function updateStats(checkins) {
      var customerCheckins = checkins.filter(function (c) { return c.customer_name !== 'Other'; });
      document.getElementById('stat-count').textContent = customerCheckins.length;
      var rev = checkins.reduce(function (s, c) { return s + (parseFloat(c.amount) || 0); }, 0);
      document.getElementById('stat-rev').textContent = Math.round(rev).toLocaleString('vi-VN') + ' ₫';
    }

    function refreshForRange() {
      var from = document.getElementById('view-from').value;
      var to   = document.getElementById('view-to').value;
      if (!from || !to) return;
      if (to < from) {
        document.getElementById('view-to').value = from;
        to = from;
      }
      activeFrom = from;
      activeTo   = to;
      document.getElementById('table-date-label').textContent =
        from === to ? formatDateLabel(from) : (from + ' → ' + to);
      loadCheckinsForRange(from, to);
    }

    function setQuick(period) {
      var now   = new Date();
      var today = now.toISOString().slice(0, 10);
      var from, to;
      if (period === 'today') {
        from = to = today;
      } else if (period === 'week') {
        var day = now.getDay(); // 0=Sun
        var mon = new Date(now); mon.setDate(now.getDate() - ((day + 6) % 7));
        var sun = new Date(mon); sun.setDate(mon.getDate() + 6);
        from = mon.toISOString().slice(0, 10);
        to   = sun.toISOString().slice(0, 10);
      } else if (period === 'month') {
        from = today.slice(0, 7) + '-01';
        var lastDay = new Date(now.getFullYear(), now.getMonth() + 1, 0);
        to = lastDay.toISOString().slice(0, 10);
      } else if (period === 'prevmonth') {
        var pm = new Date(now.getFullYear(), now.getMonth() - 1, 1);
        from = pm.getFullYear() + '-' + String(pm.getMonth() + 1).padStart(2, '0') + '-01';
        var pmLast = new Date(pm.getFullYear(), pm.getMonth() + 1, 0);
        to = pmLast.toISOString().slice(0, 10);
      }
      document.getElementById('view-from').value = from;
      document.getElementById('view-to').value   = to;
      refreshForRange();
    }

    // ── Punch card: show/hide punch-from section on payment change ──
    document.getElementById('f-payment').addEventListener('change', function () {
      var isPunch   = this.value === 'Punch Card';
      var isPTPunch = this.value === 'PT Punch';
      document.getElementById('punch-from-row').classList.toggle('hidden', !isPunch);
      if (!isPunch) document.getElementById('f-punch-from').value = '';
      document.getElementById('pt-punch-from-row').classList.toggle('hidden', !isPTPunch);
      if (!isPTPunch) document.getElementById('f-pt-punch-from').value = '';
    });

    // ── Punch card: auto-select based on selected customer ───────────────────────
    function onCustomerSelected(name) {
      // Re-check any entered code — it may now be the customer's own.
      if (document.getElementById('f-referral-code').value.trim()) validateReferralCode();
      var customer = allCustomers.find(function (c) { return c['Full Name'] === name; });
      if (!customer) return;
      var checkinDate = document.getElementById('f-checkin-date').value || new Date().toISOString().slice(0, 10);
      // Membership takes priority
      if (customer._membership_type && customer._membership_end_date && customer._membership_end_date >= checkinDate) {
        document.getElementById('f-payment').value = 'Valid Membership';
        document.getElementById('punch-from-row').classList.add('hidden');
        document.getElementById('f-punch-from').value = '';
      } else if (customer._is_punch_card_holder && customer._punches_remaining > 0) {
        document.getElementById('f-payment').value = 'Punch Card';
        document.getElementById('punch-from-row').classList.remove('hidden');
        document.getElementById('f-punch-from').value = customer._id;
      }
    }

    // ── Customer picker: search-and-select combobox ───────────────────────────────
    (function () {
      var searchInput = document.getElementById('f-customer-search');
      var hiddenInput = document.getElementById('f-customer');
      var dropdown    = document.getElementById('f-customer-dropdown');
      var clearBtn    = document.getElementById('f-customer-clear');
      var otherRow    = document.getElementById('f-other-name-row');
      var activeIdx   = -1;

      function closeDropdown() {
        dropdown.classList.add('hidden');
        dropdown.innerHTML = '';
        activeIdx = -1;
      }

      function selectCustomer(name) {
        hiddenInput.value    = name;
        searchInput.value    = name === 'Other' ? 'Other (not in database)' : name;
        searchInput.readOnly = true;
        searchInput.classList.add('text-orange-300', 'border-orange-500/50');
        clearBtn.classList.remove('hidden');
        otherRow.classList.toggle('hidden', name !== 'Other');
        if (name === 'Other') document.getElementById('f-other-name').focus();
        closeDropdown();
        onCustomerSelected(name);
      }

      window.clearCustomerSelection = function () {
        hiddenInput.value    = '';
        searchInput.value    = '';
        searchInput.readOnly = false;
        searchInput.classList.remove('text-orange-300', 'border-orange-500/50');
        clearBtn.classList.add('hidden');
        otherRow.classList.add('hidden');
        document.getElementById('f-other-name').value        = '';
        document.getElementById('f-payment').value           = '';
        document.getElementById('punch-from-row').classList.add('hidden');
        document.getElementById('f-punch-from').value        = '';
        document.getElementById('pt-punch-from-row').classList.add('hidden');
        document.getElementById('f-pt-punch-from').value     = '';
        // Reset the referral entry along with the rest of the form
        document.getElementById('f-referral-code').value = '';
        document.getElementById('referral-code-row').classList.add('hidden');
        document.getElementById('referral-overlap').classList.add('hidden');
        _referral = null;
        _setReferralStatus('Ask the customer for the code shared with them.', 'muted');
        closeDropdown();
        searchInput.focus();
      };

      /**
       * Fold a name down to plain lowercase ASCII so what staff can type on the
       * desk keyboard matches what is stored: "Huyen" finds "Huy\u1ec1n".
       */
      function foldName(s) {
        return String(s || '')
          .normalize('NFD').replace(/[\u0300-\u036f]/g, '')
          .replace(/[\u0111\u0110]/g, 'd')
          .toLowerCase();
      }

      /**
       * Match each typed word independently, anywhere in the name, in any
       * order — staff recall the parts of a name, not the order it was entered
       * in. A single substring test would find "Nguyen Thu Huyen" from "thu
       * huyen" but not from "nguyen huyen"; this finds it from either.
       */
      function nameMatches(name, terms) {
        var hay = foldName(name);
        return terms.every(function (t) { return hay.indexOf(t) !== -1; });
      }

      function renderDropdown(q) {
        var terms    = foldName(q).split(/\s+/).filter(Boolean);
        var filtered = terms.length
          ? allCustomers.filter(function (c) { return nameMatches(c['Full Name'], terms); })
          : allCustomers.slice();

        // The list is capped at 25 below, so float the names that start with
        // what was typed to the top — otherwise an exact match can fall off
        // the end of a common surname's results.
        if (terms.length) {
          filtered.sort(function (a, b) {
            var aStarts = foldName(a['Full Name']).indexOf(terms[0]) === 0 ? 0 : 1;
            var bStarts = foldName(b['Full Name']).indexOf(terms[0]) === 0 ? 0 : 1;
            return aStarts - bStarts;
          });
        }

        dropdown.innerHTML = '';
        activeIdx = -1;

        filtered.slice(0, 25).forEach(function (c) {
          var li = document.createElement('li');
          li.className = 'px-3 py-2 text-sm text-gray-200 cursor-pointer hover:bg-gray-700 hover:text-orange-400 border-b border-gray-700/40 last:border-0 transition-colors';
          li.textContent = c['Full Name'] || '';
          li.addEventListener('mousedown', function (e) {
            e.preventDefault();
            selectCustomer(c['Full Name'] || '');
          });
          dropdown.appendChild(li);
        });

        // "Other" always at the bottom
        var otherLi = document.createElement('li');
        otherLi.className = 'px-3 py-2 text-sm text-gray-500 italic cursor-pointer hover:bg-gray-700 hover:text-orange-400 border-t border-gray-600 transition-colors';
        otherLi.textContent = 'Other (not in database)';
        otherLi.addEventListener('mousedown', function (e) {
          e.preventDefault();
          selectCustomer('Other');
        });
        dropdown.appendChild(otherLi);
        dropdown.classList.remove('hidden');
      }

      searchInput.addEventListener('focus', function () {
        if (hiddenInput.value) return; // already locked to a selection
        renderDropdown(searchInput.value.trim());
      });

      searchInput.addEventListener('input', function () {
        // Typing clears any prior lock
        hiddenInput.value    = '';
        searchInput.readOnly = false;
        searchInput.classList.remove('text-orange-300', 'border-orange-500/50');
        clearBtn.classList.add('hidden');
        otherRow.classList.add('hidden');
        renderDropdown(searchInput.value.trim());
      });

      searchInput.addEventListener('keydown', function (e) {
        var items = dropdown.querySelectorAll('li');
        if (!items.length) return;
        if (e.key === 'ArrowDown') {
          e.preventDefault();
          activeIdx = Math.min(activeIdx + 1, items.length - 1);
          items.forEach(function (li, i) {
            li.classList.toggle('bg-gray-700', i === activeIdx);
            li.classList.toggle('text-orange-400', i === activeIdx);
          });
          items[activeIdx].scrollIntoView({ block: 'nearest' });
        } else if (e.key === 'ArrowUp') {
          e.preventDefault();
          activeIdx = Math.max(activeIdx - 1, 0);
          items.forEach(function (li, i) {
            li.classList.toggle('bg-gray-700', i === activeIdx);
            li.classList.toggle('text-orange-400', i === activeIdx);
          });
          items[activeIdx].scrollIntoView({ block: 'nearest' });
        } else if (e.key === 'Enter' && activeIdx >= 0) {
          e.preventDefault();
          items[activeIdx].dispatchEvent(new MouseEvent('mousedown'));
        } else if (e.key === 'Escape') {
          closeDropdown();
        }
      });

      document.addEventListener('click', function (e) {
        if (!searchInput.contains(e.target) &&
            !dropdown.contains(e.target) &&
            !clearBtn.contains(e.target)) {
          closeDropdown();
        }
      });
    }());

    // ── Referral / promo code: look up owner (or promo) + discount % ──────────
    // _referral holds the last verified lookup; null while unverified/invalid.
    // kind === 'promo' means a gym-wide code with no owner.
    var _referral       = null;
    var _referralTimer  = null;

    function _setReferralStatus(msg, tone) {
      var el = document.getElementById('referral-status');
      el.textContent = msg;
      el.className = 'text-xs mt-1 ' +
        (tone === 'ok' ? 'text-green-400' : tone === 'error' ? 'text-red-400' : 'text-gray-500');
    }

    /** How a verified code describes itself in the status line. */
    function _referralWho(data) {
      if (data.kind === 'promo') return 'Promo' + (data.label ? ' · ' + data.label : '');
      return (data.owner_name || 'Referral') + (data.label ? ' · ' + data.label : '');
    }

    // ── Discount cross-check ──────────────────────────────────────────────────
    // The discount options are mutually exclusive radios, so nothing stacks.
    // What staff can still miss is picking a code when a fixed discount above
    // would have taken more off, so compare them and say so.
    // Listed from the same table as the radios themselves, so a discount added
    // to pricing.ts is compared here without a second edit.
    var FIXED_DISCOUNTS = (PRICING.discounts || []).map(function (d) {
      return { value: d.id, label: d.title + ' (' + d.hint + ')' };
    });

    function _fmtVnd(n) { return Number(n || 0).toLocaleString('en-US') + ' ₫'; }

    function checkDiscountOverlap() {
      var el = document.getElementById('referral-overlap');
      if (!_referral || !_basePrice()) { el.classList.add('hidden'); return; }

      var codeTotal = totalFor('referral');
      var best = null;
      FIXED_DISCOUNTS.forEach(function (d) {
        var v = totalFor(d.value);
        if (v < codeTotal && (!best || v < best.value)) best = { label: d.label, value: v };
      });

      if (!best) { el.classList.add('hidden'); return; }
      el.textContent = 'Heads-up: the ' + best.label + ' option takes more off — ' +
        _fmtVnd(best.value) + ' vs ' + _fmtVnd(codeTotal) + ' with this code. Only one discount applies.';
      el.classList.remove('hidden');
    }

    function validateReferralCode() {
      var code = document.getElementById('f-referral-code').value.trim().toUpperCase();
      _referral = null;
      if (!code) {
        _setReferralStatus('Ask the customer for the code shared with them.', 'muted');
        recalcAmount();
        return;
      }
      _setReferralStatus('Checking…', 'muted');
      var customer = document.getElementById('f-customer').value.trim();
      apiFetch('/api/referral?code=' + encodeURIComponent(code) +
               (customer ? '&customer=' + encodeURIComponent(customer) : ''))
        .then(function (res) { return res.json(); })
        .then(function (data) {
          // A newer keystroke may have changed the field while this was in flight.
          if (document.getElementById('f-referral-code').value.trim().toUpperCase() !== code) return;
          if (!data.valid) {
            _referral = null;
            _setReferralStatus(data.error || 'Referral or promo code not found.', 'error');
          } else {
            _referral = data;
            _setReferralStatus('✓ ' + _referralWho(data) + ' — ' + data.discount_pct + '% off' +
              (data.rental_discount_pct
                ? ' · ' + data.rental_discount_pct + '% off shoe & chalk rental'
                : ''), 'ok');
          }
          recalcAmount();
        })
        .catch(function () {
          _referral = null;
          _setReferralStatus('Could not verify the code. Try again.', 'error');
          recalcAmount();
        });
    }

    document.getElementById('f-referral-code').addEventListener('input', function () {
      this.value = this.value.toUpperCase();
      clearTimeout(_referralTimer);
      _referralTimer = setTimeout(validateReferralCode, 350);
    });

    // ── Automatic promotions ──────────────────────────────────────────────────
    // Rendered from src/lib/promotions.ts so this preview and the punch grant in
    // POST /api/checkins can never drift apart. Everything keys off the check-in
    // DATE FIELD, not the clock, so a backdated entry prices as of that day.
    var PROMOTIONS = JSON.parse(document.getElementById('promotions-data').textContent || '[]');

    function _checkinDate() {
      return document.getElementById('f-checkin-date').value || new Date().toISOString().slice(0, 10);
    }

    /** The promotion covering the date in the form, or null. ISO dates sort. */
    function _activePromo() {
      var d = _checkinDate();
      var list = PROMOTIONS || [];
      for (var i = 0; i < list.length; i++) {
        if (d >= list[i].starts_on && d <= list[i].ends_on) return list[i];
      }
      return null;
    }

    function _promoPct(type) {
      var p = _activePromo();
      return (p && type && p.base_discount_pct[type]) || 0;
    }

    function _promoBonus(type) {
      var p = _activePromo();
      return (p && type && p.bonus_punches[type]) || 0;
    }

    // ── Check-in type, add-ons & discount: auto-calculate amount ──
    function _basePrice() {
      var typeSelect  = document.getElementById('f-checkin-type');
      var selectedOpt = typeSelect.options[typeSelect.selectedIndex];
      return selectedOpt ? (parseInt(selectedOpt.dataset.price || '0') || 0) : 0;
    }

    /** Add-on subtotals, split so a code can discount gear rental on its own. */
    function _addonTotals() {
      var retail = 0, rental = 0;
      document.querySelectorAll('.addon-cb:checked').forEach(function (cb) {
        var price = parseInt(cb.dataset.price || '0') || 0;
        if (cb.dataset.rental === '1') rental += price; else retail += price;
      });
      return { retail: retail, rental: rental };
    }

    /** `n` less `pct`, mirroring lessPct() in src/lib/pricing.ts exactly. */
    function _lessPct(n, pct) {
      return pct ? Math.round((n * (100 - pct)) / 100) : n;
    }

    /**
     * What the visit costs under one discount option — a preview of what the
     * server will bill, computed from the same tables it uses. If the two ever
     * disagree the server's figure wins and is what lands on the row.
     */
    function totalFor(discountVal) {
      var base   = _basePrice();
      var addons = _addonTotals();
      var basePct = 0, rentalPct = 0, flat = 0;

      if (discountVal === 'referral') {
        // Only a verified code discounts anything. Retail add-ons are never
        // discounted; the rental add-ons are, when the code says so.
        basePct   = _referral ? (_referral.discount_pct || 0) : 0;
        rentalPct = _referral ? (_referral.rental_discount_pct || 0) : 0;
      } else if (DISCOUNTS[discountVal]) {
        basePct = DISCOUNTS[discountVal].pct;
        flat    = DISCOUNTS[discountVal].flat;
      } else {
        // Nothing hand-picked: an active promotion sets the price on its own.
        // Any discount above replaces it rather than stacking — one discount per
        // check-in, and a deliberate choice is the more specific signal.
        basePct = _promoPct(document.getElementById('f-checkin-type').value);
      }

      var subtotal = _lessPct(base, basePct) + addons.retail + _lessPct(addons.rental, rentalPct);
      return Math.max(0, subtotal - flat);
    }

    /**
     * Tell staff what the promotion just did to the price, so the amount is
     * never a number that appeared from nowhere.
     *
     * The awkward case is a hand-picked discount during a promo: it replaces
     * the promo instead of stacking, which can leave the customer paying MORE
     * than if the radio had been left alone. That gets a loud warning with
     * both figures rather than a silent overcharge.
     */
    function updatePromoBanner() {
      var el    = document.getElementById('promo-banner');
      var promo = _activePromo();
      var type  = document.getElementById('f-checkin-type').value;
      var pct   = _promoPct(type);
      var bonus = _promoBonus(type);

      if (!promo || (!pct && !bonus)) { el.classList.add('hidden'); return; }

      var discountRb   = document.querySelector('.discount-rb:checked');
      var manualPicked = !!(discountRb && discountRb.value);
      // Bonus punches are part of the card, not a price cut — they survive any
      // discount choice, so they are always worth stating.
      var parts = [];
      if (bonus) parts.push('+' + bonus + ' bonus punches');

      var tone = 'bg-amber-900/40 border border-amber-600 text-amber-200';
      if (!manualPicked) {
        if (pct) parts.push(pct + '% off — applied automatically');
      } else if (pct) {
        var promoTotal  = totalFor('');
        var manualTotal = totalFor(discountRb.value);
        if (promoTotal < manualTotal) {
          tone = 'bg-yellow-900/50 border border-yellow-500 text-yellow-200 font-medium';
          parts.push('the automatic ' + pct + '% would charge ' + _fmtVnd(promoTotal) +
            ' vs ' + _fmtVnd(manualTotal) + ' with the discount you picked. ' +
            'Clear the discount to use the promo.');
        } else {
          parts.push(pct + '% off not applied — the discount you picked takes over');
        }
      }

      el.className = 'text-xs rounded-lg px-3 py-2 mt-1.5 ' + tone;
      el.textContent = '🎁 ' + promo.label + ': ' + parts.join(' · ');
    }

    // The last figure the price list quoted. Anything else in the amount box is
    // staff overruling it, which the server only accepts when told so explicitly.
    var _autoAmount = 0;

    function _amountIsOverridden() {
      var raw = document.getElementById('f-amount').value.trim();
      if (raw === '') return false;
      return Math.round(parseFloat(raw) || 0) !== _autoAmount;
    }

    function updateAmountNote() {
      var note = document.getElementById('amount-note');
      if (!_amountIsOverridden()) { note.classList.add('hidden'); return; }
      note.textContent = 'Manual amount — the price list says ' + _fmtVnd(_autoAmount) +
        '. This will be recorded as an override.';
      note.classList.remove('hidden');
    }

    function recalcAmount() {
      var discountRb  = document.querySelector('.discount-rb:checked');
      var discountVal = discountRb ? discountRb.value : '';
      var total       = totalFor(discountVal);
      _autoAmount = total > 0 ? total : 0;
      document.getElementById('f-amount').value = total > 0 ? total : '';
      if (discountVal === 'referral') checkDiscountOverlap();
      else document.getElementById('referral-overlap').classList.add('hidden');
      updatePromoBanner();
      updateAmountNote();
    }
    document.getElementById('f-amount').addEventListener('input', updateAmountNote);
    document.getElementById('f-checkin-type').addEventListener('change', recalcAmount);
    document.querySelectorAll('.addon-cb').forEach(function (cb) {
      cb.addEventListener('change', recalcAmount);
    });

    // ── Tiered add-ons ─────────────────────────────────────────────────────
    // Chalk bags are hired per group, so one checkbox carries several rates and
    // a stepper picks between them. The rates come from pricing.ts rather than
    // a copy kept here, and stepping writes the chosen tier's product name and
    // price onto the checkbox — so the totals, the submitted add-on list and
    // the rental-discount lookup all read the same data attributes as any other
    // add-on, and the name that reaches the server is one it will accept.
    var ADDON_TIERS = {};
    (PRICING.addons || []).forEach(function (a) {
      if (!a.tier) return;
      var set = ADDON_TIERS[a.tier.of] || (ADDON_TIERS[a.tier.of] = { tiers: [], index: 0 });
      set.tiers.push(a);
    });

    /** Must produce the same stem as slug() in this page's frontmatter. */
    function tierSlug(v) {
      return String(v).toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, '');
    }

    function syncAddonTier(name) {
      var set  = ADDON_TIERS[name];
      var id   = tierSlug(name);
      var cb   = document.getElementById('addon-tier-' + id);
      var tier = set.tiers[set.index];
      cb.dataset.name  = tier.name;
      cb.dataset.price = String(tier.price);
      document.getElementById('tier-price-' + id).textContent = Number(tier.price).toLocaleString('en-US') + ' ₫';
      document.getElementById('tier-label-' + id).textContent = tier.tier.label;
      document.getElementById('tier-qty-'   + id).classList.toggle('hidden', !cb.checked);
      document.getElementById('tier-dec-'   + id).disabled = set.index === 0;
      document.getElementById('tier-inc-'   + id).disabled = set.index === set.tiers.length - 1;
      recalcAmount();
    }

    function stepAddonTier(name, delta) {
      var set  = ADDON_TIERS[name];
      var next = set.index + delta;
      if (next < 0 || next >= set.tiers.length) return;
      set.index = next;
      syncAddonTier(name);
    }

    /** Back to the cheapest tier, stepper hidden — on load and after each save. */
    function resetAddonTiers() {
      Object.keys(ADDON_TIERS).forEach(function (name) {
        ADDON_TIERS[name].index = 0;
        syncAddonTier(name);
      });
    }

    Object.keys(ADDON_TIERS).forEach(function (name) {
      var id = tierSlug(name);
      document.getElementById('addon-tier-' + id)
        .addEventListener('change', function () { syncAddonTier(name); });
      document.getElementById('tier-dec-' + id)
        .addEventListener('click', function () { stepAddonTier(name, -1); });
      document.getElementById('tier-inc-' + id)
        .addEventListener('click', function () { stepAddonTier(name, 1); });
    });
    resetAddonTiers();

    document.querySelectorAll('.discount-rb').forEach(function (rb) {
      rb.addEventListener('change', function () {
        var isReferral = this.value === 'referral';
        document.getElementById('referral-code-row').classList.toggle('hidden', !isReferral);
        if (isReferral) {
          document.getElementById('f-referral-code').focus();
        } else {
          document.getElementById('f-referral-code').value = '';
          _referral = null;
          _setReferralStatus('Ask the customer for the code shared with them.', 'muted');
          document.getElementById('referral-overlap').classList.add('hidden');
        }
        recalcAmount();
      });
    });

    function toggleAddons() {
      var body    = document.getElementById('addons-body');
      var chevron = document.getElementById('addons-chevron');
      var nowHidden = body.classList.toggle('hidden');
      chevron.classList.toggle('rotate-180', !nowHidden);
    }
    function toggleDiscount() {
      var body    = document.getElementById('discount-body');
      var chevron = document.getElementById('discount-chevron');
      var nowHidden = body.classList.toggle('hidden');
      chevron.classList.toggle('rotate-180', !nowHidden);
    }

    // ── Form submit ──
    document.getElementById('checkin-form').addEventListener('submit', function (e) {
      e.preventDefault();
      var errEl = document.getElementById('form-error');
      errEl.classList.add('hidden');

      var customerName  = document.getElementById('f-customer').value.trim();
      var otherName     = document.getElementById('f-other-name').value.trim();
      var payment        = document.getElementById('f-payment').value;
      var amount         = document.getElementById('f-amount').value;
      var notes          = document.getElementById('f-notes').value.trim();
      // When "Other" is chosen, prepend the noted name into notes for manual DB follow-up
      if (customerName === 'Other' && otherName) {
        notes = 'Unregistered: ' + otherName + (notes ? ' | ' + notes : '');
      }
      var checkinType    = document.getElementById('f-checkin-type').value;
      // Only the raw product names travel. The discount label, the rental cut and
      // the promo note are written by the server from the same figures it prices
      // with, so a stored row can never claim a discount it was not given.
      var addonsArr      = [];
      document.querySelectorAll('.addon-cb:checked').forEach(function (cb) { addonsArr.push(cb.dataset.name); });
      var discountRbSub  = document.querySelector('.discount-rb:checked');
      var discountValSub = discountRbSub ? discountRbSub.value : '';

      // Referral / promo discount requires a code that verified successfully
      var referralCode = '';
      if (discountValSub === 'referral') {
        if (!_referral) {
          errEl.textContent = 'Enter a valid referral or promo code, or choose a different discount.';
          errEl.classList.remove('hidden');
          document.getElementById('f-referral-code').focus();
          return;
        }
        referralCode = _referral.code;
      }
      var punchFromSel   = document.getElementById('f-punch-from');
      var punchHolderId  = '';
      var punchHolderName = '';
      if (payment === 'Punch Card') {
        punchHolderId = punchFromSel.value;
        if (!punchHolderId) {
          errEl.textContent = 'Please select a punch card holder.';
          errEl.classList.remove('hidden'); return;
        }
        var selectedOpt = punchFromSel.options[punchFromSel.selectedIndex];
        punchHolderName = (selectedOpt && selectedOpt.dataset.holderName) || selectedOpt.textContent.split(' (')[0];
      }

      var ptPunchFromSel   = document.getElementById('f-pt-punch-from');
      var ptPunchHolderId  = '';
      var ptPunchHolderName = '';
      if (payment === 'PT Punch') {
        ptPunchHolderId = ptPunchFromSel.value;
        if (!ptPunchHolderId) {
          errEl.textContent = 'Please select a PT punch holder.';
          errEl.classList.remove('hidden'); return;
        }
        var selectedPTOpt = ptPunchFromSel.options[ptPunchFromSel.selectedIndex];
        ptPunchHolderName = (selectedPTOpt && selectedPTOpt.dataset.holderName) || selectedPTOpt.textContent.split(' (')[0];
      }

      if (!customerName) {
        errEl.textContent = 'Please select a customer from the dropdown.';
        errEl.classList.remove('hidden');
        document.getElementById('f-customer-search').focus();
        return;
      }
      if (!payment) {
        errEl.textContent = 'Please select a payment method.';
        errEl.classList.remove('hidden'); return;
      }

      var amountOverridden = _amountIsOverridden();

      var now     = new Date();
      var dateStr = document.getElementById('f-checkin-date').value || now.toISOString().slice(0, 10);
      var timeStr = document.getElementById('f-checkin-time').value || now.toTimeString().slice(0, 5);

      var btn = e.target.querySelector('[type="submit"]');
      btn.disabled = true;

      apiFetch('/api/checkins', {
        method: 'POST',
        body: JSON.stringify({
          customer_name:        customerName,
          date:                 dateStr,
          time:                 timeStr,
          payment_method:       payment,
          // The server prices the visit; `amount` is only read when staff have
          // deliberately typed over the quote, and is recorded as an override.
          amount:               amountOverridden ? Math.round(parseFloat(amount) || 0) : undefined,
          amount_override:      amountOverridden || undefined,
          notes:                notes,
          checkin_type:         checkinType,
          addons:               addonsArr,
          discount:             discountValSub,
          referral_code:        referralCode,
          punch_card_holder_id:   punchHolderId   || undefined,
          punch_card_holder_name: punchHolderName || undefined,
          pt_punch_holder_id:     ptPunchHolderId   || undefined,
          pt_punch_holder_name:   ptPunchHolderName || undefined,
        })
      })
        .then(function (res) { return res.json(); })
        .then(function (data) {
          btn.disabled = false;
          if (data.error) { errEl.textContent = data.error; errEl.classList.remove('hidden'); return; }
          // Switch viewing date to the submitted date so the new entry is visible
          activeFrom = dateStr;
          activeTo   = dateStr;
          document.getElementById('view-from').value = dateStr;
          document.getElementById('view-to').value   = dateStr;
          document.getElementById('table-date-label').textContent = formatDateLabel(dateStr);
          loadCheckinsForRange(dateStr, dateStr);
          // Refresh punch card dropdown counts if a punch was used
          if (punchHolderId || ptPunchHolderId) buildCustomerDatalist();
          clearCustomerSelection();
          document.getElementById('f-checkin-type').value = '';
          document.querySelectorAll('.addon-cb').forEach(function (cb) { cb.checked = false; });
          resetAddonTiers();
          var noDiscRb = document.querySelector('.discount-rb[value=""]');
          if (noDiscRb) noDiscRb.checked = true;
          document.getElementById('f-amount').value     = '';
          document.getElementById('amount-note').classList.add('hidden');
          _autoAmount = 0;
          document.getElementById('f-notes').value      = '';
          // Reset date+time to now for next entry
          var n = new Date();
          document.getElementById('f-checkin-date').value = n.toISOString().slice(0, 10);
          document.getElementById('f-checkin-time').value = n.toTimeString().slice(0, 5);
          updateTsPreview();
          updatePromoBanner();
          // Quote the server's figure, not the box's — they are the same in the
          // ordinary case, and when they are not it is the server's that was banked.
          var charged = data.price ? data.price.charged : null;
          showToast('✓ Check-in recorded for ' + customerName +
            (charged !== null && charged > 0 ? ' — ' + _fmtVnd(charged) : '') + '!');
        })
        .catch(function (err) {
          btn.disabled = false;
          errEl.textContent = 'Save failed: ' + err.message;
          errEl.classList.remove('hidden');
        });
    });

    function deleteCheckin(id) {
      if (!confirm('Delete this check-in record?')) return;
      apiFetch('/api/checkins/' + id, { method: 'DELETE' })
        .then(function (res) { return res.json(); })
        .then(function (data) {
          if (data.error) { showToast('Delete failed: ' + data.error, 'error'); return; }
          loadCheckinsForRange(activeFrom, activeTo);
          buildCustomerDatalist();
          showToast('Check-in deleted.', 'warning');
        })
        .catch(function (err) { showToast('Delete failed: ' + err.message, 'error'); });
    }

    function exportCheckins() {
      if (!allCheckins.length) { showToast('No check-ins to export for this period.', 'warning'); return; }
      var label = activeFrom === activeTo ? activeFrom : (activeFrom + '_to_' + activeTo);
      var headers = ['Date', 'Time', 'Customer Name', 'Check-in Type', 'Payment Method', 'Amount', 'Add-ons',
                     'Punch From', 'PT Punch From', 'Referral Code', 'Referred By', 'Referral Discount %', 'Notes'];
      var csvContent = [headers].concat(allCheckins.map(function (c) {
        return [c.date, (c.time || '').slice(0, 5), c.customer_name, c.checkin_type || '',
                c.payment_method, Math.round(c.amount || 0), c.addons || '',
                c.punch_card_holder_name || '', c.pt_punch_holder_name || '',
                c.referral_code || '', c.referral_code ? (c.referred_by_name || 'Promo') : '',
                c.referral_code ? (c.referral_discount_pct || 0) : '', c.notes || ''];
      })).map(function (row) {
        return row.map(function (v) { return '"' + String(v).replace(/"/g, '""') + '"'; }).join(',');
      }).join('\n');

      var blob = new Blob([csvContent], { type: 'text/csv;charset=utf-8;' });
      var url  = URL.createObjectURL(blob);
      var a    = document.createElement('a');
      a.href   = url; a.download = 'checkins-' + label + '.csv'; a.click();
      URL.revokeObjectURL(url);
    }

    function formatDateLabel(dateStr) {
      return new Date(dateStr + 'T00:00:00').toLocaleDateString('en-MY', {
        weekday: 'short', year: 'numeric', month: 'short', day: 'numeric'
      });
    }

    function payBadge(pm) {
      return { 'Cash': 'bg-green-100 text-green-700', 'Local Card': 'bg-blue-100 text-blue-700',
               'International Card': 'bg-cyan-100 text-cyan-700',
               'Local Bank Transfer': 'bg-indigo-100 text-indigo-700', 'Complimentary': 'bg-gray-100 text-gray-600',
               'Punch Card': 'bg-purple-100 text-purple-700', 'Valid Membership': 'bg-teal-100 text-teal-700' }[pm]
             || 'bg-orange-100 text-orange-700';
    }

    function escHtml(str) {
      return String(str || '').replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;');
    }

    function showToast(msg, type) {
      var t = document.createElement('div');
      t.textContent = msg;
      t.className = 'fixed bottom-6 right-6 z-50 px-4 py-2.5 rounded-lg text-sm font-medium shadow-lg ' +
        (type === 'warning' ? 'bg-yellow-500 text-white' : type === 'error' ? 'bg-red-500 text-white' : 'bg-green-500 text-white');
      document.body.appendChild(t);
      setTimeout(function () { t.remove(); }, 2500);
    }
  </script>
</MainLayout>
