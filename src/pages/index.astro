---
import Layout from '../layouts/Layout-landing-page.astro';

// Contact details shown in the Contact section.
const CONTACT_EMAIL = 'contact@bbo.fitness';
const CONTACT_PHONE = '+84 906 916 216';
const CONTACT_PHONE_HREF = 'tel:+84906916216';

// Resolved at build time, so the footer year advances on each deploy.
const currentYear = new Date().getFullYear();
---

<Layout title="Boulder Box Vietnam | Boutique Bouldering Gym in Saigon">
  <!-- Hero Section -->
  <section id="home" class="hero-section">
    <div class="hero-content">
      <div class="hero-text">
        <h1 class="hero-title">
          Our Gym.<br />Your Home Gym.
        </h1>
        <h2 class="hero-subtitle">
          <span>We pride ourselves on being a Boutique Bouldering Gym meticulously designed to offer the <strong>coziest, airconditioned and most unique climbing experience possible</strong>.</span>
          <br /><br />
          <span>Our space is thoughtfully maintained, guaranteeing cleanliness, creating a welcoming atmosphere where you can relax, recharge, and connect with fellow climbers after an intense session.</span>
        </h2>
        <div class="hero-buttons">
          <a
            href="https://maps.app.goo.gl/ExoLejDiePDpqMsx6"
            target="_blank"
            rel="noopener noreferrer"
            class="hero-button hero-button-primary"
          >
            Open Google Maps
          </a>
          <a
            href="https://www.instagram.com/boulderbox.saigon/"
            target="_blank"
            rel="noopener noreferrer"
            class="hero-button hero-button-secondary"
          >
            Our Instagram
          </a>
        </div>
      </div>
      <div class="hero-video">
        <video
          src="/assets/gym_video.mp4"
          autoplay
          preload="auto"
          muted
          playsinline
        ></video>
      </div>
    </div>
  </section>

  <!-- Pricing Section -->
  <section id="pricing" class="pricing-section">
    <div class="section-container">
      <h1 class="pricing-title">Pricing</h1>
      <div class="pricing-description-wrapper">
        <h2 class="pricing-subtitle">
          We believe climbing should be accessible. That's why we offer affordable pricing options designed to fit your budget.
        </h2>
        <h2 class="pricing-subtitle">
          Special Student Discount! We are proud to support the next generation of climbers! Vietnamese and international students (age 21 and below) are eligible for special discounts on our passes and memberships. Just bring your valid student ID!
        </h2>
      </div>

      <!-- Pricing Carousel -->
      <div class="pricing-carousel">
        <div class="pricing-carousel-container">
          <a href="/assets/pricing-01.avif" target="_blank" rel="noopener" class="pricing-item">
            <img
              src="/assets/pricing-01.avif"
              alt="Boulder Box Pricing 1"
              class="pricing-image"
            />
          </a>
          <a href="/assets/pricing-02.avif" target="_blank" rel="noopener" class="pricing-item">
            <img
              src="/assets/pricing-02.avif"
              alt="Boulder Box Pricing 2"
              class="pricing-image"
            />
          </a>
        </div>
        <div class="pricing-nav">
          <button class="pricing-nav-btn pricing-nav-prev" aria-label="Previous pricing">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <polyline points="15 18 9 12 15 6"></polyline>
            </svg>
          </button>
          <button class="pricing-nav-btn pricing-nav-next" aria-label="Next pricing">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <polyline points="9 18 15 12 9 6"></polyline>
            </svg>
          </button>
        </div>
      </div>
    </div>
  </section>

  <!-- About Section -->
  <section id="about" class="about-section">
    <div class="section-container">
      <h1 class="about-title">About</h1>
      <p class="about-description">
        Meet the Boulder Box Crew - fellow climbers committed to ensuring you have the best experience possible.<span class="about-description-secondary"><br /></span>
        <br />
        From offering beta advice to cheering you on as you tackle new challenges, we're here to support you 
        every step of the way. At Boulder Box, our passion for bouldering extends beyond the walls – it's in 
        everything we do.
      </p>

      <!-- Team Cards -->
      <div class="team-grid">
        <!-- Huyen Card -->
        <div class="team-card">
          <div class="team-card-image-wrapper">
            <img
              src="/assets/huyen-profile-photo.avif"
              alt="Huyen Alyvia"
              class="team-card-image"
            />
          </div>
          <div class="team-card-content">
            <h3 class="team-name">Huyen Alyvia</h3>
            <p class="team-role">Founder</p>
            <p class="team-description">
              Driven by a desire to create a space where she and her friends could practice their beloved 
              sport, she set out to establish a gym unlike any other in the city.
            </p>
          </div>
        </div>

        <!-- Shingo Card -->
        <div class="team-card">
          <div class="team-card-image-wrapper">
            <!-- TODO: replace with Shingo's photo -->
            <div class="team-card-image-placeholder" role="img" aria-label="Shingo">
              <span class="team-card-image-initial">S</span>
            </div>
          </div>
          <div class="team-card-content">
            <h3 class="team-name">Shingo</h3>
            <p class="team-role">Head Route-setter</p>
            <p class="team-description">
              Our Japanese head-setter brings over 20 years of climbing and more than 11 years of route
              setting to the walls, shaping problems that read beautifully and push every grade to move better.
            </p>
          </div>
        </div>

        <!-- Ha Card -->
        <div class="team-card">
          <div class="team-card-image-wrapper">
            <img
              src="/assets/ha-profile-photo.avif"
              alt="Duyen Ha"
              class="team-card-image"
            />
          </div>
          <div class="team-card-content">
            <h3 class="team-name">Duyen Ha</h3>
            <p class="team-role">General Manager</p>
            <p class="team-description">
              Beyond cleanliness, she goes the extra mile, preparing delightful snacks and refreshing 
              drinks for our guests. Ha makes everyone feel welcome and valued.
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Gallery Section -->
  <section id="gallery" class="gallery-section">
    <div class="section-container">
      <h2 class="section-title">Gallery</h2>
      <div class="gallery-grid">
        <a href="/assets/media/gym/bbo-image-01.avif" target="_blank" rel="noopener" class="gallery-item">
          <img
            src="/assets/media/gym/bbo-image-01.avif"
            alt="Boulder Box Gym"
            class="gallery-image"
          />
        </a>
        <a href="/assets/media/gym/bbo-image-02.webp" target="_blank" rel="noopener" class="gallery-item">
          <img
            src="/assets/media/gym/bbo-image-02.webp"
            alt="Boulder Box Gym"
            class="gallery-image"
          />
        </a>
        <a href="/assets/media/gym/bbo-image-10.webp" target="_blank" rel="noopener" class="gallery-item">
          <img
            src="/assets/media/gym/bbo-image-10.webp"
            alt="Boulder Box Gym"
            class="gallery-image"
          />
        </a>
        <a href="/assets/media/gym/bbo-image-11.avif" target="_blank" rel="noopener" class="gallery-item">
          <img
            src="/assets/media/gym/bbo-image-11.avif"
            alt="Boulder Box Gym"
            class="gallery-image"
          />
        </a>
        <a href="/assets/media/gym/bbo-image-12.webp" target="_blank" rel="noopener" class="gallery-item">
          <img
            src="/assets/media/gym/bbo-image-12.webp"
            alt="Boulder Box Gym"
            class="gallery-image"
          />
        </a>
        <a href="/assets/media/gym/bbo-image-13.avif" target="_blank" rel="noopener" class="gallery-item">
          <img
            src="/assets/media/gym/bbo-image-13.avif"
            alt="Boulder Box Gym"
            class="gallery-image"
          />
        </a>
        <a href="/assets/media/gym/gym-photo-01.avif" target="_blank" rel="noopener" class="gallery-item">
          <img
            src="/assets/media/gym/gym-photo-01.avif"
            alt="Boulder Box Gym"
            class="gallery-image"
          />
        </a>
        <a href="/assets/media/gym/gym-photo-02.avif" target="_blank" rel="noopener" class="gallery-item">
          <img
            src="/assets/media/gym/gym-photo-02.avif"
            alt="Boulder Box Gym"
            class="gallery-image"
          />
        </a>
        <a href="/assets/media/gym/gym-photo-03.avif" target="_blank" rel="noopener" class="gallery-item">
          <img
            src="/assets/media/gym/gym-photo-03.avif"
            alt="Boulder Box Gym"
            class="gallery-image"
          />
        </a>
        <a href="/assets/media/gym/gym-photo-04.avif" target="_blank" rel="noopener" class="gallery-item">
          <img
            src="/assets/media/gym/gym-photo-04.avif"
            alt="Boulder Box Gym"
            class="gallery-image"
          />
        </a>
        <a href="/assets/media/gym/gym-photo-05.avif" target="_blank" rel="noopener" class="gallery-item">
          <img
            src="/assets/media/gym/gym-photo-05.avif"
            alt="Boulder Box Gym"
            class="gallery-image"
          />
        </a>
      </div>
    </div>
  </section>

  <!-- Blog Section -->
  <section id="blog" class="blog-section">
    <div class="section-container">
      <h2 class="blog-title">Blog</h2>
      <p class="blog-subtitle">Latest insights and stories from the Boulder Box community</p>
      
      <div class="blog-grid">
        <!-- Featured: UNBOX 2026 Sponsors -->
        <div class="blog-post">
          <div class="blog-post-image">
            <img src="/assets/media/unbox-thumbnail-2026.png" alt="UNBOX 2026" class="blog-image" />
          </div>
          <div class="blog-post-content">
            <span class="blog-date">May 26, 2026</span>
            <h3 class="blog-post-title">Building the Future of Vietnamese Bouldering: Partner with Us for UNBOX 2026</h3>
            <p class="blog-post-excerpt">
              Learn about sponsorship packages and how to partner with us for UNBOX 2026.
            </p>
            <a href="/unbox-2026-sponsors" class="blog-read-more">Read More →</a>
          </div>
        </div>
        <!-- Blog Post 1 -->
        <div class="blog-post">
          <div class="blog-post-image">
            <img src="/assets/IG_thumbnail_tet_holiday.jpg" alt="V-Day & Tet" class="blog-image" />
          </div>
          <div class="blog-post-content">
            <span class="blog-date">Feb 2, 2026</span>
            <h3 class="blog-post-title">Happy V-Day and Lunar New Year!</h3>
            <p class="blog-post-excerpt">
              Updated Tet hours and Couple Climbing Minigame — join us for special dates and prizes!
            </p>
            <a href="/happy-vday-lunar-new-year-2026" class="blog-read-more">Read More →</a>
          </div>
        </div>

        <!-- Blog Post 2 -->
        <div class="blog-post">
          <div class="blog-post-image">
            <img src="/assets/boulder-box-update-2026.avif" alt="Updates 2026" class="blog-image" />
          </div>
          <div class="blog-post-content">
            <span class="blog-date">Dec 30, 2025</span>
            <h3 class="blog-post-title">2026 AT BOULDER BOX: NEW UPDATES & PERKS! 🧗‍♂️✨</h3>
            <p class="blog-post-excerpt">
              New year, same great vibes — price freeze, updated gear policy, and new discounts for 2026.
            </p>
            <a href="/updates-2026" class="blog-read-more">Read More →</a>
          </div>
        </div>

        <!-- Blog Post 3 -->
        <div class="blog-post">
          <div class="blog-post-image">
            <img src="/assets/boulder-box-rocktober-2025.avif" alt="Rocktober 2025" class="blog-image" />
          </div>
          <div class="blog-post-content">
            <span class="blog-date">Nov 4, 2025</span>
            <h3 class="blog-post-title">What an incredible finish to Rocktober 2025!</h3>
            <p class="blog-post-excerpt">
              A thrilling competition finish — congratulations to our climbers and thanks to sponsors and organisers!
            </p>
            <a href="/rocktober-2025" class="blog-read-more">Read More →</a>
          </div>
        </div>
      </div>
      <div style="text-align:center; margin-top:32px;">
        <a href="/blog" class="blog-list-read-more" style="font-size:1.1rem; font-weight:600; color:#fe5c13; text-decoration:none; padding:12px 32px; border-radius:8px; border:1px solid #fe5c13; display:inline-block; transition:background 0.2s;">View all blogs</a>
      </div>
    </div>
  </section>

  <!-- Contact Section -->
  <section id="contact" class="contact-section">
    <div class="section-container contact-container">
      <div class="contact-details-wrapper">
        <h2 class="contact-title">Chat to us.</h2>
        
        <p class="contact-intro">
          Questions about pricing, classes, or booking? Give us a call or drop us an email —
          we're happy to help.
        </p>

        <!-- Contact Details -->
        <div class="contact-methods">
          <a href={CONTACT_PHONE_HREF} class="contact-method">
            <span class="contact-method-icon" aria-hidden="true">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6A19.79 19.79 0 0 1 2.12 4.18 2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.13.96.36 1.9.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.9.34 1.85.57 2.81.7A2 2 0 0 1 22 16.92z"></path>
              </svg>
            </span>
            <span class="contact-method-text">
              <span class="contact-method-label">Call us</span>
              <span class="contact-method-value">{CONTACT_PHONE}</span>
            </span>
          </a>

          <a href={`mailto:${CONTACT_EMAIL}`} class="contact-method">
            <span class="contact-method-icon" aria-hidden="true">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <rect x="2" y="4" width="20" height="16" rx="2"></rect>
                <path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"></path>
              </svg>
            </span>
            <span class="contact-method-text">
              <span class="contact-method-label">Email us</span>
              <span class="contact-method-value">{CONTACT_EMAIL}</span>
            </span>
          </a>
        </div>
      </div>

      <!-- Contact Info -->
      <div class="contact-info-wrapper">
        <h3 class="contact-info-title">Find us</h3>
        
        <div class="map-preview" aria-hidden="false">
          <div class="map-preview-inner">
            <div class="place-name">Boulder Box Saigon</div>
            <div class="place-address">96/114, Đ. Đặng Thuỳ Trâm, Phường 13, Bình Thạnh, TP. HCM</div>
            <div class="review-box">
              <div aria-hidden="true" class="review-number">5.0</div>
              <div aria-label="Rated 5.0 out of 5" role="img" class="rating-stars">
                <span class="rating-star" aria-hidden="true">
                  <svg viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg" aria-hidden="true"><path d="M12 .587l3.668 7.431L23.6 9.748l-5.7 5.556L19.335 24 12 19.897 4.665 24l1.435-8.696L.4 9.748l7.932-1.73L12 .587z"/></svg>
                </span>
                <span class="rating-star" aria-hidden="true">
                  <svg viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg" aria-hidden="true"><path d="M12 .587l3.668 7.431L23.6 9.748l-5.7 5.556L19.335 24 12 19.897 4.665 24l1.435-8.696L.4 9.748l7.932-1.73L12 .587z"/></svg>
                </span>
                <span class="rating-star" aria-hidden="true">
                  <svg viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg" aria-hidden="true"><path d="M12 .587l3.668 7.431L23.6 9.748l-5.7 5.556L19.335 24 12 19.897 4.665 24l1.435-8.696L.4 9.748l7.932-1.73L12 .587z"/></svg>
                </span>
                <span class="rating-star" aria-hidden="true">
                  <svg viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg" aria-hidden="true"><path d="M12 .587l3.668 7.431L23.6 9.748l-5.7 5.556L19.335 24 12 19.897 4.665 24l1.435-8.696L.4 9.748l7.932-1.73L12 .587z"/></svg>
                </span>
                <span class="rating-star" aria-hidden="true">
                  <svg viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg" aria-hidden="true"><path d="M12 .587l3.668 7.431L23.6 9.748l-5.7 5.556L19.335 24 12 19.897 4.665 24l1.435-8.696L.4 9.748l7.932-1.73L12 .587z"/></svg>
                </span>
              </div>
              <a aria-label="95 reviews" target="_blank" href="https://search.google.com/local/reviews?placeid=ChIJQ2zrMVMldTER5b39KGBsbzA&amp;q=Boulder+Box+Saigon,+Dang+Thuy+Tram,+Vietnam&amp;hl=en&amp;gl=VN" class="review-box-link">95 reviews</a>
            </div>
          </div>
        </div>
        
        <div>
          <p class="info-label"><strong>Hours:</strong></p>
          <p class="info-text">Mon - Sun: 10:30 AM - 10:00 PM</p>
        </div>
        
        <a
          href="https://maps.app.goo.gl/ExoLejDiePDpqMsx6"
          target="_blank"
          rel="noopener noreferrer"
          class="contact-cta-button"
        >
          Open in Maps
        </a>
      </div>
    </div>
  </section>

  <!-- Google Maps Section (iframe removed) -->
  <!-- iframe removed per request; map-preview moved into Contact info -->

  <!-- Footer -->
  <footer class="footer">
    <div class="section-container">
      <div class="footer-content">
        <p class="footer-text">
          ©{currentYear} by Boulder Box & Office. All rights reserved.
        </p>
        <p class="footer-text">
          Designed by <a href="https://zippyzack.com" target="_blank" rel="noopener">zippyzack.com</a>
        </p>
      </div>
    </div>
  </footer>
</Layout>

<style>
  /* Container */
  .section-container {
    width: 100%;
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 1.5rem;
  }

  /* Hero Section */
  .hero-section {
    background-color: #fafafa;
    color: #333;
    padding: 2.5rem 0;
    width: 100%;
  }

  .hero-title {
    font-size: 2.5rem;
    font-weight: 700;
    line-height: 1.2;
    letter-spacing: -1px;
    margin-bottom: 1.5rem;
  }

  .hero-description {
    font-size: 1.125rem;
    color: #d1d5db;
    margin-bottom: 2rem;
    line-height: 1.8;
    max-width: 600px;
  }

  /* Pricing Section */
  .pricing-section {
    background-color: #262626;
    color: #fff;
    padding: 2.5rem 0;
    width: 100%;
  }

  .pricing-description {
    font-size: 1rem;
    color: #d1d5db;
    line-height: 1.8;
    margin-bottom: 1.5rem;
    max-width: 700px;
  }

  .pricing-carousel {
    position: relative;
    margin-top: 2rem;
  }

  .pricing-carousel-container {
    display: flex;
    gap: 16px;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    padding-bottom: 1rem;
    scroll-behavior: smooth;
  }

  .pricing-carousel-container::-webkit-scrollbar {
    height: 0;
  }

  .pricing-carousel-container::-webkit-scrollbar-track {
    display: none;
  }

  .pricing-item {
    flex-shrink: 0;
    width: 100%;
    scroll-snap-align: center;
    border-radius: 0.75rem;
    overflow: hidden;
    transition: opacity 0.3s ease;
    display: block;
  }

  .pricing-item:hover {
    opacity: 0.9;
  }

  .pricing-image {
    width: 100%;
    height: auto;
    display: block;
  }

  .pricing-nav {
    display: flex;
    justify-content: space-between;
    align-items: center;
    position: absolute;
    inset: 0;
    padding: 1.25rem;
    pointer-events: auto;
  }

  .pricing-nav-btn {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 40px;
    height: 40px;
    border-radius: 50%;
    background-color: rgba(0, 0, 0, 0.2);
    border: none;
    color: #fff;
    cursor: pointer;
    pointer-events: auto;
    transition: background-color 0.2s ease;
  }

  .pricing-nav-btn:hover {
    background-color: rgba(0, 0, 0, 0.4);
  }

  .pricing-nav-btn svg {
    width: 24px;
    height: 24px;
  }

  /* About Section */
  .about-section {
    background-color: #1a1a1a;
    color: #fff;
    padding: 2.5rem 0;
    width: 100%;
  }

  .section-title {
    font-size: 2rem;
    font-weight: 700;
    margin-bottom: 1.5rem;
    letter-spacing: -1px;
  }

  .section-description {
    font-size: 1rem;
    color: #d1d5db;
    line-height: 1.8;
    margin-bottom: 2.5rem;
    max-width: 700px;
  }

  .team-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2rem;
    margin-top: 2rem;
  }

  .team-card {
    background-color: #fff;
    border-radius: 1.5rem;
    overflow: hidden;
    box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1);
    transition: box-shadow 0.3s ease;
  }

  .team-card:hover {
    box-shadow: 0 10px 15px rgba(0, 0, 0, 0.2);
  }

  .team-card-image {
    width: 100%;
    height: 250px;
    object-fit: cover;
    display: block;
  }

  .team-card-image-placeholder {
    width: 100%;
    height: 250px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: linear-gradient(135deg, #d1d5db 0%, #9ca3af 100%);
  }

  .team-card-image-initial {
    font-size: 4rem;
    font-weight: 700;
    color: rgba(255, 255, 255, 0.85);
    line-height: 1;
  }

  .team-card-content {
    padding: 1.5rem;
    text-align: center;
    color: #1f2937;
  }

  .team-name {
    font-size: 1.5rem;
    font-weight: 700;
    margin-bottom: 0.5rem;
  }

  .team-role {
    color: #ff5a16;
    font-weight: 600;
    margin-bottom: 1rem;
    font-size: 0.95rem;
  }

  .team-description {
    color: #666;
    font-size: 0.95rem;
    line-height: 1.6;
  }

  /* Gallery Section */
  .gallery-section {
    background-color: #1a1a1a;
    color: #fff;
    padding: 2.5rem 0;
    width: 100%;
  }

  .gallery-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.5rem;
    margin-top: 2rem;
  }

  .gallery-item {
    border-radius: 0.75rem;
    overflow: hidden;
