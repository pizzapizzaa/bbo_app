---
// Public leaderboard page — no auth required.
// Add ?board to the URL for the TV display (no logging, auto-refresh, auto-scroll).
export const prerender = false;

// Staff roster for the sign-off dropdown. Rendered server-side so no public
// endpoint is needed and Astro escapes the names for us.
import { STAFF_NAMES } from '../lib/staff';
import WallDecor from '../components/leaderboard/WallDecor.astro';
import ClimberDyno from '../components/leaderboard/ClimberDyno.astro';
import SendModal from '../components/leaderboard/SendModal.astro';
import '../styles/leaderboard.css';

const LIGHTS = [14, 38, 62, 86];   // track light positions, % across the ceiling
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Leaderboard 2026 · Boulder Box</title>
  <meta name="description" content="Boulder Box 2026 season leaderboard — log your sends, get them signed, climb the board." />
  <meta name="theme-color" content="#141518" />
  <link rel="icon" type="image/png" href="/assets/Favicon.png" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Barlow+Condensed:wght@600;700;800&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet" />
  <!-- Set before first paint so the TV never flashes the phone layout -->
  <script is:inline>
    if (new URLSearchParams(location.search).has('board')) document.documentElement.classList.add('board-mode');
  </script>
</head>

<body>
  <header class="ceiling">
    <a href="/" aria-label="Boulder Box home">
      <img class="ceiling__logo" src="/assets/bobo_logo_rectangle.png" alt="Boulder Box" width="1220" height="320" />
    </a>
    <span class="ceiling__status" id="board-status">Live</span>
    {LIGHTS.map(x => <span class="track-light" style={`left:${x}%`} aria-hidden="true"></span>)}
  </header>

  <div class="wall" id="wall">
    {LIGHTS.map(x => <span class="light-cone" style={`left:${x}%`} aria-hidden="true"></span>)}
    <WallDecor />

    <main class="page">
      <section class="hero" aria-labelledby="page-title">
        <div class="hero__copy">
          <p class="kicker"><span class="tape tape--dark">Boulder Box · Season 2026</span></p>
          <h1 class="title" id="page-title"><span class="tape">Leaderboard</span></h1>
          <p class="tagline">Send it. Log it. Get it signed.</p>

          <div class="cta-row">
            <button type="button" class="btn-send" id="log-send-btn">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M12 19V5M5 12l7-7 7 7" />
              </svg>
              Log a send
            </button>
            <button type="button" class="btn-chalk" id="refresh-btn">
              <svg viewBox="0 0 24 24" aria-hidden="true">
                <path d="M6 7h12l-1.2 12.2a2 2 0 0 1-2 1.8H9.2a2 2 0 0 1-2-1.8z" fill="#C0262D" />
                <path d="M5.5 5.5h13v2.2h-13z" fill="#1C1C1E" />
                <path d="M8.5 5.5c.6-1.8 2-2.6 3.5-2.6s2.9.8 3.5 2.6" fill="none" stroke="#fff" stroke-width="1.4" />
                <circle cx="10" cy="12" r="1" fill="#fff" opacity=".6" /><circle cx="13.5" cy="14.5" r=".8" fill="#fff" opacity=".5" />
              </svg>
              Refresh
            </button>
          </div>
          <p class="board-note" id="board-note" hidden>Couldn't refresh — showing the last results.</p>

          <div class="stats" aria-label="Season totals">
            <div class="stat"><span class="tape tape--yellow"><span class="stat__val" id="stat-climbers">—</span><span class="stat__lbl">Climbers</span></span></div>
            <div class="stat"><span class="tape tape--green"><span class="stat__val" id="stat-sends">—</span><span class="stat__lbl">Sends</span></span></div>
            <div class="stat"><span class="tape"><span class="stat__val" id="stat-pts">—</span><span class="stat__lbl">Points</span></span></div>
          </div>
        </div>

        <div class="hero__stage">
          <ClimberDyno />
        </div>
      </section>

      <section class="board" aria-label="Rankings">
        <div class="podium-area" id="podium-area" hidden>
          <h2 class="section-tag"><span class="tape tape--black">Top out</span></h2>
          <div class="podium" id="podium"></div>
        </div>

        <div class="route-area">
          <div class="board-state" id="board-state" aria-live="polite"></div>
          <div class="route-scroll" id="route-scroll">
            <ol class="route" id="route"></ol>
          </div>
        </div>
      </section>
    </main>

    <footer class="mat">
      Boulder Box · <a href="/">bbo.fitness</a> · Every send signed off by our staff
    </footer>
  </div>

  <SendModal staffNames={STAFF_NAMES} />

  <script>
    import { boardMode } from '../scripts/leaderboard/board';
    import '../scripts/leaderboard/send-modal';
    import { startClimber } from '../scripts/leaderboard/climber';
    import { initWallFx } from '../scripts/leaderboard/wall-fx';

    const stage = document.querySelector<HTMLElement>('[data-climber-stage]');
    // On the TV the dyno plays every 20 s instead of on a loop.
    if (stage) startClimber(stage, { every: boardMode ? 20 : undefined });
    initWallFx(document.getElementById('wall')!, { parallax: !boardMode });
  </script>
</body>
</html>
