---
// Public self-service page — no auth required, no MainLayout
export const prerender = false;
---

<!DOCTYPE html>
<html lang="en" class="h-full">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Check In — BBO Gym</title>
  <link rel="icon" type="image/png" href="/assets/Favicon.png" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
</head>

<body class="min-h-full bg-gray-950 text-white"
      style="font-family:'Inter',system-ui,sans-serif">

  <!-- Background blobs -->
  <div class="fixed inset-0 overflow-hidden pointer-events-none" aria-hidden="true">
    <div class="absolute -top-48 -right-32 w-96 h-96 bg-orange-500/10 rounded-full blur-3xl"></div>
    <div class="absolute -bottom-48 -left-32 w-96 h-96 bg-orange-500/8 rounded-full blur-3xl"></div>
  </div>

  <div class="relative flex flex-col min-h-screen px-4 py-8 max-w-md mx-auto">

    <!-- Header -->
    <div class="flex flex-col items-center mb-8">
      <img
        src="/assets/bobo_logo_rectangle.png"
        alt="BBO Gym"
        class="h-16 w-auto object-contain mb-3"
        onerror="this.style.display='none';document.getElementById('logo-text').style.display='block'"
      />
      <span id="logo-text" class="text-orange-500 text-4xl font-black mb-3" style="display:none">BBO</span>
      <p class="text-gray-400 text-sm">Welcome! Check in below.</p>
    </div>

      <div class="bg-gray-900/80 border border-gray-700/50 rounded-2xl p-6 shadow-xl">
        <h2 class="text-lg font-bold mb-1">Check In</h2>
        <p class="text-sm text-gray-400 mb-5">Enter your name in English characters only.</p>

        <form id="checkin-form" novalidate class="space-y-4">
          <div class="relative">
            <label for="ci-name" class="block text-sm font-medium text-gray-300 mb-1.5">
              Full Name <span class="text-red-400">*</span>
            </label>
            <input
              id="ci-name"
              type="text"
              placeholder="e.g. Nguyen Van A"
              autocomplete="off"
              autocapitalize="words"
              class="w-full bg-gray-800 border border-gray-600 rounded-xl px-4 py-3
                     text-white placeholder-gray-500 text-base
                     focus:outline-none focus:ring-2 focus:ring-orange-500 focus:border-transparent
                     transition"
            />
            <!-- Live name dropdown -->
            <ul
              id="ci-name-dropdown"
              class="hidden absolute z-50 left-0 right-0 mt-1 bg-gray-800 border border-gray-600
                     rounded-xl overflow-hidden shadow-2xl"
            ></ul>
            <p id="ci-name-hint" class="text-xs text-gray-500 mt-1.5">English characters only (a–z, spaces, hyphens).</p>
          </div>

          <!-- Error / success messages -->
          <div id="ci-error"
               class="hidden px-4 py-3 bg-red-500/10 border border-red-500/30 rounded-xl
                      text-red-400 text-sm"></div>
          <div id="ci-success"
               class="hidden px-4 py-3 bg-green-500/10 border border-green-500/30 rounded-xl
                      text-green-400 text-sm text-center"></div>

          <button
            type="submit"
            id="ci-submit"
            class="w-full py-3.5 bg-orange-500 hover:bg-orange-600 active:bg-orange-700
                   rounded-xl font-semibold text-base transition-all duration-150
                   disabled:opacity-50 disabled:cursor-not-allowed flex items-center justify-center gap-2"
          >
            <span id="ci-btn-text">Check In Now</span>
            <svg id="ci-spinner" class="hidden animate-spin w-5 h-5" fill="none" viewBox="0 0 24 24">
              <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"/>
              <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8v8z"/>
            </svg>
          </button>
        </form>
      </div>

    <!-- Footer -->
    <p class="text-center text-xs text-gray-600 mt-8">Need help? Ask a staff member.</p>
  </div>

  <script is:inline>
    // ── English-only name validator ──────────────────────────────────────────
    function isEnglishOnly(value) {
      return /^[A-Za-z0-9 '\-\.]+$/.test(value);
    }

    // ── Check-in name autocomplete ───────────────────────────────────────────
    (function () {
      const input    = document.getElementById('ci-name');
      const dropdown = document.getElementById('ci-name-dropdown');
      let debounceTimer = null;
      let activeIdx = -1;

      function closeDropdown() {
        dropdown.classList.add('hidden');
        dropdown.innerHTML = '';
        activeIdx = -1;
      }

      function selectName(name) {
        input.value = name;
        closeDropdown();
      }

      function highlightItem(idx) {
        const items = dropdown.querySelectorAll('li');
        items.forEach((li, i) => {
          li.classList.toggle('bg-gray-700', i === idx);
          li.classList.toggle('text-orange-400', i === idx);
        });
        activeIdx = idx;
      }

      input.addEventListener('input', function () {
        clearTimeout(debounceTimer);
        const q = input.value.trim();
        if (q.length < 2) { closeDropdown(); return; }
        debounceTimer = setTimeout(async function () {
          try {
            const res   = await fetch('/api/public/customers?q=' + encodeURIComponent(q));
            const data  = await res.json();
            const names = data.names || [];
            if (!names.length) { closeDropdown(); return; }
            dropdown.innerHTML = '';
            activeIdx = -1;
            names.forEach(function (name) {
              const li = document.createElement('li');
              li.textContent = name;
              li.className = 'px-4 py-3 text-sm text-gray-200 cursor-pointer hover:bg-gray-700 hover:text-orange-400 transition-colors border-b border-gray-700/50 last:border-0';
              li.addEventListener('mousedown', function (e) {
                e.preventDefault(); // keep focus on input
                selectName(name);
              });
              dropdown.appendChild(li);
            });
            dropdown.classList.remove('hidden');
          } catch { closeDropdown(); }
        }, 200);
      });

      // Keyboard navigation
      input.addEventListener('keydown', function (e) {
        const items = dropdown.querySelectorAll('li');
        if (!items.length) return;
        if (e.key === 'ArrowDown') {
          e.preventDefault();
          highlightItem(Math.min(activeIdx + 1, items.length - 1));
        } else if (e.key === 'ArrowUp') {
          e.preventDefault();
          highlightItem(Math.max(activeIdx - 1, 0));
        } else if (e.key === 'Enter' && activeIdx >= 0) {
          e.preventDefault();
          selectName(items[activeIdx].textContent);
        } else if (e.key === 'Escape') {
          closeDropdown();
        }
      });

      // Close on outside click
      document.addEventListener('click', function (e) {
        if (!input.contains(e.target) && !dropdown.contains(e.target)) {
          closeDropdown();
        }
      });
    }());

    // ── Check-in form ────────────────────────────────────────────────────────
    document.getElementById('checkin-form').addEventListener('submit', async function(e) {
      e.preventDefault();
      const name    = document.getElementById('ci-name').value.trim();
      const errBox  = document.getElementById('ci-error');
      const succBox = document.getElementById('ci-success');
      const btn     = document.getElementById('ci-submit');
      const spinner = document.getElementById('ci-spinner');
      const btnText = document.getElementById('ci-btn-text');

      errBox.classList.add('hidden');
      succBox.classList.add('hidden');

      if (!name) {
        errBox.textContent = 'Please enter your full name.';
        errBox.classList.remove('hidden');
        return;
      }
      if (!isEnglishOnly(name)) {
        errBox.textContent = 'Please use English characters only (a–z, spaces, hyphens).';
        errBox.classList.remove('hidden');
        return;
      }

      btn.disabled = true;
      spinner.classList.remove('hidden');
      btnText.textContent = 'Checking in…';

      try {
        // Send local date/time from the browser so the server records the correct
        // Vietnam date even when Vercel is running in a UTC data centre.
        const now      = new Date();
        const localDate = now.getFullYear() + '-' +
          String(now.getMonth() + 1).padStart(2, '0') + '-' +
          String(now.getDate()).padStart(2, '0');
        const localTime = String(now.getHours()).padStart(2, '0') + ':' +
          String(now.getMinutes()).padStart(2, '0') + ':' +
          String(now.getSeconds()).padStart(2, '0');

        const res  = await fetch('/api/public/checkin', {
          method:  'POST',
          headers: { 'Content-Type': 'application/json' },
          body:    JSON.stringify({ full_name: name, date: localDate, time: localTime }),
        });
        const data = await res.json();

        if (!res.ok) {
          errBox.textContent = data.error ?? 'Something went wrong. Please try again.';
          errBox.classList.remove('hidden');
        } else {
          succBox.innerHTML =
            `<span class="text-2xl">🎉</span><br>` +
            `<strong class="text-base">Welcome, ${data.name}!</strong><br>` +
            `<span class="text-xs text-green-300/70">Check-in recorded successfully.</span>`;
          succBox.classList.remove('hidden');
          document.getElementById('ci-name').value = '';
        }
      } catch {
        errBox.textContent = 'Network error. Please check your connection and try again.';
        errBox.classList.remove('hidden');
      } finally {
        btn.disabled = false;
        spinner.classList.add('hidden');
        btnText.textContent = 'Check In Now';
      }
    });

  </script>

</body>
</html>
