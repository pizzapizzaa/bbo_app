---
// Public self-service page — no auth required, no MainLayout
export const prerender = false;
---

<!DOCTYPE html>
<html lang="en" class="h-full">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>New Account — BBO Gym</title>
  <link rel="icon" href="/assets/favicon.ico" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
</head>

<body class="min-h-full bg-gray-950 text-white"
      style="font-family:'Inter',system-ui,sans-serif">

  <!-- Background blobs -->
  <div class="fixed inset-0 overflow-hidden pointer-events-none" aria-hidden="true">
    <div class="absolute -top-48 -right-32 w-96 h-96 bg-orange-500/10 rounded-full blur-3xl"></div>
    <div class="absolute -bottom-48 -left-32 w-96 h-96 bg-orange-500/8 rounded-full blur-3xl"></div>
  </div>

  <div class="relative flex flex-col min-h-screen px-4 py-8 max-w-md mx-auto">

    <!-- Header -->
    <div class="flex flex-col items-center mb-8">
      <img
        src="/assets/bobo_logo_rectangle.png"
        alt="BBO Gym"
        class="h-16 w-auto object-contain mb-3"
        onerror="this.style.display='none';document.getElementById('logo-text').style.display='block'"
      />
      <span id="logo-text" class="text-orange-500 text-4xl font-black mb-3" style="display:none">BBO</span>
      <p class="text-gray-400 text-sm">Create your account to get started.</p>
    </div>

    <!-- Register panel -->
    <div class="bg-gray-900/80 border border-gray-700/50 rounded-2xl p-6 shadow-xl">
      <h2 class="text-lg font-bold mb-1">Register New Account</h2>
      <p class="text-sm text-gray-400 mb-5">Fill in your details below. Fields marked <span class="text-red-400">*</span> are required.</p>

      <form id="register-form" novalidate class="space-y-4">

        <!-- Full Name -->
        <div>
          <label for="reg-name" class="block text-sm font-medium text-gray-300 mb-1.5">
            Full Name <span class="text-red-400">*</span>
          </label>
          <input
            id="reg-name"
            type="text"
            placeholder="e.g. Nguyen Van A"
            autocomplete="name"
            autocapitalize="words"
            class="w-full bg-gray-800 border border-gray-600 rounded-xl px-4 py-3
                   text-white placeholder-gray-500 text-sm
                   focus:outline-none focus:ring-2 focus:ring-orange-500 focus:border-transparent transition"
          />
          <p class="text-xs text-gray-500 mt-1.5">English characters only (a–z, spaces, hyphens).</p>
        </div>

        <!-- Date of Birth -->
        <div>
          <label for="reg-dob" class="block text-sm font-medium text-gray-300 mb-1.5">
            Date of Birth
          </label>
          <input
            id="reg-dob"
            type="date"
            class="w-full bg-gray-800 border border-gray-600 rounded-xl px-4 py-3
                   text-white text-sm
                   focus:outline-none focus:ring-2 focus:ring-orange-500 focus:border-transparent transition
                   [color-scheme:dark]"
          />
        </div>

        <!-- Email -->
        <div>
          <label for="reg-email" class="block text-sm font-medium text-gray-300 mb-1.5">
            Email
          </label>
          <input
            id="reg-email"
            type="email"
            placeholder="you@example.com"
            autocomplete="email"
            inputmode="email"
            class="w-full bg-gray-800 border border-gray-600 rounded-xl px-4 py-3
                   text-white placeholder-gray-500 text-sm
                   focus:outline-none focus:ring-2 focus:ring-orange-500 focus:border-transparent transition"
          />
        </div>

        <!-- Telephone -->
        <div>
          <label for="reg-tel" class="block text-sm font-medium text-gray-300 mb-1.5">
            Telephone
          </label>
          <input
            id="reg-tel"
            type="tel"
            placeholder="e.g. 0901234567"
            autocomplete="tel"
            inputmode="tel"
            class="w-full bg-gray-800 border border-gray-600 rounded-xl px-4 py-3
                   text-white placeholder-gray-500 text-sm
                   focus:outline-none focus:ring-2 focus:ring-orange-500 focus:border-transparent transition"
          />
        </div>

        <!-- Emergency Contact -->
        <div>
          <label for="reg-emergency" class="block text-sm font-medium text-gray-300 mb-1.5">
            Emergency Contact
          </label>
          <input
            id="reg-emergency"
            type="text"
            placeholder="Name and phone number"
            class="w-full bg-gray-800 border border-gray-600 rounded-xl px-4 py-3
                   text-white placeholder-gray-500 text-sm
                   focus:outline-none focus:ring-2 focus:ring-orange-500 focus:border-transparent transition"
          />
        </div>

        <!-- Note -->
        <div>
          <label for="reg-note" class="block text-sm font-medium text-gray-300 mb-1.5">
            Additional Note
          </label>
          <textarea
            id="reg-note"
            rows="2"
            placeholder="Anything staff should know (injuries, preferences…)"
            class="w-full bg-gray-800 border border-gray-600 rounded-xl px-4 py-3
                   text-white placeholder-gray-500 text-sm resize-none
                   focus:outline-none focus:ring-2 focus:ring-orange-500 focus:border-transparent transition"
          ></textarea>
        </div>

        <!-- ── Waiver Agreement ── -->
        <div class="rounded-xl border border-gray-700 overflow-hidden">
          <a
            href="https://docs.google.com/document/d/1ZPl1KfUmoXwD5YSNu4D4Fa4A1tQiFZqOdzIgwVE6z3w/edit?tab=t.0"
            target="_blank"
            rel="noopener noreferrer"
            class="w-full flex items-center justify-between px-4 py-3
                   bg-gray-800 hover:bg-gray-750 transition text-sm font-medium text-gray-200"
          >
            <span>Waiver Agreement</span>
            <svg class="w-4 h-4 text-gray-400" fill="none" stroke="currentColor" stroke-width="2"
                 viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"/>
            </svg>
          </a>

          <!-- Waiver text body removed — full waiver opens in Google Docs -->
          <div id="waiver-body" class="hidden">
            <!-- ╔════════════════════════════════════════╗ -->
            <!-- ║  PASTE YOUR WAIVER TEXT BELOW          ║ -->
            <!-- ╚════════════════════════════════════════╝ -->
            <p class="text-gray-300 font-semibold mb-2">BBO Gym — Liability Waiver & Health Declaration</p>
            <p class="mb-2">
               Tiếng Việt bên dưới cùng.
              Please pay special attention to this section:
• Shoes must be worn while climbing the wall. No bare-foot climbing.
• Climbers must verify that proper padding is safely and correctly placed on the floor along the path of the desired route and will catch any kind of fall the climber may experience before getting on the wall.
• Climbers must not walk or step beneath another climber who is already on the wall. Clearance of at least 8ft is required. Only spotters are permitted to be closer to climbers on the wall.
• Before getting on the wall, climbers must verify that the desired route will not collide with another climber already on the wall. Climbers already on the wall have priority.
• The window and doorway along the "window wall", below the two incline sections, are always "off". This means you cannot place feet, grab, or otherwise use either the doorway or the window to aid in climbing. You must also avoid swinging arms, legs, or anything else through the doorway or window.• Only chalk intended to be used on your hands that's designed for climbing, gyms, and sports is permitted in the climbing gym. No colored chalk and no side-walk chalk. If you are unsure about your chalk, please ask a Boulder Box & Office staff member.
• A spotter is only permitted if both the spotter and climber have agreed to the spot.
• Spotters must remain focused on the climber and in constant and clear communication with the climber for the duration of the spot.
• Lessons in progress have priority on routes. If an instructor needs the route you are on, you may be asked to move to another route. Please finish the climb and allow the lesson to use the route.• A minimum of at least two people must be present in the gym at all times, and at least one person must remain off the wall at any given time in-case of an emergency.
• Climbers must immediately alert Boulder Box & Office staff of any dangerous activity, such as spinning or moving holds, wall damage, etc.
• All climbers will comply with the judgments of the Boulder Box & Office staff on duty.
• All climbers must be at least five (05) years old.
• Climbers under the age of sixteen (16) must have the waiver and release form signed by a parent or legal guardian. The climber must either read the rules or have the rules read to them by a parent/guardian.
• Any climbers under the age of (16) must be accompanied and supervised by an adult at all times.
• An adult may only accompany a maximum of 3 minors.
• All climbers must complete a liability waiver form at least once per calendar year.
• Any infractions of the above rules may result in loss of privileges. Repeated infractions may result in loss of membership/access to the gym.

Please Note: The adult over the age of 18 years who is agreeing to this waiver is agreeing for themselves AND any minors for whom they are responsible.

WARNING: There are significant elements of risk in any adventure, sport or activity associated with a 'climbing gym', climbing wall, bouldering area, weight and fitness training regimens, and equipment, (hereinafter referred to as "the Activity"). Although we have taken reasonable steps to provide you with appropriate equipment and/or skilled instructors so you can enjoy an Activity for which you may not be skilled, we wish to remind you this Activity is not without risk. Certain risks cannot be eliminated without destroying the unique character of the Activity. The same elements that contribute to the unique character of the Activity can be causes of loss or damage to your equipment, or accidental injury, illness, or in extreme cases, permanent trauma or death. We do not want to frighten you or reduce your enthusiasm for this Activity, but we do think it is important for you to know in advance what to expect and to be informed of the inherent risks.

1. NOTICE: THIS IS A LEGALLY BINDING AGREEMENT: By signing this agreement, you give up your right to bring a court action to recover compensation or obtain any other remedy for any injury to yourself or your property or for your death however caused arising out of your use of the facilities of Boulder Box & Office, now or any time in the future. The adult over the age of 18 years who is agreeing to this waiver is agreeing for themselves AND any minors for whom they are responsible.

2. ACTIVITY AND ASSOCIATED RISKS: I have chosen to participate in the following activity: (hereinafter referred to as "the Activity"), the Activity is inherently hazardous, and I/we may be exposed to dangers and hazards. I acknowledge that the following describes some, but not all of the risks:
• Slips, trips, falls or painful crashes while using the facilities or equipment, climbing walls, bouldering areas, landing pads, floors and padding below climbing areas, bathroom facilities, or stairs;
• Risk associated with crossing, climbing, or down climbing;
• Misuse of equipment or facilities, or failure of equipment;
• My/our physical strength, coordination, sense of balance, and ability to follow or give directions while climbing, watching, or working out;
• Fatigue, chill and/or dizziness, which may diminish my/our reaction time and increase the risk of accident;• Abrasion from or entanglement with ropes or equipment; and
• The presence, actions or falls of other participants. I understand the description of these risks is not complete and that other unknown or unanticipated risks may result in injury, illness or death.
As a consequence of these risks, I/we may be seriously hurt or disabled or may die from the resulting injuries, and my/our property may also be damaged;use of the facilities and equipment provided by Boulder Box & Office has inherit risks; andBoulder Box & Office assumes no responsibility for providing medical care during the Activity or while using the facilities provided by Boulder Box & Office, and I/we will have to pay for any medical care and/or evacuation that I/we incur. In consideration of the permission to participate in the Activity, I agree to the terms contained in this document.

3. ASSUMPTION OF RISK AND RESPONSIBILITY: I hereby freely assume the above-mentioned risks as well as other risks not listed that are part of this activity and any harm, injury, or loss that may occur to me or my property as a result of my participation in the Activity or during use of the facilities provided by Boulder Box & Office—including any injury or loss caused by the negligence of Boulder Box & Office, its employees, agents and officers, its contractors, and other Activity participants.I also understand that any equipment that I provide or may borrow or rent from Boulder Box & Office or any other provider I use at my own risk and that any such equipment is provided without any warranty about its condition or suitability.

4. RELEASE OF LIABILITY: I hereby RELEASE Boulder Box & Office, its employees, agents, officers, and contractors, the providers of any equipment used in the Activity, land owners, municipal or governmental providers of use permits, and their respective employees, officers, and directors ("the Released Parties") FROM ALL LIABILITIES, CAUSES OF ACTION, CLAIMS, AND DEMANDS that arise in any way from any injury, death, loss, or harm that occur to me AND any minors for whom I am responsible or to any other person or to any property during the Activity or in any way related to the Activity or usage of the facilities and equipment provided by Boulder Box & Office. This RELEASE includes claims for the negligence of the Released Parties and claims for strict liability for abnormally dangerous activities. This RELEASE does not extend to claims for any liabilities that Vietnam law does not permit to be excluded by agreement.I also agree NOT TO SUE or make a claim against the Released Parties for death, injuries, loss, or harm that occurs during the Activity or are related in any way to the Activity, facilities or equipment provided by Boulder Box & Office, either now or anytime in the future.

5. INDEMNIFICATION, HOLD HARMLESS, AND DEFENSE: I promise to INDEMNIFY, HOLD HARMLESS, AND DEFEND the Released Parties (defined in Section 4) against any and all claims to which Section 4 of this agreement applies, including claims for their own negligence. I also promise to INDEMNIFY, HOLD HARMLESS, AND DEFEND the Released Parties against any and all claims for my own negligence, and any other claim arising from my conduct during the Activity or while using the facilities provided by Boulder Box & Office.In accordance with these promises, I will reimburse the Released Parties for any damages, reasonable settlements, and defense costs, including attorney's fees, that they incur because of any such claims made against them. I agree that in the event of my death or disability, the terms of this agreement, including the indemnification obligation in this Section, will be binding on my estate, and my personal representative, executor, administrator or guardian will be obligated to respect and enforce them.

6. AGREEMENT TO FOLLOW DIRECTIONS: I agree to follow the rules for the Activity provided to me and to follow directions given to me by the leaders and staff of the Activity and Boulder Box & Office, including USING ALL OF THE PROTECTIVE GEAR that I am instructed to use.

7. INDEPENDENT CONTRACTORS: I acknowledge that Boulder Box & Office has no control over and assumes no responsibility for the actions of any independent contractors providing any services for the Activity

8. USE OF MY LIKENESS: I understand that during the Activity I/we may be photographed or videotaped. To the fullest extent allowed by law, I waive all rights of publicity or privacy or pre-approval that I/we have for any such likeness of me/us or use of my name in connection with such likeness, and I grant to Boulder Box & Office and its assigns permission to copyright, use, and publish (including by electronic means) such likeness of me/us, whether in whole or part, in any form, without restrictions, and for any purpose, either now or in the future.

9. SEVERABILITY: I agree that the purpose of this agreement is that it shall be an enforceable RELEASE OF LIABILITY AND INDEMNITY as broad and inclusive as is permitted by Vietnam law. I agree that if any portion or provision of this agreement is found to be invalid or unenforceable, then the remainder will continue in full force and effect. I also agree that any invalid provision will be modified or partially enforced to the maximum extent permitted by law to carry out the purpose of the agreement.

10. APPLICABLE LAW, FORUM & ATTORNEY'S FEES: This agreement is governed by and shall be construed in accordance with the laws of the state of Vietnam, without any reference to its choice of law rules. I agree that any dispute arising from this Agreement or in any way associated with the Activity shall be brought only in Vietnam, and I agree to the jurisdiction and venue of those courts for any such dispute. In any litigation in which the validity or enforceability of this agreement is contested, I agree that the prevailing party will pay all attorney's fees and costs of the parties seeking to uphold the agreement.

===================================
Tiếng Việt:

Vui lòng chú ý đặc biệt đến phần này:
• Phải mang giày khi leo tường. Không được leo bằng chân trần.
• Người leo phải xác nhận rằng đệm đúng cách và an toàn đã được đặt trên sàn theo đường đi mong muốn và sẽ đỡ mọi sự rơi rớt mà người leo có thể gặp trước khi bắt đầu leo tường.
• Người leo không được đi hoặc bước dưới người leo khác đang ở trên tường. Cần có khoảng cách ít nhất 3 mét. Chỉ có những người đứng bên dưới được phép ở gần người leo trên tường.
• Trước khi bắt đầu leo tường, người leo phải xác nhận rằng đường đi mong muốn sẽ không va chạm với người leo khác đang ở trên tường. Người leo đang ở trên tường có ưu tiên.
• Cửa sổ và cửa ra vào dọc theo "bức tường cửa sổ", dưới hai phần nghiêng, luôn "tắt". Điều này có nghĩa là bạn không thể đặt chân, nắm hoặc sử dụng cửa vào hoặc cửa sổ để giúp việc leo tường. Bạn cũng phải tránh việc vung tay, chân hoặc bất kỳ thứ gì khác qua cửa vào hoặc cửa sổ.
• Chỉ có bột magiê dành cho việc sử dụng trên tay và được thiết kế cho leo núi, phòng tập và thể thao được phép trong phòng tập leo núi. Không có bột magiê màu và không có bột magiê dùng trên vỉa đường. Nếu bạn không chắc chắn về bột magiê của mình, vui lòng hỏi một nhân viên của Boulder Box & Office.
• Spotter phải tập trung vào người leo và duy trì sự giao tiếp liên tục và rõ ràng với người leo trong suốt thời gian đứng gần.
• Các buổi học đang diễn ra có ưu tiên trên các đường đi. Nếu một người hướng dẫn cần đường đi bạn đang leo, bạn có thể được yêu cầu chuyển sang một đường đi khác. Hãy hoàn thành việc leo và để buổi học sử dụng đường đi.
• Ít nhất phải có hai người ở trong phòng tập vào bất kỳ thời điểm nào và ít nhất một người phải ở xa tường vào bất kỳ thời điểm nào để phòng tránh tình huống khẩn cấp.
• Người leo phải ngay lập tức thông báo cho nhân viên của Boulder Box & Office về bất kỳ hoạt động nguy hiểm nào, chẳng hạn như mấu leo bị quay hoặc di chuyển các đinh, hỏng tường, v.v.
• Tất cả người leo phải tuân theo quyết định của nhân viên của Boulder Box & Office đang trực.
• Tất cả người leo phải ít nhất năm (05) tuổi.
• Người leo dưới mười sáu (16) tuổi phải có cha mẹ hoặc người giám hộ ký vào biểu mẫu từ chối và giải phóng trách nhiệm. Người leo có thể đọc quy tắc hoặc có thể được cha mẹ/giám hộ đọc cho họ.
• Tất cả người leo dưới mười sáu (16) tuổi phải được người lớn điều hành và giám sát mọi lúc.
• Một người lớn chỉ được điều hành tối đa 3 người chưa thành niên.
• Tất cả người leo phải điền một biểu mẫu từ chối trách nhiệm ít nhất một lần trong năm dương lịch.• Bất kỳ vi phạm của các quy tắc trên có thể dẫn đến mất quyền lợi. Vi phạm lặp lại có thể dẫn đến mất quyền hạn/truy cập vào phòng tập.

Lưu ý: Người lớn trên 18 tuổi ký vào biểu mẫu từ chối này đồng nghĩa với việc họ đồng ý cho bản thân VÀ bất kỳ người chưa thành niên nào mà họ chịu trách nhiệm.

CẢNH BÁO: Có những yếu tố rủi ro đáng kể trong mọi cuộc phiêu lưu, môn thể thao hoặc hoạt động liên quan đến 'phòng tập leo núi', tường leo, khu leo núi đá, chế độ tập luyện trọng lượng và thể dục, và thiết bị, (gọi chung là "Hoạt động"). Mặc dù chúng tôi đã thực hiện các bước hợp lý để cung cấp cho bạn trang thiết bị phù hợp và/hoặc các HLV có kỹ năng để bạn có thể tham gia vào một Hoạt động mà bạn có thể chưa có kỹ năng, chúng tôi muốn nhắc nhở bạn rằng Hoạt động này không phải là không rủi ro. Một số rủi ro không thể loại bỏ mà không phá hủy đặc tính độc đáo của Hoạt động. Những yếu tố giống nhau góp phần vào đặc tính độc đáo của Hoạt động có thể là nguyên nhân gây mất mát hoặc hỏng hóc trang thiết bị của bạn, hoặc chấn thương, bệnh tật, hoặc trong trường hợp cực kỳ nghiêm trọng, tổn thương vĩnh viễn hoặc tử vong. Chúng tôi không muốn làm cho bạn hoảng sợ hoặc làm giảm niềm hứng thú của bạn đối với Hoạt động này, nhưng chúng tôi nghĩ rằng quan trọng là bạn biết trước những gì bạn có thể mong đợi và được thông báo về những rủi ro tự nhiên.

1. LƯU Ý: ĐÂY LÀ MỘT THỎA THUẬNTHUẬN PHÁP LÝ: Bằng cách ký vào thỏa thuận này, bạn từ bỏ quyền lợi đưa ra tòa án để đòi bồi thường hoặc đạt được bất kỳ biện pháp nào khác cho bất kỳ tổn thương nào đối với bạn hoặc tài sản của bạn, hoặc cho cái chết của bạn bất cứ là nguyên nhân gì phát sinh từ việc sử dụng các tiện ích của Boulder Box & Office, bây giờ hoặc bất cứ lúc nào trong tương lai. Người trưởng thành từ 18 tuổi trở lên đang đồng ý với sự từ bỏ này đang đồng ý với bản thân họ VÀ bất kỳ trẻ em nào mà họ chịu trách nhiệm.

2. HOẠT ĐỘNG VÀ RỦI RO LIÊN QUAN: Tôi đã chọn tham gia vào hoạt động sau đây: (sau đây được gọi là "Hoạt động"),Hoạt động này có nguy cơ làm cho tôi/chúng tôi phải đối mặt với các nguy cơ và rủi ro. Tôi nhận thức rằng mô tả sau đây mô tả một số, nhưng không phải tất cả, các rủi ro:
• Trượt, té, ngã hoặc va đập đau khi sử dụng cơ sở vật chất hoặc thiết bị, leo tường, khu bouldering, góc đáp xuống, sàn và đệm dưới khu vực leo tường, cơ sở vệ sinh, hoặc cầu thang;
• Rủi ro liên quan đến việc băng qua, leo lên hoặc leo xuống;
• Lạm dụng thiết bị hoặc cơ sở vật chất, hoặc sự cố về thiết bị;
• Sức mạnh cơ thể, sự điều chỉnh, giác quan cân bằng và khả năng theo dõi hoặc đưa ra hướng dẫn trong khi leo tường, quan sát hoặc tập luyện;
• Mệt mỏi, lạnh và/hoặc chói lọi, có thể làm giảm thời gian phản ứng của tôi/chúng tôi và tăng nguy cơ tai nạn;
• Trầy da hoặc mắc kẹt với thiết bị; và
• Sự hiện diện, hành động hoặc ngã của những người tham gia khác. 
Tôi hiểu rằng mô tả về những rủi ro này không đầy đủ và có thể có những rủi ro không biết hoặc không dự kiến khác có thể dẫn đến chấn thương, bệnh hoặc tử vong.Do những rủi ro này, tôi/chúng tôi có thể bị thương nặng hoặc tàn tật hoặc có thể chết do những chấn thương phát sinh, và tài sản của tôi/chúng tôi cũng có thể bị hỏng; việc sử dụng cơ sở vật chất và thiết bị do Boulder Box & Office cung cấp mang lại những rủi ro; và Boulder Box & Office không chịu trách nhiệm về việc cung cấp chăm sóc y tế trong suốt Hoạt động hoặc khi sử dụng cơ sở vật chất do Boulder Box & Office cung cấp, và tôi/chúng tôi sẽ phải chi trả bất kỳ chi phí y tế và/hoặc sơ tán nào tôi/chúng tôi gánh chịu. Xem xét việc được phép tham gia vào Hoạt động, tôi đồng ý với các điều khoản chứa trong tài liệu này.

3. GIẢ ĐỊNH VỀ RỦI RO VÀ TRÁCH NHIỆM: Tôi ở đây tự nguyện chấp nhận những rủi ro được đề cập ở trên cũng như những rủi ro khác không được liệt kê mà là một phần của hoạt động này và bất kỳ tổn thương, chấn thương hoặc mất mát nào có thể xảy ra đối với tôi hoặc tài sản của tôi do sự tham gia của tôi trong Hoạt động hoặc trong quá trình sử dụng các cơ sở vật chất do Boulder Box & Office cung cấp—bao gồm bất kỳ tổn thương hoặc mất mát nào do sự thiếu cẩn trọng của Boulder Box & Office, nhân viên, đại diện và quan chức của nó, các nhà thầu và các người tham gia khác của Hoạt động.Tôi cũng hiểu rằng mọi thiết bị mà tôi cung cấp hoặc có thể mượn hoặc thuê từ Boulder Box & Office hoặc bất kỳ nhà cung cấp nào khác mà tôi sử dụng đều nằm trong trách nhiệm cá nhân của tôi và rằng mọi thiết bị đó đều được cung cấp mà không có bất kỳ bảo hành nào về tình trạng hoặc tính phù hợp của nó.

4. GIẢI THOÁT TRÁCH NHIỆM: Tôi ở đây GIẢI THOÁT Boulder Box & Office, nhân viên, đại diện, quan chức và nhà thầu của nó, các nhà cung cấp thiết bị sử dụng trong Hoạt động, chủ sở hữu đất đai, các nhà cung cấp giấy phép sử dụng của chính quyền địa phương hoặc chính phủ, và nhân viên, quan chức và giám đốc của họ ("Các Bên Được Giải Thoát") KHỎI MỌI TRÁCH NHIỆM, NGUYÊN NHÂN HÀNH ĐỘNG, YÊU CẦU VÀ YÊU CẦU xuất phát từ bất kỳ chấn thương, tử vong, mất mát hoặc tổn thương nào xảy ra đối với tôi VÀ bất kỳ trẻ em nào tôi chịu trách nhiệm hoặc đối với bất kỳ người khác nào hoặc tài sản nào trong suốt Hoạt động hoặc liên quan đến bất kỳ cách nào đến Hoạt động hoặc việc sử dụng cơ sở vật chất và thiết bị do Boulder Box & Office cung cấp. GIẢI THOÁT này bao gồm các yêu cầu về sự thiếu cẩn trọng của Các Bên Được Giải Thoát và yêu cầu về trách nhiệm nghiêm túc đối với các hoạt động nguy hiểm. GIẢI THOÁT này không mở rộng đến những yêu cầu về trách nhiệm mà pháp luật Việt Nam không cho phép loại trừ bằng thỏa thuận.Tôi cũng đồng ý KHÔNG KIỆN hay đưa ra yêu cầu chống lại Các Bên Được Giải Thoát về cái chết, chấn thương, mất mát hoặc tổn thương nào xảy ra trong suốt Hoạt động hoặc liên quan đến bất kỳ cách nào đến Hoạt động, cơ sở vật chất hoặc thiết bị do Boulder Box & Office cung cấp, dù là bây giờ hay bất kỳ lúc nào trong tương lai.

5. BẢO HIỂM, BẢO VỆ KHỎI TRÁCH NHIỆM VÀ PHÒNG VỆ: Tôi cam kết BẢO HIỂM, BẢO VỆ KHỎI TRÁCH NHIỆM VÀ PHÒNG VỆ cho Các Bên Được Giải Thoát (được xác định trong Phần 4) khỏi mọi yêu cầu mà Phần 4 của thỏa thuận này áp dụng, bao gồm cả yêu cầu về sự thiếu cẩn trọng của họ. Tôi cũng cam kết BẢO HIỂM, BẢO VỆ KHỎI TRÁCH NHIỆM VÀ PHÒNG VỆ cho Các Bên Được Giải Thoát khỏi mọi yêu cầu về sự thiếu cẩn trọng của tôi, và mọi yêu cầu khác xuất phát từ hành vi của tôi trong suốt Hoạt động hoặc khi sử dụng cơ sở vật chất do Boulder Box & Office cung cấp. Tuân theo những cam kết này, tôi sẽ bồi thường cho Các Bên Được Giải Thoát mọi tổn thất, thoả thuận hợp lý và chi phí phòng vệ, bao gồm cả chi phí luật sư, mà họ phải chịu do bất kỳ yêu cầu nào như vậy đối với họ. Tôi đồng ý rằng trong trường hợp cái chết hoặc tàn tật của tôi, các điều khoản của thỏa thuận này, bao gồm cả nghĩa vụ bảo hiểm trong Phần này, sẽ có hiệu lực đối với di sản của tôi, và người đại diện cá nhân, người thi hành di chúc, quản trị viên hoặc người giám hộ của tôi sẽ có nghĩa vụ tôn trọng và thực hiện chúng.

6. THỎA THUẬN TUÂN THỦ HƯỚNG DẪN: Tôi đồng ý tuân thủ các quy tắc của Hoạt động được cung cấp cho tôi và tuân thủ các hướng dẫn được đưa ra cho tôi bởi các nhà lãnh đạo và nhân viên của Hoạt động và Boulder Box & Office, bao gồm VIỆC SỬ DỤNG TẤT CẢ TRANG THIẾT BỊ BẢO VỆ mà tôi được hướng dẫn sử dụng.

7. NHÀ THẦU ĐỘC LẬP: Tôi nhận thức rằng Boulder Box & Office không có quyền kiểm soát và không chịu trách nhiệm về hành động của bất kỳ nhà thầu độc lập nào cung cấp bất kỳ dịch vụ nào cho Hoạt động.

8. SỬ DỤNG HÌNH ẢNH CỦA TÔI: Tôi hiểu rằng trong suốt Hoạt động, tôi/chúng tôi có thể bị chụp ảnh hoặc quay video. Trong phạm vi tối đa cho phép theo luật pháp, tôi từ bỏ mọi quyền công bố hoặc quyền riêng tư hoặc quyền chấp thuận trước mà tôi/chúng tôi có đối với bất kỳ hình ảnh nào của tôi/chúng tôi hoặc việc sử dụng tên của tôi/chúng tôi liên quan đến hình ảnh đó, và tôi cấp quyền cho Boulder Box & Office và những người được ủy quyền của nó để bản quyền, sử dụng và xuất bản (bao gồm cả bằng cách điện tử) những hình ảnh của tôi/chúng tôi, có thể là toàn bộ hoặc một phần, ở bất kỳ hình thức nào, mà không có hạn chế, và cho bất kỳ mục đích nào, hiện tại hoặc trong tương lai.

9. PHÂN CHIA: Tôi đồng ý rằng mục đích của thỏa thuận này là một THỎA THUẬN GIẢM TRÁCH NHIỆM VÀ BẢO HIỂM có phạm vi rộng và bao gồm như cho phép theo luật pháp Việt Nam. Tôi đồng ý rằng nếu bất kỳ phần hoặc điều khoản nào của thỏa thuận này được phát hiện là không hợp lệ hoặc không thể thực hiện được, thì phần còn lại sẽ tiếp tục có hiệu lực và hiệu quả đầy đủ. Tôi cũng đồng ý rằng bất kỳ quy định không hợp lệ nào sẽ được điều chỉnh hoặc thực hiện một phần đến mức tối đa cho phép theo luật pháp để thực hiện mục đích của thỏa thuận.

10. LUẬT ÁP DỤNG, DIỄN ĐÀN & CHI PHÍ LUẬT SƯ: Thỏa thuận này được quy định và sẽ được hiểu theo luật pháp của nước Cộng hòa Xã hội Chủ nghĩa Việt Nam, mà không có tham chiếu đến quy tắc lựa chọn luật. Tôi đồng ý rằng mọi tranh chấp phát sinh từ Thỏa thuận này hoặc liên quan đến Hoạt động sẽ chỉ được đưa ra ở Việt Nam, và tôi đồng ý với thẩm quyền và địa điểm của các tòa án đó đối với bất kỳ tranh chấp nào như vậy. Trong bất kỳ vụ kiện nào mà tính hợp lệ hoặc khả năng thực hiện của thỏa thuận này bị tranh cãi, tôi đồng ý rằng bên chiến thắng sẽ trả tất cả chi phí luật sư và chi phí của các bên đang tìm cách bảo vệ thỏa thuận.
            </p>
            <p>
              By checking the box below you confirm that you have read, understood, and agree
              to be bound by the terms of this waiver.
            </p>
          </div>
        </div>

        <!-- Waiver checkbox -->
        <label class="flex items-start gap-3 cursor-pointer group">
          <input
            id="waiver-check"
            type="checkbox"
            class="mt-0.5 w-5 h-5 rounded accent-orange-500 cursor-pointer flex-shrink-0"
          />
          <span class="text-sm text-gray-300 group-hover:text-white transition leading-snug">
            I have read and agreed to the
            <a href="https://docs.google.com/document/d/1ZPl1KfUmoXwD5YSNu4D4Fa4A1tQiFZqOdzIgwVE6z3w/edit?tab=t.0"
               target="_blank" rel="noopener noreferrer"
               class="text-orange-400 underline underline-offset-2 hover:text-orange-300">
              waiver agreement
            </a>.
            <span class="text-red-400">*</span>
          </span>
        </label>

        <!-- Error / success messages -->
        <div id="reg-error"
             class="hidden px-4 py-3 bg-red-500/10 border border-red-500/30 rounded-xl
                    text-red-400 text-sm"></div>
        <div id="reg-success"
             class="hidden px-4 py-3 bg-green-500/10 border border-green-500/30 rounded-xl
                    text-green-400 text-sm text-center"></div>

        <button
          type="submit"
          id="reg-submit"
          class="w-full py-3.5 bg-orange-500 hover:bg-orange-600 active:bg-orange-700
                 rounded-xl font-semibold text-base transition-all duration-150
                 disabled:opacity-50 disabled:cursor-not-allowed flex items-center justify-center gap-2"
        >
          <span id="reg-btn-text">Create Account</span>
          <svg id="reg-spinner" class="hidden animate-spin w-5 h-5" fill="none" viewBox="0 0 24 24">
            <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"/>
            <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8v8z"/>
          </svg>
        </button>
      </form>
    </div>

    <!-- Footer -->
    <p class="text-center text-xs text-gray-600 mt-8">Need help? Ask a staff member.</p>
  </div>

  <script is:inline>
    // ── English-only name validator ──────────────────────────────────────────
    function isEnglishOnly(value) {
      return /^[A-Za-z0-9 '\-\.]+$/.test(value);
    }

    // ── Register form ────────────────────────────────────────────────────────
    document.getElementById('register-form').addEventListener('submit', async function(e) {
      e.preventDefault();
      const name      = document.getElementById('reg-name').value.trim();
      const dob       = document.getElementById('reg-dob').value.trim();
      const email     = document.getElementById('reg-email').value.trim();
      const telephone = document.getElementById('reg-tel').value.trim();
      const emergency = document.getElementById('reg-emergency').value.trim();
      const note      = document.getElementById('reg-note').value.trim();
      const waiver    = document.getElementById('waiver-check').checked;

      const errBox  = document.getElementById('reg-error');
      const succBox = document.getElementById('reg-success');
      const btn     = document.getElementById('reg-submit');
      const spinner = document.getElementById('reg-spinner');
      const btnText = document.getElementById('reg-btn-text');

      errBox.classList.add('hidden');
      succBox.classList.add('hidden');

      if (!name) {
        errBox.textContent = 'Full name is required.';
        errBox.classList.remove('hidden');
        document.getElementById('reg-name').focus();
        return;
      }
      if (!isEnglishOnly(name)) {
        errBox.textContent = 'Please use English characters only for your name (a–z, spaces, hyphens).';
        errBox.classList.remove('hidden');
        document.getElementById('reg-name').focus();
        return;
      }
      if (!waiver) {
        errBox.textContent = 'You must read and agree to the waiver agreement before registering.';
        errBox.classList.remove('hidden');
        document.getElementById('waiver-check').focus();
        return;
      }

      btn.disabled = true;
      spinner.classList.remove('hidden');
      btnText.textContent = 'Registering…';

      try {
        const res  = await fetch('/api/public/register', {
          method:  'POST',
          headers: { 'Content-Type': 'application/json' },
          body:    JSON.stringify({
            full_name:         name,
            dob,
            email,
            telephone,
            emergency_contact: emergency,
            note,
            waiver_agreed:     waiver,
          }),
        });
        const data = await res.json();

        if (!res.ok) {
          errBox.textContent = data.error ?? 'Something went wrong. Please try again.';
          errBox.classList.remove('hidden');
        } else {
          succBox.innerHTML =
            `<span class="text-2xl">✅</span><br>` +
            `<strong class="text-base">Account created!</strong><br>` +
            `<span class="text-xs text-green-300/70">Welcome to BBO Gym, ${name}!<br>Please see staff to complete your membership.</span>`;
          succBox.classList.remove('hidden');
          document.getElementById('register-form').reset();
        }
      } catch {
        errBox.textContent = 'Network error. Please check your connection and try again.';
        errBox.classList.remove('hidden');
      } finally {
        btn.disabled = false;
        spinner.classList.add('hidden');
        btnText.textContent = 'Create Account';
      }
    });
  </script>

</body>
</html>
