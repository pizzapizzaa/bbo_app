
---
import Layout from '../layouts/Layout-landing-page.astro';
---

<Layout title="Blog | Boulder Box Vietnam">
  <section id="blog" class="blog-section">
    <div class="section-container" style="padding: 0 64px;">
      <h2 class="blog-title">Blog</h2>
      <p class="blog-subtitle">Latest insights and stories from the Boulder Box community</p>
      <div class="blog-grid">
        <!-- (Removed three placeholder posts: Getting Started, Training Tips, Community Highlight) -->

        <!-- New: 2027 prices (no photo, so a text panel stands in for the image) -->
        <div class="blog-post">
          <div class="blog-post-image blog-post-image-text">
            <span>New prices<br />from 1 Jan 2027</span>
          </div>
          <div class="blog-post-content">
            <span class="blog-date">Sep 28, 2026</span>
            <h3 class="blog-post-title">Our Prices Are Changing on 1 January 2027</h3>
            <p class="blog-post-excerpt">
              After a full year of frozen prices, we're making a small update from 1 January 2027. Here's what's changing and why.
            </p>
            <a href="/prices-2027" class="blog-read-more">Read More →</a>
          </div>
        </div>

        <!-- New: Google reviews -->
        <div class="blog-post">
          <div class="blog-post-image">
            <img src="/assets/media/Blog_photos/BoulderBox_vibe_01.webp" alt="Climbers hanging out at Boulder Box" class="blog-image" />
          </div>
          <div class="blog-post-content">
            <span class="blog-date">Sep 28, 2026</span>
            <h3 class="blog-post-title">What Is It Actually Like Climbing at Boulder Box?</h3>
            <p class="blog-post-excerpt">
              Small, clean, air-conditioned, and full of good people. We went through our Google reviews to see what you actually say about us.
            </p>
            <a href="/climbing-at-boulder-box" class="blog-read-more">Read More →</a>
          </div>
        </div>

        <!-- New: Complimentary onboarding -->
        <div class="blog-post">
          <div class="blog-post-image">
            <img src="/assets/media/Blog_photos/Onboarding_01.webp" alt="A climber on one of our walls" class="blog-image" />
          </div>
          <div class="blog-post-content">
            <span class="blog-date">Sep 28, 2026</span>
            <h3 class="blog-post-title">Never Climbed Before? Your Onboarding Is On Us</h3>
            <p class="blog-post-excerpt">
              Complimentary bouldering onboarding for every first-timer. We'll show you the ropes (well, the mats).
            </p>
            <a href="/complimentary-onboarding" class="blog-read-more">Read More →</a>
          </div>
        </div>

        <!-- New: Route setting -->
        <div class="blog-post">
          <div class="blog-post-image">
            <img src="/assets/media/Blog_photos/Setting_02.webp" alt="A setter drilling a new hold onto the wall" class="blog-image" style="object-position:center 15%;" />
          </div>
          <div class="blog-post-content">
            <span class="blog-date">Sep 28, 2026</span>
            <h3 class="blog-post-title">Six Mondays, One Brand New Gym</h3>
            <p class="blog-post-excerpt">
              Every Monday we strip a wall and set it fresh. Give it six weeks and you're climbing in a whole new gym.
            </p>
            <a href="/six-mondays-route-setting" class="blog-read-more">Read More →</a>
          </div>
        </div>

        <!-- New: UNBOX 2026 Sponsors -->
        <div class="blog-post">
          <div class="blog-post-image">
              <img src="/assets/media/unbox-thumbnail-2026.png" alt="UNBOX 2026" class="blog-image" />
          </div>
          <div class="blog-post-content">
            <span class="blog-date">May 26, 2026</span>
            <h3 class="blog-post-title">Building the Future of Vietnamese Bouldering: Partner with Us for UNBOX 2026</h3>
            <p class="blog-post-excerpt">
              Join us as a sponsor for UNBOX 2026 — tailored packages, creative activations, and authentic community engagement.
            </p>
            <a href="/unbox-2026-sponsors" class="blog-read-more">Read More →</a>
          </div>
        </div>

        <!-- New: V-Day & Tet 2026 -->
        <div class="blog-post">
          <div class="blog-post-image">
            <img src="/assets/IG_thumbnail_tet_holiday.jpg" alt="V-Day & Tet" class="blog-image" />
          </div>
          <div class="blog-post-content">
            <span class="blog-date">Feb 2, 2026</span>
            <h3 class="blog-post-title">Happy V-Day and Lunar New Year!</h3>
            <p class="blog-post-excerpt">
              Updated Tet hours and Couple Climbing Minigame — join us for special dates and prizes!
            </p>
            <a href="/happy-vday-lunar-new-year-2026" class="blog-read-more">Read More →</a>
          </div>
        </div>

        <!-- New: Updates 2026 -->
        <div class="blog-post">
          <div class="blog-post-image">
            <img src="/assets/boulder-box-update-2026.avif" alt="Updates 2026" class="blog-image" />
          </div>
          <div class="blog-post-content">
            <span class="blog-date">Dec 30, 2025</span>
            <h3 class="blog-post-title">2026 AT BOULDER BOX: NEW UPDATES &amp; PERKS! 🧗‍♂️✨</h3>
            <p class="blog-post-excerpt">
              New year, same great vibes — price freeze, updated gear policy, and new discounts for 2026.
            </p>
            <a href="/updates-2026" class="blog-read-more">Read More →</a>
          </div>
        </div>

        <!-- New: Rocktober 2025 -->
        <div class="blog-post">
          <div class="blog-post-image">
            <img src="/assets/boulder-box-rocktober-2025.avif" alt="Rocktober 2025" class="blog-image" />
          </div>
          <div class="blog-post-content">
            <span class="blog-date">Nov 4, 2025</span>
            <h3 class="blog-post-title">What an incredible finish to Rocktober 2025!</h3>
            <p class="blog-post-excerpt">
              A thrilling competition finish — congratulations to our climbers and thanks to sponsors and organisers!
            </p>
            <a href="/rocktober-2025" class="blog-read-more">Read More →</a>
          </div>
        </div>
      </div>
    </div>
  </section>
</Layout>
