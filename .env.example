# BBO Gym POS — Environment Variables
# Copy this file to .env and fill in your actual credentials.
# .env is gitignored and will never be committed.

# Admin login credentials
ADMIN_USERNAME=your_admin_username
ADMIN_PASSWORD=your_secure_password

# Shared part-timer login. Part-timers get Dashboard, Daily Check-in and Staff
# Schedule; Customers, Promo Codes and Expenses stay locked behind the admin
# password above. Leave these unset to disable part-timer login entirely.
PARTTIMER_USERNAME=parttimer
PARTTIMER_PASSWORD=your_parttimer_password

# Session signing secret — must be at least 32 random characters.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=replace_with_32+_random_bytes

# Seals staff-signed leaderboard submissions so stored records are
# tamper-evident. Keep this SEPARATE from SESSION_SECRET: rotating session
# signing must never invalidate a season of send records.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
LEADERBOARD_SIGNING_SECRET=replace_with_32+_random_bytes

# Supabase project credentials (found in Project Settings → API)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=your_service_role_key
